---
/*
  Per-provider hyperscaler reservation schedules, H100 — /term section 02.

  This is the REPLACEMENT design John queued when the pooled hyperscaler
  chart was pulled (2026-07-16): each line is ONE NAMED operator's own
  published reservation schedule — Azure RIs (1Y/3Y/5Y), GCP committed
  bundles (1Y/3Y), AWS RIs where they print — drawn as DOLLAR LEVELS.
  Within-provider by construction, so no cross-panel % can be manufactured;
  each operator's on-demand list is a detached reference dot on its own
  color (same operator, so the dot-to-line read IS within-book).

  Short-commit, capacity-guarantee products print as detached diamonds at
  their duration position, labeled by product (AWS Capacity Blocks
  reference rate, 1d–6mo band; GCP DWS flex-start, ≤7d) — never connected
  to the reservation lines: different product kind (take-or-pay capacity
  vs billing commitment), shown, not blended.

  Data: build-time read of the curated listings export (public/data/
  listings_history_h100-sxm-80gb.csv), latest day, T1 guaranteed rows,
  US-East basis (reservation prices are REGIONAL — azure_reservations 5Y
  spans $4.92 US-East to $6.64 APAC on one day; a mixed-region line would
  fabricate curve shape). Azure uses the dedicated azure_reservations
  collector. GCP levels are bundled machine basis (GPU commit + on-demand
  vCPU/RAM per GCP billing semantics).

  Colors: the 3-series set validated for both themes in
  HyperscalerTermChart (dataviz six-checks). Fixed assignment by entity:
  Azure / GCP / AWS — never re-ranked.
*/
import fs from 'node:fs';
import { meta } from '../data/snapshot';

const fmt = (n: number, dp = 2) => n.toFixed(dp);

// --- data (build-time) ------------------------------------------------------
const CSV = new URL('../../public/data/listings_history_h100-sxm-80gb.csv', import.meta.url);
const raw = fs.readFileSync(CSV, 'utf-8').trim().split(/\r?\n/);
const header = raw[0]!.split(',');
const col = (name: string) => header.indexOf(name);
const iDate = col('as_of_date'), iSrc = col('source_name'), iTier = col('operator_tier'),
      iTerm = col('commitment_term'), iInt = col('interruptibility'), iPrice = col('price_usd_per_hour');
const iRegion = col('region');
const rows = raw.slice(1).map((l) => l.split(','));
const lastDay = rows.reduce((m, r) => (r[iDate]! > m ? r[iDate]! : m), '');
// One region basis for the whole chart: US-East (every operator here prints
// it, and it is the azure collectors' home region). Reservation prices are
// REGIONAL — mixing regions across points would fabricate curve shape
// (azure_reservations 5Y spans $4.92 US-East to $6.64 APAC on 2026-08-04).
const cell = (src: string, term: string): number | null => {
  const matches = rows.filter((r) => r[iDate] === lastDay && r[iSrc] === src &&
                                     r[iTier] === 'T1' && r[iTerm] === term &&
                                     r[iInt] === 'NonInterruptible');
  // US-East first; any US region as fallback (gcp_dws flex-start anchors
  // us-central1 and GCP states the rate is uniform across regions).
  const r = matches.find((r) => r[iRegion] === 'US-East')
        ?? matches.find((r) => (r[iRegion] ?? '').startsWith('US')) ?? null;
  return r ? parseFloat(r[iPrice]!) : null;
};

// --- geometry (mirrors the chart above) ------------------------------------
const W = 920, H = 430;
const MARGIN = { top: 28, right: 158, bottom: 38, left: 46 };
const x0 = MARGIN.left, x1 = W - MARGIN.right, y0 = MARGIN.top, y1 = H - MARGIN.bottom;
const innerW = x1 - x0, innerH = y1 - y0;
const MAX_MONTHS = 60;
const xOf = (months: number) =>
  x0 + 40 + (innerW - 40) * (Math.sqrt(months) / Math.sqrt(MAX_MONTHS));
const OD_X = xOf(0); // on-demand = the zero-commitment end of the same book
const Y_MIN = 0, Y_MAX = 14;
const yOf = (v: number) => y0 + innerH * ((Y_MAX - v) / (Y_MAX - Y_MIN));
const yTicks = [0, 2, 4, 6, 8, 10, 12, 14];
const xTicks = [
  { m: 12, lbl: '1Y' }, { m: 36, lbl: '3Y' }, { m: 60, lbl: '5Y' },
];

// --- series -----------------------------------------------------------------
const PROVIDERS = [
  { key: 'azure_reservations', od: 'azure_reservations', label: 'Azure', cls: 'azure',
    note: 'reserved instances, eastus2, amortized to $/GPU-hr' },
  { key: 'gcp', od: 'gcp', label: 'GCP', cls: 'gcp',
    note: 'committed use, bundled machine basis (GPU commit + on-demand vCPU/RAM)' },
  { key: 'aws', od: 'aws', label: 'AWS', cls: 'aws',
    note: 'standard reserved instances where published' },
];
const TENORS = [
  { term: '1Y', months: 12 }, { term: '3Y', months: 36 }, { term: '5Y', months: 60 },
];

interface Pt { x: number; y: number; value: number; title: string; }
const series = PROVIDERS.flatMap(({ key, od, label, cls, note }) => {
  const pts: Pt[] = TENORS.flatMap(({ term, months }) => {
    const v = cell(key, term);
    if (v == null) return [];
    return [{ x: xOf(months), y: yOf(v), value: v,
              title: `${label} ${term} reservation · $${fmt(v)}/GPU-hr · ${note} · as of ${lastDay}` }];
  });
  if (!pts.length) return [];
  const odV = cell(od, 'OnDemand');
  const path = pts.map((p, i) => `${i === 0 ? 'M' : 'L'}${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ');
  // OD connects to the first reserved tenor with a DASHED segment: same
  // operator's book (within-provider, so the pooled chart's detachment
  // rationale does not apply here), but a different purchase construct —
  // metered list vs reserved commitment — so the segment is marked.
  const odPt = odV != null ? { x: OD_X, y: yOf(odV), value: odV,
    title: `${label} on-demand list $${fmt(odV)}/GPU-hr — the zero-commitment end of the same operator's book (metered list, not a reservation)` } : null;
  const odLink = odPt && pts[0]
    ? `M${odPt.x.toFixed(1)},${odPt.y.toFixed(1)} L${pts[0].x.toFixed(1)},${pts[0].y.toFixed(1)}`
    : null;
  return [{ label, cls, path, pts, end: pts[pts.length - 1]!, od: odPt, odLink }];
});

// Short-commit capacity-guarantee products — detached diamonds, labeled.
const shortCommit = [
  { src: 'aws_capacity_blocks', term: 'CapacityBlock', months: 3, label: 'AWS Capacity Blocks',
    dur: '1d–6mo take-or-pay, reference rate', cls: 'aws' },
  { src: 'gcp_dws', term: 'FlexStart', months: 0.25, label: 'GCP flex-start',
    dur: '≤7-day defined duration', cls: 'gcp' },
].flatMap((s) => {
  const v = cell(s.src, s.term);
  if (v == null) return [];
  return [{ ...s, x: xOf(s.months), y: yOf(v), value: v,
            title: `${s.label} · $${fmt(v)}/GPU-hr · ${s.dur} · capacity-guarantee product — not on the reservation lines` }];
});

// End labels with collision handling.
const LBL_GAP = 15;
const endLabels = (() => {
  const items = series.map((s) => ({ s, y: s.end.y })).sort((a, b) => a.y - b.y);
  for (let i = 1; i < items.length; i++)
    if (items[i]!.y - items[i - 1]!.y < LBL_GAP) items[i]!.y = items[i - 1]!.y + LBL_GAP;
  return items;
})();

const ariaLabel =
  `Hyperscaler reservation schedules for H100, as of ${lastDay}: each line is one named operator's own published ` +
  `reserved levels in USD per GPU-hour (Azure 1, 3 and 5 year; GCP 1 and 3 year; AWS where published). A dashed segment ` +
  `connects each operator's on-demand list price to its first reserved tenor — the same operator's book, marked because ` +
  `the list is a metered product, not a reservation. Diamonds are short-commitment ` +
  `capacity-guarantee products (AWS Capacity Blocks reference, GCP flex-start), drawn at their duration position and ` +
  `never connected to the reservation lines. All values are dollar levels; no percentages are drawn between different panels.`;
---
<figure class="hlc" aria-describedby="hlc-caption">
  <div class="hlc-head">
    <span class="hlc-kicker">Hyperscaler reservation schedules · H100 · US · $/GPU-hr</span>
    <span class="hlc-meta">as of {lastDay}</span>
  </div>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={ariaLabel}>
    {yTicks.map((v) => (
      <>
        <line class={`grid${v === 0 ? ' baseline' : ''}`} x1={x0} x2={x1} y1={yOf(v)} y2={yOf(v)} />
        <text class="ytick" x={x0 - 8} y={yOf(v) + 4}>{v}</text>
      </>
    ))}
    <text class="xtick odlbl" x={OD_X} y={y1 + 24}>OD list</text>
    {xTicks.map((t) => (
      <>
        <line class="xtickmark" x1={xOf(t.m)} x2={xOf(t.m)} y1={y1} y2={y1 + 5} />
        <text class="xtick" x={xOf(t.m)} y={y1 + 24}>{t.lbl}</text>
      </>
    ))}
    {series.map((s) => (
      <>
        {s.odLink && <path class={`ln odlink s-${s.cls}`} d={s.odLink} fill="none" />}
        <path class={`ln s-${s.cls}`} d={s.path} fill="none" />
        {s.pts.map((p) => (
          <circle class={`pt s-${s.cls}`} cx={p.x} cy={p.y} r="4.5"><title>{p.title}</title></circle>
        ))}
        {s.od && (
          <circle class={`pt od s-${s.cls}`} cx={s.od.x} cy={s.od.y} r="4.5"><title>{s.od.title}</title></circle>
        )}
      </>
    ))}
    {shortCommit.map((p) => (
      <>
        <path class={`diamond s-${p.cls}`}
              d={`M${p.x},${p.y - 6} L${p.x + 6},${p.y} L${p.x},${p.y + 6} L${p.x - 6},${p.y} Z`}>
          <title>{p.title}</title>
        </path>
        <text class="sc-lbl" x={p.x + 10} y={p.y + 4}>{p.label.replace('AWS ', '').replace('GCP ', '')}</text>
      </>
    ))}
    {endLabels.map(({ s, y }) => (
      <text class={`endlbl s-${s.cls}`} x={s.end.x + 10} y={y + 4}>
        {s.label} {fmt(s.end.value)}
      </text>
    ))}
  </svg>
  <figcaption id="hlc-caption" class="hlc-caption">
    Each line is one operator's own published schedule — dollar levels,
    never cross-operator percentages, one US region basis throughout
    (regional schedules are not mixed). The dashed segment runs from the
    operator's on-demand list to its first reserved tenor: the same
    operator's book, but a different purchase construct — a metered list,
    not a reservation. Diamonds are short-commitment capacity-guarantee
    products at their duration — a different product kind, shown beside
    the reservation lines, never blended into them.
  </figcaption>
</figure>

<style>
  .hlc {
    --series-azure: #cc7d00;
    --series-gcp: #00829e;
    --series-aws: #5f7fd9;
    border: 1px solid var(--rule);
    background: var(--surface);
    padding: 12px 14px 12px;
    margin: 0 0 20px;
  }
  :global(html[data-theme="editorial"]) .hlc {
    --series-azure: #a3660f;
    --series-gcp: #0d96b6;
    --series-aws: #4d5fc0;
  }
  .hlc-head {
    display: flex; justify-content: space-between; align-items: baseline;
    gap: 12px; padding-bottom: 9px; margin-bottom: 4px;
    border-bottom: 1px solid var(--rule);
  }
  .hlc-kicker { font-family: var(--font-mono); font-size: var(--fs-xs);
    letter-spacing: .08em; text-transform: uppercase; color: var(--ink-dim); }
  .hlc-meta { font-family: var(--font-mono); font-size: var(--fs-xs); color: var(--ink-faint); }
  svg { width: 100%; height: auto; display: block; }
  .grid { stroke: var(--rule); stroke-width: 1; }
  .grid.baseline { stroke: var(--rule-2); }
  .xtickmark { stroke: var(--rule-2); stroke-width: 1; }
  .ytick, .xtick { font-family: var(--font-mono); font-size: 11px; fill: var(--ink-faint); }
  .ytick { text-anchor: end; }
  .xtick { text-anchor: middle; }
  .odlbl { text-anchor: start; }
  .ln { stroke-width: 2; }
  .ln.odlink { stroke-dasharray: 4 5; stroke-width: 1.6; opacity: .8; }
  .ln.s-azure { stroke: var(--series-azure); }
  .ln.s-gcp { stroke: var(--series-gcp); }
  .ln.s-aws { stroke: var(--series-aws); }
  .pt { stroke: var(--surface); stroke-width: 2; }
  .pt.s-azure { fill: var(--series-azure); }
  .pt.s-gcp { fill: var(--series-gcp); }
  .pt.s-aws { fill: var(--series-aws); }
  .pt.od { fill-opacity: .55; }
  .diamond { stroke: var(--surface); stroke-width: 1.5; }
  .diamond.s-aws { fill: var(--series-aws); }
  .diamond.s-gcp { fill: var(--series-gcp); }
  .sc-lbl, .endlbl { font-family: var(--font-mono); font-size: 12px; fill: var(--ink-dim); }
  .endlbl.s-azure { fill: var(--series-azure); }
  .endlbl.s-gcp { fill: var(--series-gcp); }
  .endlbl.s-aws { fill: var(--series-aws); }
  .hlc-caption { font-family: var(--font-mono); font-size: var(--fs-xs);
    color: var(--ink-faint); line-height: 1.6; margin-top: 8px; }
</style>
