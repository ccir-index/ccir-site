---
/*
  Hyperscaler reserved curve, US — /term section 02 (added 2026-07-16,
  pulled same day, REINSTATED 2026-08-12).
  Server-rendered inline SVG, same geometry system as TermCurveChart.

  CONSTRUCTION (reworked 2026-08-12, John) — ONE UNIFORM PANEL end to end.
  Every point = median of the three hyperscalers that publish committed
  terms (aws / azure / gcp), each entering as its lowest posted US
  guaranteed rate at that tenor; identical construction at OD, 1Y and 3Y,
  so the line connects through OD and "% vs OD" is a within-panel read.
  OCI publishes no committed lane on any chip we capture and is excluded
  entirely (an OD-only vote would change the panel at one tenor — the
  composition defect that got the 2026-07-16 version pulled the day it
  shipped: mixed panels manufactured a fake H200 "1Y −26%" when the
  within-provider truth was −7%). The aws H100 1Y leg is its convertible
  RI class — aws publishes no 1yr standard for p5 (bronze aws.py
  preference rule, 2026-08-12) — disclosed in the notes.

  Tenors: only OD/1Y/3Y print for T1 US today (Azure also lists 5Y but no
  5Y series prints — the roster gate). Chips: H100/H200/A100 (the T1 US
  committed set). Same series colors as the chart above — same chip, same
  hue, page-consistent.
*/
import fs from 'node:fs';
import { meta } from '../data/snapshot';

const fmt = (n: number, dp = 2) => n.toFixed(dp);

// --- geometry (mirrors TermCurveChart) -------------------------------------
const W = 920;
const H = 430;
const MARGIN = { top: 28, right: 158, bottom: 38, left: 46 };
const x0 = MARGIN.left;
const x1 = W - MARGIN.right;
const y0 = MARGIN.top;
const y1 = H - MARGIN.bottom;
const innerW = x1 - x0;
const innerH = y1 - y0;

const MAX_MONTHS = 36;
// OD column inset off the y-axis so the >$10 OD dots don't sit on the
// $10/$12 tick labels (reinstatement polish, 2026-08-12).
const OD_INSET = 22;
const xOf = (months: number) =>
  x0 + OD_INSET + (innerW - OD_INSET) * (Math.sqrt(months) / Math.sqrt(MAX_MONTHS));

const Y_MIN = 0;
const Y_MAX = 12; // raised from 10 at reinstatement — H100/H200 OD print >$10
const yOf = (v: number) => y0 + innerH * ((Y_MAX - v) / (Y_MAX - Y_MIN));
const yTicks = [0, 2, 4, 6, 8, 10, 12];

const X_TICKS = [{ label: 'OD', months: 0 }, { label: '1Y', months: 12 }, { label: '3Y', months: 36 }];

// OD | committed divider at the sqrt-space midpoint between OD and 1Y.
const odDividerX = x0 + innerW * (Math.sqrt(12) / 2 / Math.sqrt(MAX_MONTHS));

// 2026-08-12 REWORK (John): one uniform panel end to end. Every point on
// every curve is the median of the SAME three providers — the three
// hyperscalers that publish committed terms (aws, azure, gcp; each enters
// as its lowest posted US NonInterruptible rate at that tenor). OCI posts
// on-demand only (no committed lane on any chip we capture) and is
// EXCLUDED from this chart entirely, so the OD point shares the committed
// points' composition: the line connects through OD and % vs OD is a
// within-panel read. Build-time read of the curated listings exports, same
// lane HyperscalerLadders used.
const SOURCES = ['aws', 'azure', 'gcp'];
const CSVS = [
  { chip: 'H100', cls: 'h100', file: 'listings_history_h100-sxm-80gb.csv' },
  { chip: 'H200', cls: 'h200', file: 'listings_history_h200-sxm-141gb.csv' },
  { chip: 'A100', cls: 'a100', file: 'listings_history_a100-sxm-80gb.csv' },
];
const TENOR_MONTHS = [
  { term: 'OnDemand', months: 0 },
  { term: '1Y', months: 12 },
  { term: '3Y', months: 36 },
];

interface ChipPoint { months: number; value: number; provs: Record<string, number> }

function chipPoints(file: string): ChipPoint[] {
  const raw = fs
    .readFileSync(new URL(`../../public/data/${file}`, import.meta.url), 'utf-8')
    .trim()
    .split(/\r?\n/);
  const header = raw[0]!.split(',');
  const col = (n: string) => header.indexOf(n);
  const iDate = col('as_of_date'), iSrc = col('source_name'),
        iTier = col('operator_tier'), iTerm = col('commitment_term'),
        iInt = col('interruptibility'), iPrice = col('price_usd_per_hour'),
        iRegion = col('region');
  const rows = raw.slice(1).map((l) => l.split(','));
  const lastDay = rows.reduce((m, r) => (r[iDate]! > m ? r[iDate]! : m), '');
  return TENOR_MONTHS.flatMap(({ term, months }) => {
    const provs: Record<string, number> = {};
    for (const src of SOURCES) {
      const vals = rows
        .filter((r) =>
          r[iDate] === lastDay && r[iSrc] === src && r[iTier] === 'T1' &&
          r[iTerm] === term && r[iInt] === 'NonInterruptible' &&
          r[iRegion]!.startsWith('US'))
        .map((r) => parseFloat(r[iPrice]!))
        .filter((v) => Number.isFinite(v) && v > 0);
      if (vals.length) provs[src] = Math.min(...vals);
    }
    const vs = Object.values(provs).sort((a, b) => a - b);
    // All three providers or the point doesn't print — a 2-of-3 point would
    // silently change the panel, which is the exact defect this rework fixes.
    if (vs.length < 3) return [];
    return [{ months, value: vs[1]!, provs }];
  });
}

interface Pt {
  x: number;
  y: number;
  months: number;
  value: number;
  prov: boolean;
  title: string;
}
interface SeriesView {
  chip: string;
  cls: string;
  path: string;
  pts: Pt[];
  end: Pt;
  endPct: string | null;
  oneYPct: string | null;
}

const series: SeriesView[] = CSVS.flatMap(({ chip, cls, file }) => {
  const cps = chipPoints(file);
  const od = cps.find((p) => p.months === 0);
  if (!od || cps.length < 2) return [];
  const tenorTxt = (m: number) =>
    m === 0 ? 'on-demand' : m === 12 ? '1Y reserved' : '3Y reserved';
  const pts: Pt[] = cps.map((p) => ({
    x: xOf(p.months),
    y: yOf(p.value),
    months: p.months,
    value: p.value,
    prov: false,
    title:
      `${chip} · ${tenorTxt(p.months)} (US, guaranteed) · median $${fmt(p.value)} of ` +
      `AWS $${fmt(p.provs['aws']!)} · Azure $${fmt(p.provs['azure']!)} · ` +
      `GCP $${fmt(p.provs['gcp']!)} (each provider's lowest posted US rate)`,
  }));
  // Uniform panel at every tenor — the line legitimately connects through OD.
  const path = pts
    .map((p, i) => `${i === 0 ? 'M' : 'L'}${p.x.toFixed(1)},${p.y.toFixed(1)}`)
    .join(' ');
  const end = pts[pts.length - 1]!;
  const pctVsOd = (v: number) =>
    `−${Math.abs(Math.round((v / od.value - 1) * 100))}%`;
  const y1 = cps.find((p) => p.months === 12);
  return [{
    chip, cls, path, pts, end,
    endPct: end.months === 36 ? `${pctVsOd(end.value)} vs OD` : null,
    oneYPct: y1 ? `1Y ${pctVsOd(y1.value)}` : null,
  }];
});

// End-label collision handling (same scheme as the chart above).
const LBL_GAP = 15;
const endLabels = (() => {
  const items = series
    .map((s) => ({ s, y: s.end.y }))
    .sort((a, b) => a.y - b.y);
  for (let i = 1; i < items.length; i++) {
    const prev = items[i - 1]!;
    const cur = items[i]!;
    if (cur.y - prev.y < LBL_GAP) cur.y = prev.y + LBL_GAP;
  }
  const over = items.length ? items[items.length - 1]!.y - (y1 - 2) : 0;
  if (over > 0) {
    for (let i = items.length - 1; i >= 0; i--) {
      items[i]!.y -= over;
      if (i > 0 && items[i]!.y - items[i - 1]!.y >= LBL_GAP) break;
    }
  }
  return items.map(({ s, y }) => ({ s, y, leader: Math.abs(y - s.end.y) > 2 }));
})();

// Inline 1Y tags for lines that continue to 3Y — mirrors the chart above.
const oneYearTags = series.flatMap((s) => {
  if (!s.oneYPct) return [];
  const p = s.pts.find((pt) => pt.months === 12);
  if (!p) return [];
  return [{ x: p.x, y: p.y + 16, txt: s.oneYPct }];
});

const chipNames = series.map((s) => s.chip).join(', ');
const ariaLabel =
  `Hyperscaler reserved curves, US, as of ${meta.as_of_date}: USD per GPU-hour for ${chipNames}. ` +
  `Each point is the median of AWS, Azure and GCP — the three hyperscalers publishing committed terms — ` +
  `each entering as its lowest posted US rate at that tenor. Same panel at on-demand, 1-year and 3-year, ` +
  `so each curve connects through on-demand and the percentage tags are within-panel discounts. ` +
  `OCI publishes on-demand only and is excluded. Hover any point for the three provider rates behind it.`;
---
<figure class="htc" aria-describedby="htc-caption">
  <div class="htc-head">
    <span class="htc-kicker">Hyperscaler reserved · US · USD per GPU-hr</span>
    <span class="htc-asof">as of {meta.as_of_date}</span>
  </div>

  <div class="htc-scroll">
    <svg
      viewBox={`0 0 ${W} ${H}`}
      role="img"
      aria-label={ariaLabel}
      class="htc-svg"
    >
      {yTicks.map((v) => (
        <line
          class:list={['grid', { baseline: v === Y_MIN }]}
          x1={x0} x2={x1} y1={yOf(v)} y2={yOf(v)}
        />
      ))}
      {yTicks.map((v) => (
        <text class="ytick" x={x0 - 8} y={yOf(v) + 3.5}>${v}</text>
      ))}

      <line class="divider" x1={odDividerX} x2={odDividerX} y1={y0} y2={y1} />

      {X_TICKS.map((t) => (
        <>
          <line class="xtickmark" x1={xOf(t.months)} x2={xOf(t.months)} y1={y1} y2={y1 + 4} />
          <text class="xtick" x={xOf(t.months)} y={y1 + 17}>{t.label}</text>
        </>
      ))}

      {series.map((s) => (
        <path class={`ln s-${s.cls}`} d={s.path} />
      ))}

      {series.map((s) => s.pts.map((p) => (
        <circle
          class:list={['pt', `s-${s.cls}`, { prov: p.prov }]}
          cx={p.x} cy={p.y} r={4.5}
        />
      )))}

      {oneYearTags.map((t) => (
        <text class="yr1-tag" x={t.x} y={t.y}>{t.txt}</text>
      ))}

      {series.map((s) => s.pts.map((p) => (
        <circle class="hit" cx={p.x} cy={p.y} r={13}>
          <title>{p.title}</title>
        </circle>
      )))}

      {endLabels.map(({ s, y, leader }) => (
        <>
          {leader && (
            <line class="leader" x1={s.end.x + 6} y1={s.end.y} x2={s.end.x + 9} y2={y} />
          )}
          <text class="lbl" x={s.end.x + 11} y={y + 3.5}>
            <tspan class="lbl-name">{s.chip}</tspan>
            <tspan class="lbl-val" dx="5">{fmt(s.end.value)}</tspan>
            {s.endPct && <tspan class="lbl-spd" dx="6">{s.endPct}</tspan>}
          </text>
        </>
      ))}
    </svg>
  </div>

  <figcaption class="htc-foot" id="htc-caption">
    <span class="htc-note">
      Median of AWS · Azure · GCP posted schedules (lowest US rate each) ·
      guaranteed · OCI excluded (on-demand only) · as of {meta.as_of_date}
    </span>
    <details class="htc-details">
      <summary>Chart notes</summary>
      <ul class="htc-notes-list">
        <li>Each point is the median of AWS, Azure and GCP — the three
        hyperscalers that publish committed terms — with each provider
        entering as its lowest posted US guaranteed rate at that tenor.
        The same three providers stand behind every point, so the curve
        connects through on-demand and the percentage tags are honest
        within-panel discounts. US only; this section does not pool
        geographies.</li>
        <li><strong>OCI is excluded, deliberately.</strong> OCI publishes
        on-demand prices only — no reserved or committed rate appears on
        any public OCI surface we capture, for any chip we track. Adding
        an on-demand-only seller would change the panel at one tenor and
        manufacture curve shape. If OCI ever posts a committed lane, it
        joins.</li>
        <li>A reservation price is a fixed schedule — the posted price of a
        commitment starting today, held for its term. Not a forecast of
        future on-demand rates.</li>
        <li>AWS's H100 1-year leg is its convertible reserved class — AWS
        publishes no standard 1-year offering for that instance, and the
        convertible rate is its only posted 1-year commitment.</li>
        <li><strong>H200 is absent for the same panel discipline.</strong>
        AWS's posted US H200 reserved rates left its price file on
        2026-08-11 (last US print 2026-08-10; its APAC and EU H200
        reserved rates remain posted). With only two of the three
        providers publishing US committed H200 terms, the curve does not
        draw. It returns when the full panel prints.</li>
        <li>Azure lists 5-year reservations but no 5-year point prints yet
        — the tenor joins when the full panel publishes it. Hover any
        point for the three provider rates behind the median.</li>
      </ul>
    </details>
  </figcaption>
</figure>

<style>
  /* Same series tokens as TermCurveChart — same chip, same hue. */
  .htc {
    --series-h100: #cc7d00;
    --series-h200: #00829e;
    --series-a100: #5f7fd9;
    border: 1px solid var(--rule);
    background: var(--surface);
    padding: 12px 14px 12px;
    margin: 0 0 20px;
  }
  :global(html[data-theme="editorial"]) .htc {
    --series-h100: #a3660f;
    --series-h200: #0d96b6;
    --series-a100: #4d5fc0;
  }

  .htc-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding-bottom: 9px;
    margin-bottom: 4px;
    border-bottom: 1px solid var(--rule);
  }
  .htc-kicker {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: var(--weight-strong);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eye);
    color: var(--ink-dim);
  }
  .htc-asof {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--ink-faint);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .htc-scroll { overflow-x: auto; }
  .htc-svg { display: block; width: 100%; min-width: 680px; height: auto; }

  .grid { stroke: var(--rule); stroke-width: 1; }
  .grid.baseline { stroke: var(--rule-2); }
  .divider { stroke: var(--rule-2); stroke-width: 1; }
  .xtickmark { stroke: var(--rule-2); stroke-width: 1; }

  .ytick, .xtick {
    font-family: var(--font-mono);
    font-size: 10.5px;
    fill: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }
  .ytick { text-anchor: end; }
  .xtick { text-anchor: middle; }

  .yr1-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    fill: var(--ink-faint);
    text-anchor: middle;
    font-variant-numeric: tabular-nums;
  }

  .ln {
    fill: none;
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .ln.s-h100 { stroke: var(--series-h100); }
  .ln.s-h200 { stroke: var(--series-h200); }
  .ln.s-a100 { stroke: var(--series-a100); }

  .pt { stroke: var(--surface); stroke-width: 2; }
  .pt.s-h100 { fill: var(--series-h100); }
  .pt.s-h200 { fill: var(--series-h200); }
  .pt.s-a100 { fill: var(--series-a100); }
  .pt.prov { fill: var(--surface); }
  .pt.prov.s-h100 { stroke: var(--series-h100); }
  .pt.prov.s-h200 { stroke: var(--series-h200); }
  .pt.prov.s-a100 { stroke: var(--series-a100); }

  .hit { fill: transparent; cursor: help; }
  .leader { stroke: var(--ink-faint); stroke-width: 1; }

  .lbl {
    font-family: var(--font-mono);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }
  .lbl-name { fill: var(--ink); font-weight: var(--weight-strong); letter-spacing: 0.04em; }
  .lbl-val { fill: var(--ink-dim); }
  .lbl-spd { fill: var(--ink-faint); font-size: 10px; }

  .htc-foot {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 6px;
    padding-top: 8px;
    border-top: 1px solid var(--rule);
  }
  .htc-note {
    font-family: var(--font-mono);
    font-size: calc(var(--fs-xs) - 1px);
    color: var(--ink-faint);
    letter-spacing: 0.02em;
    line-height: 1.6;
  }

  .htc-details { margin-top: 2px; }
  .htc-details summary {
    font-family: var(--font-mono);
    font-size: calc(var(--fs-xs) - 1px);
    color: var(--ink-dim);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    width: fit-content;
  }
  .htc-notes-list {
    margin: 6px 0 2px;
    padding-left: 18px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .htc-notes-list li {
    font-family: var(--font-mono);
    font-size: calc(var(--fs-xs) - 1px);
    color: var(--ink-faint);
    letter-spacing: 0.02em;
    line-height: 1.6;
  }
</style>
