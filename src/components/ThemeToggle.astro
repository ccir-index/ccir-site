---
// Two-state toggle, moon (dark) / sun (light) icons (John, 2026-09-24). Flips the data-theme attribute on <html> between
// "terminal" (default) and "editorial". Persisted in localStorage under
// the key `ccir-theme-v2` (versioned at the 2026-08 redesign).
---
<button type="button" id="theme-toggle" aria-label="Toggle dark or light theme" title="Dark / light">
  <span class="seg" data-theme-target="terminal" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
  </span>
  <span class="seg" data-theme-target="editorial" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  </span>
</button>

<style>
  #theme-toggle {
    display: inline-flex;
    align-items: stretch;
    background: transparent;
    border: 1px solid var(--rule-2);
    color: var(--ink-dim);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-eye);
    text-transform: uppercase;
    cursor: pointer;
    border-radius: var(--rad);
    padding: 0;
    overflow: hidden;
  }
  #theme-toggle .seg {
    display: inline-flex;
    align-items: center;
    padding: 4px 8px;
    color: var(--ink-faint);
    transition: color 120ms, background 120ms;
  }
  #theme-toggle .seg + .seg { border-left: 1px solid var(--rule-2); }
  /* Chrome control — wayfinding side of the palette, rides --link. */
  #theme-toggle:hover { border-color: var(--link); }

  :global(html[data-theme="terminal"]) #theme-toggle .seg[data-theme-target="terminal"] {
    color: var(--link);
    background: color-mix(in srgb, var(--link) 14%, transparent);
  }
  :global(html[data-theme="editorial"]) #theme-toggle .seg[data-theme-target="editorial"] {
    color: var(--link);
    background: color-mix(in srgb, var(--link) 14%, transparent);
  }
</style>

<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var root = document.documentElement;
      var current = root.getAttribute('data-theme') || 'terminal';
      var next = current === 'terminal' ? 'editorial' : 'terminal';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('ccir-theme-v2', next); } catch (e) {}
    });
  })();
</script>
