---
/*
  ⚠️ DEV-ONLY — style-variant switcher for owner comparison (2026-08-13).

  Fixed bottom-right pill: A / B / C / D. Sets `data-variant` on <html>,
  persists under localStorage `ccir-variant`, and PINS `data-theme` per
  variant (B/D → editorial, C → terminal, A → the user's stored theme)
  so theme-scoped chart tokens stay light/dark-coherent.

  Delete before merge: this file, its single import in layouts/Base.astro,
  and the html[data-variant] blocks in styles/tokens.css (or promote the
  winning variant's values into the theme blocks).

  Early application (no flash) happens in Base.astro's boot script.
*/
const VARIANTS = [
  { key: 'a', label: 'A', title: 'Current — terminal dark, orange/blue · IBM Plex Serif/Sans/Mono' },
  { key: 'modern-light', label: 'B', title: 'Modern light — institutional · Space Grotesk / Source Sans 3' },
  { key: 'terminal-pro', label: 'C', title: 'Terminal pro — near-black, blue-only · JetBrains Mono' },
  { key: 'print', label: 'D', title: 'Print — paper, hairline rules · Newsreader / Source Serif 4' },
];
---
<div class="variant-switcher" role="group" aria-label="Style variant (dev only)">
  <span class="vs-tag" title="Dev-only style comparison. Not part of the site.">DEV</span>
  {VARIANTS.map((v) => (
    <button type="button" class="vs-btn" data-variant-key={v.key} title={v.title}>{v.label}</button>
  ))}
</div>

<style>
  .variant-switcher {
    position: fixed;
    right: 14px;
    bottom: 14px;
    z-index: 999;
    display: inline-flex;
    align-items: center;
    background: var(--surface-3);
    border: 1px solid var(--rule-2);
    border-radius: 999px;
    padding: 3px;
    box-shadow: 0 4px 18px -6px rgba(0, 0, 0, 0.45);
    font-family: var(--font-mono);
  }
  .vs-tag {
    font-size: 9px;
    letter-spacing: 0.12em;
    color: var(--ink-faint);
    padding: 0 7px 0 9px;
    user-select: none;
  }
  .vs-btn {
    appearance: none;
    background: transparent;
    border: 0;
    border-radius: 999px;
    width: 26px;
    height: 26px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: var(--weight-strong);
    color: var(--ink-dim);
    cursor: pointer;
  }
  .vs-btn:hover { color: var(--ink); background: var(--surface-2); }
  .vs-btn.on { background: var(--link); color: var(--bg); }
</style>

<script is:inline>
  (function () {
    var THEME_FOR = { 'modern-light': 'editorial', 'terminal-pro': 'terminal', 'print': 'editorial' };
    var root = document.documentElement;
    var btns = document.querySelectorAll('.variant-switcher .vs-btn');

    function apply(key) {
      if (key && key !== 'a' && THEME_FOR[key]) {
        root.setAttribute('data-variant', key);
        root.setAttribute('data-theme', THEME_FOR[key]);
      } else {
        key = 'a';
        root.removeAttribute('data-variant');
        var t = 'terminal';
        try { var s = localStorage.getItem('ccir-theme'); if (s === 'editorial' || s === 'terminal') t = s; } catch (e) {}
        root.setAttribute('data-theme', t);
      }
      btns.forEach(function (b) {
        b.classList.toggle('on', b.getAttribute('data-variant-key') === key);
      });
      try { localStorage.setItem('ccir-variant', key); } catch (e) {}
    }

    btns.forEach(function (b) {
      b.addEventListener('click', function () { apply(b.getAttribute('data-variant-key')); });
    });

    // Sync button state with whatever the boot script already applied.
    var current = root.getAttribute('data-variant') || 'a';
    btns.forEach(function (b) {
      b.classList.toggle('on', b.getAttribute('data-variant-key') === current);
    });
  })();
</script>
