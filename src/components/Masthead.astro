---
import ThemeToggle from './ThemeToggle.astro';
import { meta } from '../data/snapshot';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/rates', label: 'Rates' },
  // Research is a hub (monitors + dated notes) — light it up on every piece
  // it houses, including /research/* note subroutes.
  { href: '/research', label: 'Research',
    match: ['/research', '/intelligence', '/term', '/basis', '/spreads',
            '/realized', '/chip-economics', '/utilization', '/observatory',
            '/availability', '/markets', '/marketplace', '/vast'] },
  { href: '/credit', label: 'Credit' },
  { href: '/hardware', label: 'Secondary', label2: 'Market' },
  { href: '/explorer', label: 'Explorer' },
  { href: '/applications', label: 'Applications' },
  { href: '/contact', label: 'Contact' },
];

function isActive(n: { href: string; match?: string[] }): boolean {
  const group = n.match ?? [n.href];
  return group.some((g) => path === g || path.startsWith(g + '/'));
}
---
<header class="masthead">
  <div class="top-rule">
    <div class="wrap top-rule-inner">
      <span class="claim">No positions in the markets we measure</span>
      <span class="top-meta">
        <span class="dateline">AS OF {meta.as_of_date}</span>
        <span class="sep" aria-hidden="true">·</span>
        <span class="status">
          <span class="dot" aria-hidden="true"></span>BY 07:30 ET
        </span>
      </span>
    </div>
  </div>
  <div class="masthead-band wrap">
    <a class="brand" href="/">
      <span class="brand-mark">CCIR</span>
      <span class="brand-name">Compute Credit<br />Index Research</span>
    </a>
    <nav class="nav">
      {nav.map((n) => (
        <a
          href={n.href}
          class:list={['nav-link', { on: isActive(n), stacked: !!n.label2 }]}
        >{n.label}{n.label2 && <span class="nav-l2">{n.label2}</span>}</a>
      ))}
    </nav>
    <div class="masthead-tools">
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .masthead { background: var(--surface); border-bottom: 1px solid var(--rule-2); }

  /* Row 1 — the claim, the date, the cadence. Nothing else. */
  .top-rule {
    background: var(--surface-2);
    border-bottom: 1px solid var(--rule);
  }
  .top-rule-inner {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-top: 6px;
    padding-bottom: 6px;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eye);
  }
  .claim {
    color: var(--accent);
    font-weight: var(--weight-strong);
  }
  .top-meta {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink-dim);
    white-space: nowrap;
  }
  .dateline { color: var(--ink); font-weight: var(--weight-strong); }
  .sep { color: var(--ink-faint); }
  .status { display: inline-flex; align-items: center; gap: 6px; }
  .status .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--pos);
    box-shadow: 0 0 6px var(--pos);
  }

  /* Row 2 — identity and navigation. */
  .masthead-band {
    display: flex;
    align-items: center;
    gap: 32px;
    padding-top: 12px;
    padding-bottom: 12px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--ink);
    flex-shrink: 0;
  }
  .brand-mark {
    color: var(--accent);
    font-family: var(--font-mono);
    font-weight: var(--weight-strong);
    font-size: var(--fs-2xl);
    letter-spacing: 0.04em;
    line-height: 1;
  }
  .brand-name {
    font-family: var(--font-mono);
    font-size: calc(var(--fs-xs) - 1px);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eye);
    color: var(--ink-dim);
    line-height: 1.45;
  }
  .nav { display: flex; gap: 22px; align-items: center; }
  .nav-link.stacked { line-height: 1.25; padding: 0; }
  .nav-l2 { display: block; }
  .nav-link {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eye);
    color: var(--ink-dim);
    padding: 4px 0;
    border-bottom: 1px solid transparent;
  }
  .nav-link:hover { color: var(--ink); text-decoration: none; }
  .nav-link.on { color: var(--accent); border-bottom-color: var(--accent); }
  .masthead-tools { margin-left: auto; flex-shrink: 0; }

  /* Mobile — contain nav overflow inside the band itself
     instead of pushing the whole page wider than the viewport. */
  @media (max-width: 860px) {
    .masthead-band { gap: 16px; flex-wrap: wrap; }
    .nav {
      order: 3;
      flex: 1 1 100%;
      gap: 16px;
      overflow-x: auto;
      min-width: 0;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .nav::-webkit-scrollbar { display: none; }
    .nav-link { flex-shrink: 0; white-space: nowrap; }
  }

  @media (max-width: 720px) {
    .top-rule-inner { flex-wrap: wrap; gap: 4px 16px; }
    .top-meta { margin-left: auto; }
    .masthead-band { padding-top: 10px; padding-bottom: 8px; }
    .brand-mark { font-size: var(--fs-xl); }
  }

  @media (max-width: 480px) {
    .brand-name { display: none; }
    .status { display: none; }
    .sep { display: none; }
  }
</style>
