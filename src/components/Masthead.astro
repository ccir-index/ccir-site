---
/*
  Masthead (redesign/v1) — two rows.

  Row 1 (utility): the independence claim · Applications / Documents /
  Contact · dateline + cadence. Non-market destinations live here so the
  primary band carries market surfaces only.

  Row 2 (primary): brand block + grouped nav. Groups mirror the surface
  architecture — flow (Rates/Term/Tokens), financing (Credit), residual
  (Hardware), analysis (Research), data (Explorer) — with hairline
  dividers and a tiny role overline per group on wide viewports.

  All hrefs unchanged from the previous nav; 'Secondary Market' is
  relabeled 'Hardware' (same /hardware route).
*/
import ThemeToggle from './ThemeToggle.astro';
import { meta } from '../data/snapshot';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

interface Item { href: string; label: string; match?: string[] }
interface Group { role: string; items: Item[] }

const groups: Group[] = [
  { role: 'flow', items: [
    { href: '/rates', label: 'Rates' },
    { href: '/term', label: 'Term' },
    { href: '/tokens', label: 'Tokens' },
  ] },
  { role: 'financing', items: [
    { href: '/credit', label: 'Credit' },
  ] },
  { role: 'residual', items: [
    { href: '/hardware', label: 'Hardware' },
  ] },
  { role: 'analysis', items: [
    { href: '/research', label: 'Research',
      match: ['/research', '/intelligence', '/basis', '/realized',
              '/chip-economics', '/utilization', '/availability'] },
  ] },
  { role: 'data', items: [
    { href: '/explorer', label: 'Explorer' },
  ] },
];

function isActive(n: Item): boolean {
  const group = n.match ?? [n.href];
  return group.some((g) => path === g || path.startsWith(g + '/'));
}
---
<header class="masthead">
  <div class="top-rule">
    <div class="wrap top-rule-inner">
      <span class="claim">No positions in the markets we measure</span>
      <nav class="utility" aria-label="Utility">
        <a href="/applications" class:list={[{ on: isActive({ href: '/applications', label: '' }) }]}>Applications</a>
        <a href="/documents" class:list={[{ on: isActive({ href: '/documents', label: '' }) }]}>Documents</a>
        <a href="/contact" class:list={[{ on: isActive({ href: '/contact', label: '' }) }]}>Contact</a>
      </nav>
      <span class="top-meta">
        <span class="dateline">AS OF {meta.as_of_date}</span>
        <span class="sep" aria-hidden="true">·</span>
        <span class="status">
          <span class="dot" aria-hidden="true"></span>BY 07:30 ET
        </span>
      </span>
    </div>
  </div>
  <div class="masthead-band wrap">
    <a class="brand" href="/">
      <span class="brand-mark">CCIR</span>
      <span class="brand-name">Compute Credit<br />Index Research</span>
    </a>
    <nav class="nav" aria-label="Primary">
      {groups.map((g, i) => (
        <div class:list={['nav-group', { first: i === 0 }]}>
          <span class="nav-role" aria-hidden="true">{g.role}</span>
          <div class="nav-items">
            {g.items.map((n) => (
              <a
                href={n.href}
                class:list={['nav-link', { on: isActive(n) }]}
                aria-current={isActive(n) ? 'page' : undefined}
              >{n.label}</a>
            ))}
          </div>
        </div>
      ))}
    </nav>
    <div class="masthead-tools">
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .masthead { background: var(--surface); border-bottom: 1px solid var(--rule-2); }

  /* Row 1 — claim · utility links · date/cadence. */
  .top-rule {
    background: var(--surface-2);
    border-bottom: 1px solid var(--rule);
  }
  .top-rule-inner {
    display: flex;
    align-items: center;
    gap: 18px;
    padding-top: 6px;
    padding-bottom: 6px;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eye);
  }
  .claim {
    color: var(--accent);
    font-weight: var(--weight-strong);
  }
  .utility {
    display: inline-flex;
    gap: 14px;
    margin-left: auto;
  }
  .utility a { color: var(--ink-dim); }
  .utility a:hover { color: var(--link); text-decoration: none; }
  .utility a.on { color: var(--link); }
  .top-meta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink-dim);
    white-space: nowrap;
    padding-left: 16px;
    border-left: 1px solid var(--rule);
  }
  .dateline { color: var(--ink); font-weight: var(--weight-strong); }
  .sep { color: var(--ink-faint); }
  .status { display: inline-flex; align-items: center; gap: 6px; }
  .status .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--pos);
    box-shadow: 0 0 6px var(--pos);
  }

  /* Row 2 — identity and grouped navigation. */
  .masthead-band {
    display: flex;
    align-items: center;
    gap: 28px;
    padding-top: 12px;
    padding-bottom: 12px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--ink);
    flex-shrink: 0;
  }
  .brand-mark {
    color: var(--accent);
    font-family: var(--font-mono);
    font-weight: var(--weight-strong);
    font-size: var(--fs-2xl);
    letter-spacing: 0.04em;
    line-height: 1;
  }
  .brand-name {
    font-family: var(--font-mono);
    font-size: calc(var(--fs-xs) - 1px);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eye);
    color: var(--ink-dim);
    line-height: 1.45;
  }

  .nav { display: flex; align-items: stretch; }
  .nav-group {
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: 0 18px;
    border-left: 1px solid var(--rule);
  }
  .nav-group.first { border-left: none; padding-left: 0; }
  .nav-role {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    line-height: 1;
  }
  .nav-items { display: flex; gap: 18px; }
  .nav-link {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eye);
    color: var(--ink-dim);
    padding: 3px 0 4px;
    border-bottom: 1px solid transparent;
  }
  .nav-link:hover { color: var(--ink); text-decoration: none; }
  .nav-link.on { color: var(--link); border-bottom-color: var(--link); }
  .masthead-tools { margin-left: auto; flex-shrink: 0; }

  /* Wide-but-not-huge: drop the role overlines before anything wraps. */
  @media (max-width: 1100px) {
    .nav-role { display: none; }
    .nav-group { justify-content: center; }
  }

  /* Mobile — contain nav overflow inside the band itself
     instead of pushing the whole page wider than the viewport. */
  @media (max-width: 880px) {
    .masthead-band { gap: 16px; flex-wrap: wrap; }
    .nav {
      order: 3;
      flex: 1 1 100%;
      overflow-x: auto;
      min-width: 0;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .nav::-webkit-scrollbar { display: none; }
    .nav-group { padding: 0 14px; }
    .nav-items { gap: 14px; }
    .nav-link { flex-shrink: 0; white-space: nowrap; }
  }

  @media (max-width: 720px) {
    .top-rule-inner { flex-wrap: wrap; gap: 4px 14px; }
    .masthead-band { padding-top: 10px; padding-bottom: 8px; }
    .brand-mark { font-size: var(--fs-xl); }
  }

  @media (max-width: 560px) {
    .claim { flex-basis: 100%; }
    .utility { margin-left: 0; }
    .top-meta { margin-left: auto; }
  }

  @media (max-width: 480px) {
    .brand-name { display: none; }
    .status { display: none; }
    .sep { display: none; }
    .top-meta { padding-left: 0; border-left: none; }
  }
</style>
