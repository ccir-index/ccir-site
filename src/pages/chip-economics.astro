---
import Base from '../layouts/Base.astro';

// Chip Economics — Phase 0 (static). Every exhibit on this page is computed
// below from ONE rate per generation and the registry denominators, so a dot,
// a table cell, a spread and a tooltip cannot disagree with each other.
// Phase 2 swaps RATE/NSRC for normalized_daily.csv per the spec
// (v2/ccir-v2-notebooks/drafts/normalized_rates_spec_2026_07.md §9).
//
// Basis: CRI-T2-{chip}-SXM-GTD-OD-ALL — Neocloud, guaranteed, on-demand.
// Region ALL is the only region where all five generations publish together:
// B300 prints a US cell on a minority of days and at n=3. Form factor is SXM
// throughout so each numerator matches its SXM nameplate denominator.
const PRINT_DATE = '2026-08-15';
const SNAP_DATE = '2026-08-12';

const GEN_ORDER = ['B300', 'B200', 'H200', 'H100', 'A100'];
const REGISTRY = {
  B300: { label: 'B300',      age: 0.8, ageLab: '~0.8y', arch: 'blackwell', gb: 288, bw: 8.0,  pf: 2.25, kw: 1.3, approx: true },
  B200: { label: 'B200',      age: 1.4, ageLab: '~1.4y', arch: 'blackwell', gb: 180, bw: 8.0,  pf: 2.25, kw: 1.0 },
  H200: { label: 'H200',      age: 2.1, ageLab: '~2.1y', arch: 'hopper',    gb: 141, bw: 4.8,  pf: 0.99, kw: 0.7 },
  H100: { label: 'H100 SXM',  age: 3.7, ageLab: '~3.7y', arch: 'hopper',    gb: 80,  bw: 3.35, pf: 0.99, kw: 0.7 },
  A100: { label: 'A100 80GB', age: 5.7, ageLab: '~5.7y', arch: 'ampere',    gb: 80,  bw: 2.0,  pf: 0.31, kw: 0.4 },
};
const RATE = { B300: 7.8500, B200: 6.4000, H200: 4.5000, H100: 3.8900, A100: 2.0840 };
const NSRC = { B300: 9,      B200: 8,      H200: 14,     H100: 21,     A100: 11 };

// y scales: two anchor ticks per lens, unchanged from first print so the
// exhibits stay comparable across refreshes. x is generation age.
const LENSES = [
  { key: 'gb', name: 'Capacity',  unit: '$ / GB-hr',    y0: [0.02, 98.4], y1: [0.04, 30.9], dp: 4,
    ticks: [[0.02, '.02'], [0.04, '.04']], labels: true,
    kick: ['what the chip can hold', 'the size of model and context it can host'],
    aria: 'dollars per gigabyte of HBM per hour' },
  { key: 'bw', name: 'Bandwidth', unit: '$ / TB/s-hr',  y0: [0.50, 93.6], y1: [1.00, 21.2], dp: 3,
    ticks: [[0.50, '.50'], [1.00, '1.00']], band: true,
    kick: ['how fast it moves data', 'the dimension inference workloads buy'],
    aria: 'dollars per terabyte-per-second of memory bandwidth per hour' },
  { key: 'pf', name: 'Compute',   unit: '$ / PFLOP-hr', y0: [2, 119.2],   y1: [6, 25.7],    dp: 2,
    ticks: [[2, '$2'], [4, '$4'], [6, '$6']],
    kick: ['how fast it does arithmetic', 'training speed'],
    aria: 'dollars per dense BF16 petaflop per hour' },
  { key: 'kw', name: 'Power',     unit: '$ / kW-hr',    y0: [2, 125.5],   y1: [6, 44.4],    dp: 2,
    ticks: [[2, '$2'], [4, '$4'], [6, '$6']],
    kick: ['what it costs to keep lit', 'rent per watt against facility cost per watt'],
    aria: 'dollars per kilowatt of TDP per hour' },
];
const X = (age) => +(36 + (221.8 - 36) / 6 * age).toFixed(1);
const yFor = (lens, v) =>
  +(lens.y0[1] + (v - lens.y0[0]) * (lens.y1[1] - lens.y0[1]) / (lens.y1[0] - lens.y0[0])).toFixed(1);

const VAL = {};   // VAL[lensKey][gen] = number
const STAT = {};  // STAT[lensKey] = { min, max, mean, spread }
for (const lens of LENSES) {
  VAL[lens.key] = {};
  for (const g of GEN_ORDER) VAL[lens.key][g] = RATE[g] / REGISTRY[g][lens.key];
  const vs = GEN_ORDER.map((g) => VAL[lens.key][g]);
  const min = Math.min(...vs), max = Math.max(...vs);
  const mean = vs.reduce((a, b) => a + b, 0) / vs.length;
  STAT[lens.key] = { min, max, mean, spread: 100 * (max - min) / mean };
}
const fmt = (lens, g) => VAL[lens.key][g].toFixed(lens.dp);
const pc = (k) => Math.round(STAT[k].spread);
// label side per generation on the capacity panel (only panel carrying labels)
const LABSIDE = { B300: 'below', B200: 'below', H200: 'right', H100: 'below', A100: 'left' };

// §02 band, on the bandwidth lens
const BAND = STAT.bw;
// How often each lens is the tightest, over the recorded window (46 complete
// days, 1 Jul – 15 Aug 2026; scratch/backfill_bandwidth_parity_20260815.py).
// POWER now leads BANDWIDTH on this basis. Both compress the cross-section by
// roughly two thirds; capacity and compute never come close to either. The
// page reports the pair rather than crowning one.
const BW_TIGHTEST_DAYS = 15, KW_TIGHTEST_DAYS = 31, BAND_DAYS = 46;
// Recorded band, one row per complete day: [date, min, max, mean] on the
// basis above. Composition seams (panel additions) are marked, not smoothed.
const BAND_HISTORY = [['2026-07-01',0.8636,1.0545,0.9419],['2026-07-02',0.8650,1.0641,0.9615],['2026-07-03',0.8647,1.0592,0.9483],['2026-07-04',0.8650,1.0439,0.9471],['2026-07-05',0.8650,1.0443,0.9526],['2026-07-06',0.8650,1.0644,0.9566],['2026-07-07',0.8650,1.0622,0.9543],['2026-07-08',0.8363,1.0804,0.9672],['2026-07-09',0.8363,1.0642,0.9626],['2026-07-10',0.8363,1.0629,0.9401],['2026-07-11',0.8363,1.0313,0.9424],['2026-07-12',0.8363,1.0511,0.9488],['2026-07-13',0.8363,1.0245,0.9410],['2026-07-14',0.8363,1.1024,0.9769],['2026-07-15',0.7638,1.0912,0.9397],['2026-07-16',0.7638,1.0739,0.9300],['2026-07-17',0.7638,1.0721,0.9155],['2026-07-18',0.7638,1.0782,0.9217],['2026-07-19',0.7638,1.0855,0.9232],['2026-07-20',0.8000,1.0891,0.9311],['2026-07-21',0.8000,1.0868,0.9409],['2026-07-22',0.8000,1.0867,0.9268],['2026-07-23',0.8363,1.0885,0.9651],['2026-07-24',0.8363,1.0899,0.9549],['2026-07-25',0.8363,1.0884,0.9579],['2026-07-26',0.8000,1.0767,0.9440],['2026-07-27',0.8000,1.0741,0.9442],['2026-07-28',0.8000,1.0972,0.9518],['2026-07-29',0.8000,1.1394,0.9651],['2026-07-30',0.8000,1.0915,0.9555],['2026-07-31',0.8000,1.0761,0.9389],['2026-08-01',0.8363,1.0982,0.9506],['2026-08-02',0.8363,1.1143,0.9662],['2026-08-03',0.8363,1.0951,0.9522],['2026-08-04',0.8363,1.1005,0.9742],['2026-08-05',0.8363,1.0951,0.9694],['2026-08-06',0.8363,1.1074,0.9763],['2026-08-07',0.8363,1.1072,0.9671],['2026-08-08',0.8363,1.1071,0.9665],['2026-08-09',0.8363,1.1035,0.9759],['2026-08-10',0.8363,1.1176,0.9686],['2026-08-11',0.8000,1.1313,0.9641],['2026-08-12',0.8000,1.1613,0.9844],['2026-08-13',0.8000,1.1481,0.9803],['2026-08-14',0.8000,1.1249,0.9760],['2026-08-15',0.8000,1.1647,0.9840]];
const SEAM_DATES = ['2026-07-15', '2026-08-13'];
const bandSpread = (r) => 100 * (r[2] - r[1]) / r[3];
const FIRST = BAND_HISTORY[0], LAST_CLEAN = BAND_HISTORY.find((r) => r[0] === SNAP_DATE);
// §02 zoomed chart: axis padded around the recorded extremes, ticks at 0.10
const ZMIN = 0.75, ZMAX = 1.10, ZY0 = 250, ZY1 = 37.3;
const yb = (v) => +(ZY0 + (v - ZMIN) * (ZY1 - ZY0) / (ZMAX - ZMIN)).toFixed(1);
const xb = (age) => +(46 + (524.1 - 46) / 6 * age).toFixed(1);
const ZTICKS = [0.80, 0.90, 1.00, 1.10];
---
<Base
  title="Chip Economics · CCIR"
  description="Comparability analysis across GPU generations: earning power per spec-sheet unit — the same daily reference rates re-denominated per GB, per TB/s, per PFLOP, per kW. One denominator makes the cross-section flat: that is the dimension the market prices."
  ogImage="/og/chip-economics.png"
>
  <nav class="apps-navband" aria-label="On this page">
    <div class="wrap apps-nav-inner">
      <a class="apps-nav-link" href="#lenses">Lenses</a>
      <a class="apps-nav-link" href="#bandwidth">Bandwidth</a>
      <a class="apps-nav-link" href="#parity">Parity</a>
      <a class="apps-nav-link" href="#watt-rent">Watt-Rent</a>
      <a class="apps-nav-link" href="#economic-life">Economic Life</a>
      <a class="apps-nav-link" href="#method">Method</a>
    </div>
  </nav>

  <section class="wrap top">

    <header class="page-head">
      <div class="kicker">Monitor · Chip Economics</div>
      <h1>Chip Economics</h1>
      <p class="standfirst">Earning power per spec-sheet unit.</p>
    </header>

    <div class="designation" role="note">
      <p class="desig-main">Analytical decomposition of published reference rates: <em>not a reference rate</em>.</p>
    </div>

    <!-- ======================= §01 LENSES ======================= -->
    <section class="sec wide" id="lenses">
      <h2><span class="n">01</span> Four Lenses on One Rate</h2>

      <div class="heromult" id="heromult">
        <div class="lens-grid">

          {LENSES.map((lens) => (
            <div class={'lens-panel' + (lens.band ? ' lp-flat' : '')}>
              <header class="lp-head">
                <div class="lp-row">
                  <span class="lp-name">{lens.name}</span>
                  <span class="lp-unit">{lens.unit}</span>
                  <span class="lp-spread">spread {pc(lens.key)}%</span>
                </div>
                <p class="lp-kick">{lens.kick[0]} — <span class="kx">{lens.kick[1]}</span></p>
              </header>
              <svg viewBox="0 0 240 210" role="img"
                   aria-label={`${lens.name} lens: ${lens.aria} against generation age. Values run from ${STAT[lens.key].min.toFixed(lens.dp)} to ${STAT[lens.key].max.toFixed(lens.dp)}; cross-generation spread ${pc(lens.key)} percent.`}>
                {lens.band && (
                  <rect x="36" y={yFor(lens, STAT.bw.max)} width="192"
                        height={+(yFor(lens, STAT.bw.min) - yFor(lens, STAT.bw.max)).toFixed(1)} class="bandfill"/>
                )}
                {lens.band && <line x1="36" x2="228" y1={yFor(lens, STAT.bw.mean)} y2={yFor(lens, STAT.bw.mean)} class="bandmean"/>}
                {lens.ticks.map(([v, l]) => <line x1="36" x2="228" y1={yFor(lens, v)} y2={yFor(lens, v)} class="grid"/>)}
                {lens.ticks.map(([v, l]) => <text x="32" y={+(yFor(lens, v) + 3).toFixed(1)} class="tick" text-anchor="end">{l}</text>)}
                <line x1="36" x2="228" y1="166" y2="166" class="axisln"/>
                <text x="36" y="180" class="tick" text-anchor="middle">0y</text>
                <text x="128.9" y="180" class="tick" text-anchor="middle">3y</text>
                <text x="221.8" y="180" class="tick" text-anchor="middle">6y</text>
                {GEN_ORDER.map((g) => {
                  const cx = X(REGISTRY[g].age), cy = yFor(lens, VAL[lens.key][g]);
                  const side = LABSIDE[g];
                  return (
                    <g class={`gdot g-${g}`}>
                      <circle class="hit" cx={cx} cy={cy} r="13" tabindex="0" data-gen={g}
                              aria-label={`${REGISTRY[g].label}, ${lens.name.toLowerCase()} lens, ${fmt(lens, g)} ${lens.unit.replace('$ / ', 'dollars per ')}`}/>
                      <circle class={`pt pt-${REGISTRY[g].arch}`} cx={cx} cy={cy} r="4.5"/>
                      {lens.labels && (
                        <text
                          x={side === 'right' ? cx + 8 : side === 'left' ? cx - 8 : cx}
                          y={side === 'below' ? +(cy + 14).toFixed(1) : side === 'above' ? +(cy - 8).toFixed(1) : +(cy + 3).toFixed(1)}
                          class={`ptlab lab-${REGISTRY[g].arch}`}
                          text-anchor={side === 'right' ? 'start' : side === 'left' ? 'end' : 'middle'}>{g}</text>
                      )}
                    </g>
                  );
                })}
              </svg>
              {lens.band && <div class="lp-foot">tightest on {BW_TIGHTEST_DAYS} of {BAND_DAYS} days, power on {KW_TIGHTEST_DAYS} — see §02</div>}
            </div>
          ))}

        </div>
        <div class="tip" id="hero-tip" role="status"></div>
      </div>

      <div class="hero-legend">
        <span><span class="dotk dk-blackwell"></span>Blackwell</span>
        <span><span class="dotk dk-hopper"></span>Hopper</span>
        <span><span class="dotk dk-ampere"></span>Ampere</span>
        <span class="note">same horizontal position = same generation in every panel · hover or focus any dot for all four readings</span>
      </div>

      <p class="tfoot">
        Neocloud (T2) guaranteed on-demand, all regions, generations on age (x, years) against each lens (y, from zero).
        Spread = (max − min) ÷ mean across the five generations. Example prints · {PRINT_DATE} · rates from the
        {SNAP_DATE} snapshot. Headline stat per published rule (mean where n ≥ 10, else median).
        The compute lens is denominated in petaFLOPs (PFLOP, 10^15 floating-point operations per
        second), dense, in the BF16 number format.
      </p>

      <p class="lede">
        One observed number underlies every panel: the Neocloud guaranteed on-demand rate, in dollars per
        GPU-hour. Each panel divides that rate by one spec-sheet denominator. Two of the four compress the
        cross-section by roughly two thirds and two do not, which is the whole content of the page:
        <strong>power and memory bandwidth</strong> are the dimensions this market prices, capacity and
        compute are not. The two constrained inputs of the build-out are also the two the price tracks.
      </p>

      <div class="twrap">
        <table>
          <thead>
            <tr><th>Generation</th><th>Age</th><th class="num">$/GPU-hr</th><th class="num">n</th><th class="num">$/GB-hr</th><th class="num">$/TB/s-hr</th><th class="num">$/PFLOP-hr</th><th class="num">$/kW-hr</th></tr>
          </thead>
          <tbody>
            {GEN_ORDER.map((g) => (
              <tr>
                <td class="gen">{REGISTRY[g].label}</td>
                <td class="dim">{REGISTRY[g].ageLab}</td>
                <td class="num strong">${RATE[g].toFixed(2)}</td>
                <td class="num dim">{NSRC[g]}</td>
                {LENSES.map((lens) => <td class="num">{fmt(lens, g)}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="sid">
        <b>CRI-T2-&#123;chip&#125;-SXM-GTD-OD-ALL-&#123;GB|BW|PF|KW&#125;</b> · derived Compute Rate Index (CRI) series carry the underlying citable
        cell in the first seven segments; strip the lens suffix to reach the parent. $/GB-hr computed from
        registry high-bandwidth memory (HBM) capacity (80 / 80 / 141 / 180 / 288 GB).
      </p>
    </section>

    <!-- ======================= §02 BANDWIDTH BAND ======================= -->
    <section class="sec wide" id="bandwidth">
      <h2><span class="n">02</span> The Bandwidth Band</h2>
      <p>
        Re-denominated per unit of memory bandwidth, datacenter silicon from eight months to 5.7 years of
        age rents inside <strong>${BAND.min.toFixed(3)}–{BAND.max.toFixed(3)} per TB/s-hour</strong>, a
        {pc('bw')}% spread around a ${BAND.mean.toFixed(3)} mean. Raw, the same five generations span
        {(Math.max(...GEN_ORDER.map((g) => RATE[g])) / Math.min(...GEN_ORDER.map((g) => RATE[g]))).toFixed(1)}×.
        The band is the test, and this page set it at first print: a widening spread is the falsifiable
        marker firing. It has widened, from {bandSpread(FIRST).toFixed(0)}% on {FIRST[0]} to {pc('bw')}%
        on {SNAP_DATE}. The record is plotted below. Members are disclosed on every exhibit.
      </p>
      <p>
        The compression is a like-for-like property. It holds across cells that share an operator segment,
        interruptibility grade, term, and region: the series named under each exhibit. Pooled cuts,
        marketplace minimums, or mixed interruptibility grades will not reproduce it: grade and tenor are
        different markets per unit of bandwidth, as everywhere else on this site.
      </p>
      <p>
        Bandwidth does not hold this position alone, and on the current record it does not hold it at all.
        Power sits at {pc('kw')}%. Across the {BAND_DAYS} days recorded, power is the tightest of the four
        lenses on {KW_TIGHTEST_DAYS} days and bandwidth on {BW_TIGHTEST_DAYS}; capacity and compute are
        never within reach of either. The two that compress are the two inputs the build-out is short of.
      </p>

      <figure class="chart-fig">
        <div class="chart-box" id="bw-chart">
          <svg viewBox="0 0 680 300" role="img"
               aria-label={`Bandwidth band, axis zoomed to ${ZMIN} to ${ZMAX} dollars per TB/s-hour. A shaded band spans ${BAND.min.toFixed(3)} to ${BAND.max.toFixed(3)} with a mean line at ${BAND.mean.toFixed(3)}. Five labelled generation dots sit inside the band.`}>
            {ZTICKS.map((v) => <line x1="46" x2="540" y1={yb(v)} y2={yb(v)} class="grid"/>)}
            {ZTICKS.map((v) => <text x="38" y={+(yb(v) + 3).toFixed(1)} class="tick" text-anchor="end">{v.toFixed(2)}</text>)}

            <rect x="46" y={yb(BAND.max)} width="494" height={+(yb(BAND.min) - yb(BAND.max)).toFixed(1)} class="bw-band"/>
            <line x1="46" x2="540" y1={yb(BAND.max)} y2={yb(BAND.max)} class="bw-edge"/>
            <line x1="46" x2="540" y1={yb(BAND.min)} y2={yb(BAND.min)} class="bw-edge"/>
            <line x1="46" x2="540" y1={yb(BAND.mean)} y2={yb(BAND.mean)} class="bandmean"/>

            <text x="548" y={+(yb(BAND.max) + 3).toFixed(1)} class="annot">{BAND.max.toFixed(3)} — max</text>
            <text x="548" y={+(yb(BAND.mean) + 3).toFixed(1)} class="annot annot-acc">{BAND.mean.toFixed(3)} — mean</text>
            <text x="548" y={+(yb(BAND.min) + 3).toFixed(1)} class="annot">{BAND.min.toFixed(3)} — min</text>

            <text x="46" y="288" class="tick" text-anchor="middle">0y</text>
            <text x="205.4" y="288" class="tick" text-anchor="middle">2y</text>
            <text x="364.7" y="288" class="tick" text-anchor="middle">4y</text>
            <text x="524.1" y="288" class="tick" text-anchor="middle">6y</text>
            <text x="540" y="288" class="tick" text-anchor="start">  age</text>
            <text x="548" y="253" class="zoomnote">axis zoomed:</text>
            <text x="548" y="264" class="zoomnote">${ZMIN}–{ZMAX}, not to zero</text>

            <line id="bw-cross" class="crosshair" x1="0" x2="0" y1="16" y2="250" style="display:none"/>

            {GEN_ORDER.map((g) => {
              const cx = xb(REGISTRY[g].age), cy = yb(VAL.bw[g]);
              const below = g === 'B200' || g === 'H200' || g === 'A100';
              return (
                <g>
                  <circle class={`pt pt-${REGISTRY[g].arch}`} cx={cx} cy={cy} r="5.5"/>
                  <text x={g === 'H200' ? cx + 3 : cx} y={below ? +(cy + 17).toFixed(1) : +(cy - 11).toFixed(1)}
                        class={`ptlab lab-${REGISTRY[g].arch}`}
                        text-anchor={g === 'H200' ? 'start' : 'middle'}>{REGISTRY[g].label} {VAL.bw[g].toFixed(2)}</text>
                </g>
              );
            })}
          </svg>
          <div class="tip" id="bw-tip"></div>
        </div>
        <figcaption class="tfoot">
          $/TB/s-hr against generation age; band = min–max across qualifying members, mean line at ${BAND.mean.toFixed(3)}.
          Denominator: vendor nameplate memory bandwidth. Example prints · {PRINT_DATE} · rates from the
          {SNAP_DATE} snapshot.
        </figcaption>
      </figure>

      <div class="hist-strip" aria-label={`Band spread history, ${BAND_HISTORY[0][0]} to ${BAND_HISTORY[BAND_HISTORY.length - 1][0]}: the cross-generation spread per TB/s-hour, rising from ${bandSpread(BAND_HISTORY[0]).toFixed(0)} to ${bandSpread(BAND_HISTORY[BAND_HISTORY.length - 1]).toFixed(0)} percent.`}>
        <span class="hist-eye">Band spread</span>
        <svg viewBox="0 0 680 92">
          <line x1="40" x2="656" y1="74" y2="74" class="axisln"/>
          {[10, 20, 30, 40].map((v) => <line x1="40" x2="656" y1={+(74 - v * 1.4).toFixed(1)} y2={+(74 - v * 1.4).toFixed(1)} class="grid"/>)}
          {[20, 40].map((v) => <text x="34" y={+(74 - v * 1.4 + 3).toFixed(1)} class="hist-lab" text-anchor="end">{v}%</text>)}
          {SEAM_DATES.map((sd) => {
            const i = BAND_HISTORY.findIndex((r) => r[0] === sd);
            const x = +(40 + i * (600 / (BAND_HISTORY.length - 1))).toFixed(1);
            return <line x1={x} x2={x} y1="12" y2="74" class="grid"/>;
          })}
          <polyline class="hist-line" points={BAND_HISTORY.map((r, i) =>
            `${(40 + i * (600 / (BAND_HISTORY.length - 1))).toFixed(1)},${(74 - bandSpread(r) * 1.4).toFixed(1)}`).join(' ')}/>
          <text x="40" y="88" class="hist-lab">{BAND_HISTORY[0][0]}</text>
          <text x="656" y="88" class="hist-lab" text-anchor="end">{BAND_HISTORY[BAND_HISTORY.length - 1][0]}</text>
          <text x="348" y="88" class="hist-lab" text-anchor="middle">vertical rules mark panel additions</text>
        </svg>
      </div>
      <p class="sid"><b>CRB-T2-BW-ALL-OD-ALL</b> · band row fields: band_min · band_max · band_mean · band_spread_pct · n_chips · member_chips. Emission gate n_chips ≥ 3, all members publication-qualified. Research-grade at launch (Shadow → Provisional).</p>

      <div id="parity">
        <p>
          <strong>The two parity rules.</strong> The sharpest way to see what
          the band rules out is to price the oldest member both ways. If
          compute were the priced unit, every new generation would force the
          prior one down to its share of the throughput: against the H100
          print of ${RATE.H100.toFixed(2)}, a chip with
          {Math.round(100 * REGISTRY.A100.pf / REGISTRY.H100.pf)}% of the BF16 throughput reprices to
          ${(RATE.H100 * REGISTRY.A100.pf / REGISTRY.H100.pf).toFixed(2)}. If bandwidth is the priced
          unit, the same H100 print implies
          ${(RATE.H100 * REGISTRY.A100.bw / REGISTRY.H100.bw).toFixed(2)}: the A100 carries
          {Math.round(100 * REGISTRY.A100.bw / REGISTRY.H100.bw)}% of the bandwidth. Two rules, two
          implied rates:
        </p>
        <div class="twrap">
          <table>
            <thead>
              <tr><th>Pricing rule</th><th>Assumes the market pays for</th><th class="num">Implied A100 rate</th></tr>
            </thead>
            <tbody>
              <tr><td>Compute parity</td><td>BF16 throughput — 312 vs 989.5 TFLOPS</td><td class="num">${(RATE.H100 * REGISTRY.A100.pf / REGISTRY.H100.pf).toFixed(2)}</td></tr>
              <tr><td>Bandwidth parity</td><td>HBM bandwidth — 2.0 vs 3.35 TB/s</td><td class="num">${(RATE.H100 * REGISTRY.A100.bw / REGISTRY.H100.bw).toFixed(2)}</td></tr>
            </tbody>
          </table>
        </div>
        <p>
          The observed A100 print is <strong>${RATE.A100.toFixed(2)}</strong>:
          {Math.round(100 * RATE.A100 / (RATE.H100 * REGISTRY.A100.bw / REGISTRY.H100.bw))}% of
          bandwidth parity,
          {Math.round(100 * RATE.A100 / (RATE.H100 * REGISTRY.A100.pf / REGISTRY.H100.pf) - 100)}% above
          compute parity, at 5.7 years of age.
          The market repriced the A100 to its bandwidth share, not its
          compute share. That is the band's claim restated as a spread you
          can falsify: the day prior-generation prints migrate from the
          bandwidth-parity line toward the compute-parity line is the day
          the band breaks. The schedule to watch it on is the bandwidth
          frontier itself, which has moved more slowly than the compute
          frontier: the band's newest member entered at its predecessor's
          8.0 TB/s.
        </p>
      </div>
    </section>

    <!-- ======================= §03 WATT-RENT ======================= -->
