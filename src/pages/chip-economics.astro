        H100: { name: 'H100 SXM', age: '~3.7y', rate: '$3.89', n: 21, gb: '$0.0486', bw: '$1.161', pf: '$3.93', kw: '$5.56' },
        A100: { name: 'A100 80GB', age: '~5.7y', rate: '$2.08', n: 11, gb: '$0.0261', bw: '$1.042', pf: '$6.72', kw: '$5.21' }
      };
      var hero = document.getElementById('heromult');
      var heroTip = document.getElementById('hero-tip');
      if (!hero || !heroTip) return;

      function fillHeroTip(d) {
        heroTip.textContent = '';
        var head = document.createElement('strong');
        head.textContent = d.name + ' · ' + d.age;
        heroTip.appendChild(head);
        var rows = [
          ['rate', d.rate + '/GPU-hr (n=' + d.n + ')'],
          ['capacity', d.gb + '/GB-hr'],
          ['bandwidth', d.bw + '/TB/s-hr'],
          ['compute', d.pf + '/PFLOP-hr'],
          ['power', d.kw + '/kW-hr']
        ];
        rows.forEach(function (r) {
          heroTip.appendChild(document.createElement('br'));
          var lab = document.createElement('span');
          lab.className = 'tn';
          lab.textContent = r[0] + ' ';
          heroTip.appendChild(lab);
          heroTip.appendChild(document.createTextNode(r[1]));
        });
      }

      function showHero(gen, cx, cy) {
        var d = GENS[gen];
        if (!d) return;
        hero.dataset.hl = gen;
        fillHeroTip(d);
        heroTip.style.display = 'block';
        var hr = hero.getBoundingClientRect();
        var left = cx - hr.left + 14;
        var top = cy - hr.top + 14;
        if (left > hr.width - 190) left -= 210;
        if (top > hr.height - 130) top -= 140;
        heroTip.style.left = left + 'px';
        heroTip.style.top = top + 'px';
      }
      function hideHero() {
        delete hero.dataset.hl;
        heroTip.style.display = 'none';
      }

      Array.prototype.forEach.call(hero.querySelectorAll('.hit'), function (el) {
        el.addEventListener('pointermove', function (ev) {
          showHero(el.getAttribute('data-gen'), ev.clientX, ev.clientY);
        });
        el.addEventListener('pointerleave', hideHero);
        el.addEventListener('focus', function () {
          var r = el.getBoundingClientRect();
          showHero(el.getAttribute('data-gen'), r.left + r.width / 2, r.top + r.height / 2);
        });
        el.addEventListener('blur', hideHero);
      });

      /* ---------- §02 crosshair + tooltip (od-vs-committed pattern) ---------- */
      var BW = [
        { x: 109.7, gen: 'B300', v: '0.981', spec: '~8.0 TB/s', rate: '$7.85', n: 9 },
        { x: 157.6, gen: 'B200', v: '0.800', spec: '8.0 TB/s',  rate: '$6.40', n: 8 },
        { x: 213.3, gen: 'H200', v: '0.938', spec: '4.8 TB/s',  rate: '$4.50', n: 14 },
        { x: 340.8, gen: 'H100 SXM', v: '1.161', spec: '3.35 TB/s', rate: '$3.89', n: 21 },
        { x: 500.2, gen: 'A100 80GB', v: '1.042', spec: '2.0 TB/s', rate: '$2.08', n: 11 }
      ];
      var W2 = 680;
      var box = document.getElementById('bw-chart');
      var tip2 = document.getElementById('bw-tip');
      var cross = document.getElementById('bw-cross');
      if (!box || !tip2 || !cross) return;
      var svg2 = box.querySelector('svg');

      function fillBwTip(d) {
        tip2.textContent = '';
        var head = document.createElement('strong');
        head.textContent = d.gen;
        tip2.appendChild(head);
        var rows = [
          ['$/TB/s-hr ', d.v],
          ['bandwidth ', d.spec],
          ['underlying ', d.rate + '/GPU-hr'],
          ['n ', String(d.n)]
        ];
        rows.forEach(function (r) {
          tip2.appendChild(document.createElement('br'));
          var lab = document.createElement('span');
          lab.className = 'tn';
          lab.textContent = r[0];
          tip2.appendChild(lab);
          tip2.appendChild(document.createTextNode(r[1]));
        });
      }

      function showBw(ev) {
        var r = svg2.getBoundingClientRect();
        var relX = ((ev.clientX - r.left) / r.width) * W2;
        var best = BW[0], bd = Math.abs(relX - BW[0].x);
        for (var i = 1; i < BW.length; i++) {
          var d = Math.abs(relX - BW[i].x);
          if (d < bd) { bd = d; best = BW[i]; }
        }
        if (relX < 30 || relX > 560) { hideBw(); return; }
        cross.setAttribute('x1', best.x);
        cross.setAttribute('x2', best.x);
        cross.style.display = '';
        fillBwTip(best);
        tip2.style.display = 'block';
        var left = (best.x / W2) * r.width + 12;
        if (left > r.width - 170) left -= 190;
        tip2.style.left = left + 'px';
        tip2.style.top = '18px';
      }
      function hideBw() {
        tip2.style.display = 'none';
        cross.style.display = 'none';
      }
      box.addEventListener('mousemove', showBw);
      box.addEventListener('mouseleave', hideBw);
    })();
  </script>

  <style>
    .top { padding-top: 32px; padding-bottom: 40px; }
