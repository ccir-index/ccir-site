    /* sections */
    .sec { margin: 44px 0; }
    .sec h2 { font-size: var(--fs-xl); margin: 0 0 12px; display: flex; align-items: baseline; gap: 12px; }
    .sec h2 .n { font-family: var(--font-mono); font-size: var(--fs-sm); color: var(--accent); font-weight: var(--weight-strong); }
    .sec p { font-family: var(--font-body); font-size: var(--fs-md); color: var(--ink); line-height: 1.65; margin: 0 0 13px; max-width: var(--measure-wide); }
    .sec p.lede { margin-top: 18px; }
