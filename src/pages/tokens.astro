  <script is:inline define:vars={{ vvPts }}>
    // VVTI chart: direct port of the hub terminal chart (hub/terminal-v1)
    // so the two surfaces read identically at hub launch. Two-tone area
    // (green/red by window direction), 1W/1M/MAX ranges, LINE/CANDLE
    // (daily candles to 32d, weekly beyond), drag-zoom, full crosshair.
    (function () {
      const H = 340, PADL = 46, PADR = 46, PADT = 10, PADB = 24;
      const DAY = 86400000;
      const GREEN = "#2fbd6f", RED = "#e8554e";
      let W = 920, rangeDays = "max", zoom = null, ctype = "line", scaleState = null;
      const $ = (id) => document.getElementById(id);
      const svg = $("vvtichart");
      if (!svg) return;
      const sel = $("vv-selrect");
      const t = (d) => Date.parse(d + "T00:00:00Z");
      const pts0 = vvPts.map(([d, v]) => [t(d), v]);
      const MONTHS = ["JAN","FEB","MAR","APR","MAY","JUN","JUL","AUG","SEP","OCT","NOV","DEC"];
      const dlabel = (ms) => {
        const d = new Date(ms);
        return `${MONTHS[d.getUTCMonth()]} ${String(d.getUTCDate()).padStart(2, "0")}`;
      };
      const sgnp = (p, dp = 1) =>
        p == null ? "\u2014" : `${p >= 0 ? "+" : "\u2212"}${Math.abs(p).toFixed(dp)}%`;
      function windowBounds() {
        const tEnd = pts0[pts0.length - 1][0];
        if (zoom) return zoom;
        if (rangeDays === "max") return [pts0[0][0], tEnd];
        return [tEnd - rangeDays * DAY, tEnd];
      }
      function pathOf(pts, X, Y) {
        let d = "", prev = 0, first = null, lastX = null;
        pts.forEach(([x, v], i) => {
          const gap = i > 0 && (x - prev) > DAY * 1.5;
          const px = X(x), py = Y(v);
          d += `${i === 0 || gap ? "M" : "L"}${px.toFixed(1)},${py.toFixed(1)} `;
          if (first == null) first = px;
          lastX = px; prev = x;
        });
        return { d, first, lastX };
      }
      function render() {
        W = svg.clientWidth || W;
        svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
        const [t0, t1] = windowBounds();
        const pts = pts0.filter(([x]) => x >= t0 && x <= t1);
        const spanDays = (t1 - t0) / DAY;
        const xg = $("vv-xaxis"), yg = $("vv-yaxis"), gg = $("vv-gridlines");
        xg.innerHTML = ""; yg.innerHTML = ""; gg.innerHTML = "";
        $("vv-area").setAttribute("d", "");
        $("vv-candles").innerHTML = "";
        scaleState = null;
        if (pts.length >= 2) {
          let lo = Infinity, hi = -Infinity;
          pts.forEach(([, v]) => { if (v < lo) lo = v; if (v > hi) hi = v; });
          const steps = [0.05, 0.1, 0.2, 0.25, 0.5, 1, 2, 3, 5];
          const rawSpan = (hi - lo) || 1;
          const step = steps.find((st) => rawSpan / st <= 6) || steps[steps.length - 1];
          lo = Math.floor(lo / step) * step;
          hi = Math.ceil(hi / step) * step;
          const yspan = (hi - lo) || 1;
          const X = (x) => PADL + ((x - t0) / ((t1 - t0) || 1)) * (W - PADL - PADR);
          const Y = (v) => H - PADB - ((v - lo) / yspan) * (H - PADT - PADB);
          const up = pts[pts.length - 1][1] >= pts[0][1];
          const lineCol = up ? GREEN : RED;
          $("vv-line").setAttribute("stroke", lineCol);
          $("vv-area").setAttribute("fill", up ? "url(#vv-greenfade)" : "url(#vv-redfade)");
          $("vvxh-dot").style.fill = lineCol;
          const candleMode = ctype === "candle";
          if (candleMode && spanDays <= 32) {
            $("vv-line").setAttribute("d", "");
            const wPix = Math.max(2.5, (DAY / ((t1 - t0) || 1)) * (W - PADL - PADR) * 0.55);
            let html = "";
            for (let i = 1; i < pts.length; i++) {
              const x = pts[i][0], v = pts[i][1]; const pv = pts[i - 1][1];
              const col = v >= pv ? GREEN : RED;
              const cx = X(x);
              const top = Y(Math.max(v, pv)), bot = Y(Math.min(v, pv));
              html += `<rect x="${(cx - wPix / 2).toFixed(1)}" y="${top.toFixed(1)}" width="${wPix.toFixed(1)}" height="${Math.max(1, bot - top).toFixed(1)}" fill="${col}"/>`;
            }
            $("vv-candles").innerHTML = html;
          } else if (candleMode) {
            $("vv-line").setAttribute("d", "");
            const weeks = new Map();
            pts.forEach(([x, v]) => {
              const wk = Math.floor((x + 3 * DAY) / (7 * DAY));
              if (!weeks.has(wk)) weeks.set(wk, { xs: [], vs: [] });
              const w = weeks.get(wk); w.xs.push(x); w.vs.push(v);
            });
            const wPix = Math.max(3, ((7 * DAY) / ((t1 - t0) || 1)) * (W - PADL - PADR) * 0.5);
            let html = "";
            for (const w of weeks.values()) {
              const o = w.vs[0], c = w.vs[w.vs.length - 1];
              const hh = Math.max(...w.vs), ll = Math.min(...w.vs);
              const cx = X(w.xs[Math.floor(w.xs.length / 2)]);
              const col = c >= o ? GREEN : RED;
              const top = Y(Math.max(o, c)), bot = Y(Math.min(o, c));
              html += `<line x1="${cx.toFixed(1)}" x2="${cx.toFixed(1)}" y1="${Y(hh).toFixed(1)}" y2="${Y(ll).toFixed(1)}" stroke="${col}" stroke-width="1"/>` +
                `<rect x="${(cx - wPix / 2).toFixed(1)}" y="${top.toFixed(1)}" width="${wPix.toFixed(1)}" height="${Math.max(1, bot - top).toFixed(1)}" fill="${col}"/>`;
            }
            $("vv-candles").innerHTML = html;
          } else {
            const main = pathOf(pts, X, Y);
            $("vv-line").setAttribute("d", main.d);
            if (main.d) {
              $("vv-area").setAttribute("d",
                `${main.d}L${main.lastX.toFixed(1)},${H - PADB} L${main.first.toFixed(1)},${H - PADB} Z`);
            }
          }
          scaleState = { pts, X, Y, base: pts[0][1] };
          for (let v = lo; v <= hi + step / 2; v += step) {
            const y = Y(v);
            const lbl = "$" + v.toFixed(2);
            yg.insertAdjacentHTML("beforeend",
              `<text x="2" y="${(y + 3).toFixed(1)}">${lbl}</text>` +
              `<text x="${W - 2}" y="${(y + 3).toFixed(1)}" text-anchor="end">${lbl}</text>`);
            gg.insertAdjacentHTML("beforeend",
              `<line x1="${PADL}" x2="${W - PADR}" y1="${y.toFixed(1)}" y2="${y.toFixed(1)}"/>`);
          }
          const span = t1 - t0;
          const ticks = [];
          if (spanDays <= 35) {
            for (let x = t0; x <= t1 + DAY / 2; x += 7 * DAY) ticks.push(Math.min(x, t1));
          } else {
            for (let i = 0; i <= 6; i++) ticks.push(t0 + (span * i) / 6);
          }
          ticks.forEach((x, i) => {
            const px = X(x);
            const anchor = i === 0 ? "start" : i === ticks.length - 1 ? "end" : "middle";
            xg.insertAdjacentHTML("beforeend",
              `<text x="${px.toFixed(1)}" y="${H - 8}" text-anchor="${anchor}">${dlabel(x)}</text>`);
            if (i > 0 && i < ticks.length - 1) {
              gg.insertAdjacentHTML("beforeend",
                `<line x1="${px.toFixed(1)}" x2="${px.toFixed(1)}" y1="${PADT}" y2="${H - PADB}"/>`);
            }
          });
          const winLbl = zoom ? `${dlabel(t0)}\u2013${dlabel(t1)}`
            : (rangeDays === "max" ? "MAX" : { 7: "1W", 30: "1M" }[rangeDays]);
          const vs2 = pts.map((p) => p[1]);
          const wchg = 100 * (vs2[vs2.length - 1] / vs2[0] - 1);
          $("vvti-winlbl").textContent = winLbl +
            (ctype === "candle" ? (spanDays <= 32 ? " \u00b7 DAILY CANDLES" : " \u00b7 WEEKLY CANDLES") : "");
          $("vvti-price").textContent = `$${vs2[vs2.length - 1].toFixed(2)}`;
          const ch = $("vvti-chg");
          ch.textContent = sgnp(wchg, Math.abs(wchg) >= 100 ? 0 : 1);
          ch.style.color = wchg >= 0 ? GREEN : RED;
          $("vvti-since").textContent = zoom
            ? `${dlabel(t0)} \u2192 ${dlabel(t1)}`
            : (rangeDays === "max" ? "since " + new Date(pts[0][0]).toISOString().slice(0, 10)
               : `${winLbl} window`);
        } else {
          $("vv-line").setAttribute("d", "");
        }
        $("vv-xhair").style.display = "none";
        document.querySelectorAll("#vvti-range-tabs [data-range]").forEach((b) =>
          b.classList.toggle("on", !zoom && String(rangeDays) === b.dataset.range));
        document.querySelectorAll("#vvti-type-tabs button").forEach((b) =>
          b.classList.toggle("on", b.dataset.type === ctype));
      }
      let dragX = null;
      function moveCrosshair(px) {
        if (!scaleState) { $("vv-xhair").style.display = "none"; return; }
        const pts = scaleState.pts, X = scaleState.X, Y = scaleState.Y;
        let best = pts[0], bd = Infinity;
        for (const pt of pts) {
          const d = Math.abs(X(pt[0]) - px);
          if (d < bd) { bd = d; best = pt; }
        }
        const sx = X(best[0]), sy = Y(best[1]);
        $("vvxh-v").setAttribute("x1", sx); $("vvxh-v").setAttribute("x2", sx);
        $("vvxh-h").setAttribute("x1", PADL); $("vvxh-h").setAttribute("x2", W - PADR);
        $("vvxh-h").setAttribute("y1", sy); $("vvxh-h").setAttribute("y2", sy);
        $("vvxh-dot").setAttribute("cx", sx); $("vvxh-dot").setAttribute("cy", sy);
        const bx = sx + 12 + 140 > W - PADR ? sx - 152 : sx + 12;
        const by = Math.max(PADT, Math.min(sy - 15, H - PADB - 32));
        $("vvxh-box").setAttribute("x", bx); $("vvxh-box").setAttribute("y", by);
        $("vvxh-val").setAttribute("x", bx + 8); $("vvxh-val").setAttribute("y", by + 13);
        const chg = scaleState.base > 0 ? 100 * (best[1] / scaleState.base - 1) : null;
        $("vvxh-val").textContent = `$${best[1].toFixed(2)}  ${sgnp(chg, 1)}`;
        $("vvxh-date").setAttribute("x", bx + 8); $("vvxh-date").setAttribute("y", by + 25);
        $("vvxh-date").textContent = dlabel(best[0]);
        $("vvxh-ychip").setAttribute("x", W - 44); $("vvxh-ychip").setAttribute("y", sy - 7);
        $("vvxh-yval").setAttribute("x", W - 40); $("vvxh-yval").setAttribute("y", sy + 4);
        $("vvxh-yval").textContent = best[1].toFixed(2);
        const xcx = Math.max(PADL, Math.min(sx - 29, W - PADR - 58));
        $("vvxh-xchip").setAttribute("x", xcx); $("vvxh-xchip").setAttribute("y", H - PADB + 4);
        $("vvxh-xval").setAttribute("x", xcx + 6); $("vvxh-xval").setAttribute("y", H - PADB + 15);
        $("vvxh-xval").textContent = dlabel(best[0]);
        $("vv-xhair").style.display = "";
      }
      const frac = (evt) => {
        const r = svg.getBoundingClientRect();
        return Math.max(0, Math.min(W, ((evt.clientX - r.left) / r.width) * W));
      };
      svg.addEventListener("pointerdown", (e) => { dragX = frac(e); svg.setPointerCapture(e.pointerId); });
      svg.addEventListener("pointermove", (e) => {
        const x = frac(e);
        if (dragX == null) { moveCrosshair(x); return; }
        $("vv-xhair").style.display = "none";
        sel.style.display = "";
        sel.setAttribute("x", Math.min(dragX, x));
        sel.setAttribute("width", Math.abs(x - dragX));
      });
      svg.addEventListener("pointerleave", () => { $("vv-xhair").style.display = "none"; });
      svg.addEventListener("pointerup", (e) => {
        if (dragX == null) return;
        const x = frac(e);
        sel.style.display = "none";
        if (Math.abs(x - dragX) > 12) {
          const bounds = windowBounds();
          const span = bounds[1] - bounds[0];
          const f = (px) => bounds[0] + span * Math.max(0, Math.min(1, (px - PADL) / (W - PADL - PADR)));
          const a = f(Math.min(dragX, x)), b = f(Math.max(dragX, x));
          if (b - a >= 3 * DAY) zoom = [a, b];
        }
        dragX = null;
        render();
      });
      svg.addEventListener("dblclick", () => { zoom = null; render(); });
      document.querySelectorAll("#vvti-range-tabs [data-range]").forEach((b) =>
        b.addEventListener("click", () => {
          rangeDays = b.dataset.range === "max" ? "max" : parseInt(b.dataset.range);
          zoom = null; render();
        }));
      document.getElementById("vvti-type-tabs").addEventListener("click", (e) => {
        if (e.target.dataset.type) { ctype = e.target.dataset.type; render(); }
      });
      window.addEventListener("resize", render);
      render();
    })();
  </script>

  <script is:inline>
    // Click-to-sort for the open-weight table. Numeric columns parse the
    // first number in the cell ("$0.55", "12", "$0.19 – $0.99" → its min);
    // first click sorts numeric columns descending, text ascending.
    (() => {
      const tbl = document.getElementById('served-tbl');
      if (!tbl) return;
      const tbody = tbl.tBodies[0];
      const num = (s) => {
        const m = s.replace(/[$,]/g, '').match(/-?\d+(?:\.\d+)?/);
        return m ? parseFloat(m[0]) : -Infinity;
      };
      tbl.querySelectorAll('th').forEach((th, i) => {
        th.addEventListener('click', () => {
          const numeric = th.dataset.t === 'n';
          const first = numeric ? 'descending' : 'ascending';
          const dir = th.getAttribute('aria-sort') === first
            ? (first === 'descending' ? 'ascending' : 'descending')
            : first;
          tbl.querySelectorAll('th').forEach((h) => h.removeAttribute('aria-sort'));
          th.setAttribute('aria-sort', dir);
          const sign = dir === 'ascending' ? 1 : -1;
          [...tbody.rows]
            .sort((a, b) => {
              const av = a.cells[i].textContent.trim();
              const bv = b.cells[i].textContent.trim();
              return sign * (numeric ? num(av) - num(bv) : av.localeCompare(bv));
            })
            .forEach((r) => tbody.appendChild(r));
        });
      });
    })();
  </script>

  <section class="wrap method">
    <details>
      <summary class="mono">Method</summary>
      <ul>
        <li>USD per 1 million tokens, as posted. Record runs from {windowStart}.</li>
        <li>Posted rows come from the model owners' own price lists, captured
          daily; a reprice appears on the day the list changed.</li>
        <li>Served rows are medians across independent providers of the same
          open-weight model, published at n ≥ 3.</li>
        <li>The two are never pooled. A posted price and a cross-provider
          median answer different questions.</li>
        <li>The VVTI weights each posted output price by its model&rsquo;s daily
          share of Vercel AI Gateway token volume (CC BY 4.0, attributed above),
          renormalized over the priced set with coverage disclosed.</li>
        <li>Token prices are not evidence about GPU rental rates. The link
          between them is serving efficiency, a vendor variable rather than a
          market price. CCIR publishes the GPU-hour record separately.</li>
      </ul>
    </details>
  </section>
</Base>

<style>
  .wrap { max-width: 1060px; margin: 0 auto; padding: 0 20px; }
  .top { padding-top: 40px; }
