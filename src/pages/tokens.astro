---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import LabMark from '../components/LabMark.astro';
import {
  frontier, served, frontierDays, frontierLatestDay,
  frontierLatest, frontierSeries, lastReprice, modelsTracked, canonicalModelId,
  familyKey, cmpVersion,
} from '../data/tokens';

/*
  /tokens — posted token prices, two constructions, never blended.
  Section 01: frontier first-party posted (model owners' own docs).
  Section 02: open-weight models by serving breadth (cross-provider medians).
*/

const latest = frontierLatest();

/*
  Section 01 is built FROM THE DATA, one block per provider present in the
  latest day — not from a hardcoded pair. It used to render OpenAI and
  Anthropic only, so DeepSeek and Moonshot were captured, exported, synced
  and then never shown; the wave-4 sweep would have added eight more labs
  behind the same wall.

  Nothing here names a model. Every block is one row per model LINE — the
  newest member of each family the lab currently sells — so a new model, or a
  whole new lab, appears without a site change. That is the point: the
  hand-maintained lists this replaced had already gone stale (Claude Mythos 5
  was captured for two days and never shown).
*/
const PROVIDER_ORDER = ['openai', 'anthropic', 'google', 'deepseek', 'moonshot',
                        'xai', 'meta', 'alibaba', 'zai', 'minimax', 'mistral',
                        'thinkingmachines', 'xiaomi'];

const PROVIDER_META: Record<string, { label: string; note?: string }> = {
  openai: { label: 'OpenAI', note: 'standard tier' },
  anthropic: { label: 'Anthropic', note: 'model table' },
  google: { label: 'Google', note: 'standard tier' },
  deepseek: { label: 'DeepSeek', note: 'standard price' },
  moonshot: { label: 'Moonshot', note: 'per-model pages' },
  xai: { label: 'xAI', note: 'model catalogue' },
  meta: { label: 'Meta', note: 'standard tier' },
  alibaba: { label: 'Alibaba', note: 'international storefront' },
  zai: { label: 'Z.AI', note: 'model table' },
  minimax: { label: 'MiniMax', note: 'standard tier' },
  mistral: { label: 'Mistral', note: 'API price list' },
  thinkingmachines: { label: 'Thinking Machines', note: 'serverless inference' },
  xiaomi: { label: 'Xiaomi', note: 'overseas price list' },
};

const DISPLAY_OVERRIDES: Record<string, string> = {
  'Claude Sonnet 5 through August 31, 2026': 'Claude Sonnet 5',
};

// Rows the vendor still posts but no longer sells; they stay in the CSV as
// record and off the page. Date-scoped FUTURE rows are excluded here too —
// Sonnet 5's September step is called out in its own note below.
const RETIRED_RE = /retired|deprecated|legacy|starting \w+ \d/i;

interface TableRow {
  id: string; name: string; input: number | null; cached: number | null;
  output: number | null; reprice: { date: string; prevInput: number | null; prevOutput: number | null } | null;
}
function frontierRow(id: string): TableRow | null {
  const r = latest.get(id);
  if (!r) return null;
  return {
    id,
    name: DISPLAY_OVERRIDES[id] ?? id,
    input: r.input, cached: r.cached_input, output: r.output,
    reprice: lastReprice(id),
  };
}
/*
  One block per provider that published on the latest day, in PROVIDER_ORDER,
  with anything unrecognised appended alphabetically — so a lab added to the
  pipeline shows up here without a site change.
*/
const providerBlocks = (() => {
  const byProvider = new Map<string, typeof frontier>();
  for (const r of latest.values()) {
    if (!byProvider.has(r.provider)) byProvider.set(r.provider, []);
    byProvider.get(r.provider)!.push(r);
  }
  const seen = [...byProvider.keys()];
  const ordered = [
    ...PROVIDER_ORDER.filter((p) => byProvider.has(p)),
    ...seen.filter((p) => !PROVIDER_ORDER.includes(p)).sort(),
  ];
  return ordered.map((provider) => {
    const cfg = PROVIDER_META[provider] ?? { label: provider };
    const pool = byProvider.get(provider)!
      // Vendor-labelled legacy first: what a lab calls legacy stays in the
      // record and off the page. RETIRED_RE still catches labs that annotate
      // in the display name rather than in axes.
      .filter((r) => r.lifecycle !== 'legacy')
      .filter((r) => !RETIRED_RE.test(r.model_display || r.model_id));
    // ONE ROW PER MODEL LINE — the newest member of each family.
    //
    // No cap and no hand-maintained lists: a lab's block is however many
    // lines it currently sells. The lists this replaces were already stale —
    // Claude Mythos 5 ($10/$50) was captured for two days and never shown,
    // because it shipped after someone last edited the array.
    //
    // Family, not rank alone: labs disagree about what "first" means.
    // Anthropic groups by family (Opus 5, 4.8, 4.7 … all before the first
    // Sonnet), so a top-N showed six historical Opus versions and no Sonnet.
    // OpenAI's o-series runs OLDEST-first, so first-listed picked o1 over
    // o4-mini. Highest version within a family handles both.
    const best = new Map<string, typeof pool[number]>();
    for (const r of pool) {
      const f = familyKey(r.model_id) || r.model_id;
      const cur = best.get(f);
      if (!cur || cmpVersion(r.model_id, cur.model_id) > 0) best.set(f, r);
    }
    // Families appear in the vendor's own order where we have it; before the
    // first ranked snapshot, dearest-first — which changes the ORDER of the
    // lines, never WHICH line represents a family.
    const haveRank = pool.some((r) => r.source_rank != null);
    const rows = [...best.entries()]
      .sort((a, b) => (haveRank
        ? (a[1].source_rank ?? Infinity) - (b[1].source_rank ?? Infinity)
        : (b[1].output ?? 0) - (a[1].output ?? 0)))
      .map(([, r]) => frontierRow(r.model_id))
      .filter(Boolean) as TableRow[];
    return { provider, label: cfg.label, note: cfg.note, rows };
  }).filter((b) => b.rows.length > 0);
})();

// Sonnet-5's scheduled reprice (date-scoped row on Anthropic's page).
const sonnetSep = latest.get('Claude Sonnet 5 starting September 1, 2026');

const fmt = (v: number | null, dp = 2) => (v == null ? '—' : `$${v.toFixed(dp)}`);

// 30-day output-price sparkline per model (stepped, min-max normalized;
// models younger than 30 days render their full record).
const SPARK_W = 88, SPARK_H = 20;
function spark(modelId: string): { path: string; flat: boolean } | null {
  const cut = frontierDays.slice(-30);
  const pts = frontierSeries(modelId)
    .filter((r) => r.output != null && cut.includes(r.as_of_date))
    .map((r) => r.output as number);
  if (pts.length < 2) return null;
  const lo = Math.min(...pts), hi = Math.max(...pts);
  const flat = hi === lo;
  const y = (v: number) => flat
    ? SPARK_H / 2
    : 2 + (1 - (v - lo) / (hi - lo)) * (SPARK_H - 4);
  const x = (i: number) => (i / (pts.length - 1)) * SPARK_W;
  let d = `M 0 ${y(pts[0]).toFixed(1)}`;
  for (let i = 1; i < pts.length; i++) {
    d += ` L ${x(i).toFixed(1)} ${y(pts[i - 1]).toFixed(1)}`
       + ` L ${x(i).toFixed(1)} ${y(pts[i]).toFixed(1)}`;
  }
  return { path: d, flat };
}
const pct = (now: number | null, prev: number | null) =>
  now != null && prev != null && prev !== 0
    ? `${(((now - prev) / prev) * 100).toFixed(0)}%` : null;

// ---------------------------------------------------------------------------
// Chart: gpt-5.6 tier output prices (log scale) across the record window.
// The 2026-07-30 reprice is the exhibit: Luna −80%, Terra −20%, Sol held.
// ---------------------------------------------------------------------------
const TIERS = [
  { id: 'gpt-5.6-sol',   label: 'sol',   color: 'var(--tok-c1)' },
  { id: 'gpt-5.6-terra', label: 'terra', color: 'var(--tok-c2)' },
  { id: 'gpt-5.6-luna',  label: 'luna',  color: 'var(--tok-c3)' },
];
const tierSeries = TIERS.map((t) => ({
  ...t,
  pts: frontierSeries(t.id)
    .filter((r) => r.output != null)
    .map((r) => ({ d: r.as_of_date, v: r.output as number })),
}));
const chartDays = frontierDays.filter((d) =>
  tierSeries.some((s) => s.pts.some((p) => p.d === d)));
// PAD_R sized for the longest right-edge series label ("terra $12" at 11px
// mono ≈ 62px past the +6 offset) — labels must fit inside the viewBox.
const W = 640, H = 230, PAD_L = 44, PAD_R = 78, PAD_T = 14, PAD_B = 26;
const xFor = (d: string) => {
  const i = chartDays.indexOf(d);
  return PAD_L + (i / Math.max(1, chartDays.length - 1)) * (W - PAD_L - PAD_R);
};
const LOG_MIN = Math.log10(1), LOG_MAX = Math.log10(40);
const yFor = (v: number) =>
  PAD_T + (1 - (Math.log10(v) - LOG_MIN) / (LOG_MAX - LOG_MIN)) * (H - PAD_T - PAD_B);
function stepPath(pts: { d: string; v: number }[]): string {
  if (!pts.length) return '';
  let p = `M ${xFor(pts[0].d).toFixed(1)} ${yFor(pts[0].v).toFixed(1)}`;
  for (let i = 1; i < pts.length; i++) {
    const x = xFor(pts[i].d), yPrev = yFor(pts[i - 1].v), y = yFor(pts[i].v);
    p += ` L ${x.toFixed(1)} ${yPrev.toFixed(1)} L ${x.toFixed(1)} ${y.toFixed(1)}`;
  }
  return p;
}
const yTicks = [1, 2, 5, 10, 30];
const xTickDays = chartDays.filter((_, i) =>
  i === 0 || i === chartDays.length - 1 || i === Math.floor(chartDays.length / 2));

// ---------------------------------------------------------------------------
// Open-weight serving table: breadth-sorted, most relevant.
// ---------------------------------------------------------------------------
const servedRows = [...served]
  .filter((r) => (r.n_providers ?? 0) >= 3)
  .sort((a, b) => (b.n_providers - a.n_providers)
    || Number(b.in_basket) - Number(a.in_basket)
    || (b.output_median ?? 0) - (a.output_median ?? 0))
  .slice(0, 16);
const servedAsOf = served[0]?.as_of_date ?? frontierLatestDay;

/*
  Models carried by BOTH constructions — an open-weight model whose owner also
  posts a price. They appear once in each section at numbers that can differ
  sharply (on 2026-08-06 DeepSeek V4 Pro posted $0.87 out while the median of
  four independent hosts was $2.90). That gap is the point of keeping the two
  apart, but on one page it can read as a contradiction, so the sharpest
  current example is named below.

  Picked by widest relative gap so the note tracks the data rather than
  freezing an example. Both figures are printed as-is; the ratio between them
  is deliberately NOT computed — the two are different constructions, and a
  derived multiple would invite reading them as one series.
*/
const crossListed = (() => {
  const postedByCanon = new Map<string, { name: string; output: number }>();
  for (const r of latest.values()) {
    if (r.output == null) continue;
    const c = canonicalModelId(r.model_id);
    if (c && !postedByCanon.has(c)) {
      postedByCanon.set(c, { name: r.model_display || r.model_id, output: r.output });
    }
  }
  const both = servedRows
    .map((s) => {
      const p = postedByCanon.get(canonicalModelId(s.model_id));
      if (!p || s.output_median == null || p.output <= 0) return null;
      return {
        name: p.name, posted: p.output, served: s.output_median,
        gap: Math.abs(s.output_median - p.output) / p.output,
      };
    })
    .filter(Boolean) as { name: string; posted: number; served: number; gap: number }[];
  both.sort((a, b) => b.gap - a.gap);
  // only worth a note when a gap is actually material
  return { count: both.length, widest: both[0]?.gap >= 0.1 ? both[0] : null };
})();

// ---------------------------------------------------------------------------
// Cross-model input/output comparison (grouped bars). Two constructions on
// one canvas, visually distinguished, NEVER pooled: first-party posted bars
// are solid; served-median bars are hatched and carry their n. Curated to
// the flagship rung of each family we track.
// ---------------------------------------------------------------------------
// Each pick prefers a FIRST-PARTY posted row when the record carries one
// (matched by pattern so a vendor's own id spelling doesn't need hardcoding)
// and falls back to the served median otherwise. When a vendor's own price
// list enters the record, its bar upgrades construction automatically and
// the n label drops, because the row is no longer a median.
const CMP_PICKS: {
  frontierMatch?: RegExp; servedId?: string;
  l1: string; l2: string; fl1?: string; fl2?: string;
}[] = [
  { frontierMatch: /^deepseek-v4-flash$/i, servedId: 'deepseekv4flash',
    l1: 'DeepSeek', l2: 'V4 Flash' },
  { frontierMatch: /qwen.*(3\.8|max)/i, servedId: 'qwen3coder480ba35binstruct',
    l1: 'Qwen3 Coder', l2: '480B' },
  { frontierMatch: /^kimi-k3$/i, servedId: 'kimik2thinking',
    l1: 'Kimi K2', l2: 'Thinking', fl1: 'Moonshot', fl2: 'Kimi K3' },
  { frontierMatch: /^gpt-5\.6-sol$/i,     l1: 'OpenAI',    l2: 'GPT-5.6 Sol' },
  { frontierMatch: /^Claude Opus 5$/i,    l1: 'Anthropic', l2: 'Opus 5' },
  { frontierMatch: /^Claude Fable 5$/i,   l1: 'Anthropic', l2: 'Fable 5' },
];
interface CmpBar {
  l1: string; l2: string; input: number; output: number;
  servedN: number | null;  // null = first-party posted
}
const cmpBars: CmpBar[] = CMP_PICKS.flatMap((p) => {
  if (p.frontierMatch) {
    const hit = [...latest.values()].find(
      (r) => p.frontierMatch!.test(r.model_id) && r.input != null && r.output != null);
    if (hit) {
      return [{ l1: p.fl1 ?? p.l1, l2: p.fl2 ?? p.l2, input: hit.input as number,
                output: hit.output as number, servedN: null }];
    }
  }
  const r = p.servedId ? served.find((s) => s.model_id === p.servedId) : undefined;
  return r && r.input_median != null && r.output_median != null
    ? [{ l1: p.l1, l2: p.l2, input: r.input_median, output: r.output_median,
         servedN: r.n_providers }]
    : [];
}).sort((a, b) => a.output - b.output);

const CW = 640, CH = 260, CPAD_L = 40, CPAD_R = 8, CPAD_T = 20, CPAD_B = 36;
const cmpMax = Math.max(1, ...cmpBars.map((b) => b.output)) * 1.06;
const cy = (v: number) =>
  Math.round((CPAD_T + (1 - v / cmpMax) * (CH - CPAD_T - CPAD_B)) * 10) / 10;
const cmpTicks = [0, 10, 20, 30, 40, 50].filter((t) => t <= cmpMax);
const GRP_W = (CW - CPAD_L - CPAD_R) / Math.max(1, cmpBars.length);
const BAR_W = 26, BAR_GAP = 2;
const fmtV = (v: number) => (v >= 10 ? `$${Math.round(v)}` : `$${v.toFixed(2)}`);

const windowStart = frontierDays[0] ?? '2026-07-03';

/*
  Section 00: CCIR Vercel Volume Token Index (VVTI), pilot. Weights are
  Vercel AI Gateway daily token shares (CC BY 4.0 export); prices are this
  page's posted first-party record. Renormalized daily over the priced set;
  coverage disclosed. Series built by scratch prototype pending the
  production build (bronze-sourced weights on a disclosed re-fix schedule).
*/
import vvtiData from '../data/vvti_daily.json';
const vv = vvtiData.series as { date: string; vvti: number; open_avg: number; coverage: number }[];
const vvLast = vv[vv.length - 1];
const vvFirst = vv[0];
const vvChg = Math.round(100 * (vvLast.vvti / vvFirst.vvti - 1));
const vvCovLo = Math.round(Math.min(...vv.map((p) => p.coverage)));
const vvCovHi = Math.round(Math.max(...vv.map((p) => p.coverage)));
const vvPts = vv.map((p) => [p.date, p.vvti]);
---
<Base
  title="Token Index (VVTI) & Token Prices — GPT-5.6, Claude & Open-Weight Models · CCIR"
  description="The CCIR Vercel Volume Token Index (VVTI), the volume-weighted posted price of an output token on Vercel AI Gateway traffic shares, plus the daily record of posted token prices from model owners' own price lists — OpenAI, Anthropic, Google, DeepSeek, Moonshot, xAI, Meta, Alibaba, Z.AI, MiniMax, Mistral and more — plus cross-provider medians for open-weight models served by three or more independent providers. USD per 1M tokens."
  ogImage="/og/tokenindex.png"
>
  <section class="wrap page-top">
    <PageHeader
      title="Token Index & Prices"
      kicker={`VVTI pilot · Benchmark record · USD per 1M tokens${modelsTracked > 0 ? ` · ${modelsTracked} models` : ''}`}
      asOf={servedAsOf}
    />
  </section>

  <section class="wrap">
    <div class="chart-block lead-chart">
      <div class="vvti-head">
        <h2 class="vvti-name">CCIR Vercel Volume Token Index <span class="dim">(VVTI, pilot)</span></h2>
        <div class="vvti-print mono">
          <span id="vvti-price">${vvLast.vvti.toFixed(2)}</span>
          <span class="vvti-chg" id="vvti-chg">{vvChg}%</span>
          <span class="dim" id="vvti-since">since {vvFirst.date}</span>
        </div>
      </div>
      <div class="chart-title mono">
        volume-weighted posted price of an output token · USD per 1M ·
        <span id="vvti-winlbl">MAX</span>
      </div>
      <div class="vvti-chart-box">
        <svg class="vvti-chart" id="vvtichart" viewBox="0 0 920 340">
          <defs>
            <linearGradient id="vv-greenfade" x1="0" x2="0" y1="0" y2="1">
              <stop offset="0%" stop-color="#2fbd6f" stop-opacity="0.20" />
              <stop offset="100%" stop-color="#2fbd6f" stop-opacity="0" />
            </linearGradient>
            <linearGradient id="vv-redfade" x1="0" x2="0" y1="0" y2="1">
              <stop offset="0%" stop-color="#e8554e" stop-opacity="0.20" />
              <stop offset="100%" stop-color="#e8554e" stop-opacity="0" />
            </linearGradient>
          </defs>
          <g class="vv-gridlines" id="vv-gridlines"></g>
          <path id="vv-area" />
          <path id="vv-line" fill="none" stroke="var(--tok-c3)" stroke-width="1.8" />
          <g id="vv-candles"></g>
          <g class="vv-axis" id="vv-xaxis"></g>
          <g class="vv-axis" id="vv-yaxis"></g>
          <rect id="vv-selrect" class="vv-selrect" style="display:none" y="0" height="316" />
          <g id="vv-xhair" style="display:none" pointer-events="none">
            <line id="vvxh-v" y1="10" y2="316" />
            <line id="vvxh-h" x1="46" x2="874" />
            <circle id="vvxh-dot" r="3.5" />
            <rect id="vvxh-box" width="140" height="30" rx="2" />
            <text id="vvxh-val" font-weight="600" />
            <text id="vvxh-date" class="dim" />
            <rect id="vvxh-ychip" width="44" height="14" rx="2" />
            <text id="vvxh-yval" />
            <rect id="vvxh-xchip" width="58" height="14" rx="2" />
            <text id="vvxh-xval" />
          </g>
        </svg>
      </div>
      <div class="vv-rangerow">
        <span class="vv-tabs" id="vvti-type-tabs">
          <button data-type="line" class="on">LINE</button>
          <button data-type="candle">CANDLE</button>
        </span>
        <span class="vv-tabs" id="vvti-range-tabs">
          <button data-range="7">1W</button>
          <button data-range="30">1M</button>
          <button data-range="max" class="on">MAX</button>
        </span>
      </div>
      <div class="vv-chrome mono">drag to zoom · double-click to reset</div>
      <details class="method-disclosure">
        <summary>Construction &amp; source</summary>
        <div class="disclosure-body">
          <p>
            VVTI is the volume-weighted average of posted output-token prices:
            Vercel AI Gateway daily token shares
            (<a href="https://vercel.com/docs/ai-gateway/leaderboards" rel="noopener">&ldquo;AI
            Gateway Leaderboard Data&rdquo;</a>, CC BY 4.0) multiplied by the posted
            first-party prices recorded on this page, renormalized daily over the
            priced set. {vvCovLo}&ndash;{vvCovHi}% of gateway volume is priced across
            the window; the remainder sits in the leaderboard&rsquo;s own
            &ldquo;Other&rdquo; bucket. CCIR calculation; Vercel publishes shares
            only. Pilot series: weights re-fix daily while the banded-weight
            construction is finalized.
          </p>
        </div>
      </details>
    </div>
  </section>

  <section class="wrap">
    {cmpBars.length >= 3 && (
      <div class="chart-block lead-chart">
        <div class="chart-title mono">
          posted price by model · input &amp; output · USD per 1M tokens · {servedAsOf}
        </div>
        <div class="cmp-legend mono">
          <span><span class="sw sw-in"></span> input</span>
          <span><span class="sw sw-out"></span> output</span>
        </div>
        <svg viewBox={`0 0 ${CW} ${CH}`} role="img"
          aria-label="Grouped bar chart comparing posted input and output prices per million tokens across models.">
          <defs>
            <pattern id="tok-hatch-in" width="5" height="5" patternUnits="userSpaceOnUse"
              patternTransform="rotate(45)">
              <rect width="5" height="5" fill="var(--tok-c1)" opacity="0.32" />
              <line x1="0" y1="0" x2="0" y2="5" stroke="var(--tok-c1)" stroke-width="2.2" />
            </pattern>
            <pattern id="tok-hatch-out" width="5" height="5" patternUnits="userSpaceOnUse"
              patternTransform="rotate(45)">
              <rect width="5" height="5" fill="var(--tok-c3)" opacity="0.32" />
              <line x1="0" y1="0" x2="0" y2="5" stroke="var(--tok-c3)" stroke-width="2.2" />
            </pattern>
          </defs>
          {cmpTicks.map((t) => (
            <>
              <line x1={CPAD_L} x2={CW - CPAD_R} y1={cy(t)} y2={cy(t)} class="grid" />
              <text x={CPAD_L - 6} y={cy(t) + 3} class="tick" text-anchor="end">${t}</text>
            </>
          ))}
          {cmpBars.map((b, i) => {
            const cx0 = CPAD_L + i * GRP_W + GRP_W / 2;
            const xIn = cx0 - BAR_W - BAR_GAP / 2;
            const xOut = cx0 + BAR_GAP / 2;
            const y0 = cy(0);
            const con = b.servedN != null
              ? `served median, n=${b.servedN} providers` : 'first-party posted';
            return (
              <>
                <rect x={xIn} width={BAR_W} y={cy(b.input)}
                  height={Math.max(1.5, y0 - cy(b.input))}
                  fill={b.servedN != null ? 'url(#tok-hatch-in)' : 'var(--tok-c1)'}>
                  <title>{`${b.l1} ${b.l2} — input ${fmtV(b.input)} per 1M tokens (${con})`}</title>
                </rect>
                <rect x={xOut} width={BAR_W} y={cy(b.output)}
                  height={Math.max(1.5, y0 - cy(b.output))}
                  fill={b.servedN != null ? 'url(#tok-hatch-out)' : 'var(--tok-c3)'}>
                  <title>{`${b.l1} ${b.l2} — output ${fmtV(b.output)} per 1M tokens (${con})`}</title>
                </rect>
                <text x={xIn + BAR_W / 2} y={cy(b.input) - 4} class="vlab"
                  text-anchor="middle">{fmtV(b.input)}</text>
                <text x={xOut + BAR_W / 2} y={cy(b.output) - 4} class="vlab"
                  text-anchor="middle">{fmtV(b.output)}</text>
                <text x={cx0} y={CH - 22} class="tick" text-anchor="middle">{b.l1}</text>
                <text x={cx0} y={CH - 11} class="tick" text-anchor="middle">
                  {b.l2}{b.servedN != null ? ` · n=${b.servedN}` : ''}
                </text>
              </>
            );
          })}
          <line x1={CPAD_L} x2={CW - CPAD_R} y1={cy(0)} y2={cy(0)} class="axis" />
