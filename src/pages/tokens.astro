---
import Base from '../layouts/Base.astro';
import {
  frontier, served, frontierDays, frontierLatestDay,
  frontierLatest, frontierSeries, lastReprice, modelsTracked,
} from '../data/tokens';

/*
  /tokens — posted token prices, two constructions, never blended.
  Section 01: frontier first-party posted (model owners' own docs).
  Section 02: open-weight models by serving breadth (cross-provider medians).
*/

const latest = frontierLatest();

// Most-relevant curation (current commercial models; retired/deprecated and
// date-scoped future rows stay in the CSV, not on the page).
const OPENAI_MODELS = ['gpt-5.6-sol', 'gpt-5.6-terra', 'gpt-5.6-luna', 'gpt-5.5', 'gpt-5.5-pro'];
const ANTHROPIC_MODELS = [
  'Claude Fable 5', 'Claude Opus 5',
  'Claude Sonnet 5 through August 31, 2026', 'Claude Haiku 4.5',
];
const DISPLAY_OVERRIDES: Record<string, string> = {
  'Claude Sonnet 5 through August 31, 2026': 'Claude Sonnet 5',
};

interface TableRow {
  id: string; name: string; input: number | null; cached: number | null;
  output: number | null; reprice: { date: string; prevInput: number | null; prevOutput: number | null } | null;
}
function frontierRow(id: string): TableRow | null {
  const r = latest.get(id);
  if (!r) return null;
  return {
    id,
    name: DISPLAY_OVERRIDES[id] ?? id,
    input: r.input, cached: r.cached_input, output: r.output,
    reprice: lastReprice(id),
  };
}
const openaiRows = OPENAI_MODELS.map(frontierRow).filter(Boolean) as TableRow[];
const anthropicRows = ANTHROPIC_MODELS.map(frontierRow).filter(Boolean) as TableRow[];

// Sonnet-5's scheduled reprice (date-scoped row on Anthropic's page).
const sonnetSep = latest.get('Claude Sonnet 5 starting September 1, 2026');

const fmt = (v: number | null, dp = 2) => (v == null ? '—' : `$${v.toFixed(dp)}`);

// 30-day output-price sparkline per model (stepped, min-max normalized;
// models younger than 30 days render their full record).
const SPARK_W = 88, SPARK_H = 20;
function spark(modelId: string): { path: string; flat: boolean } | null {
  const cut = frontierDays.slice(-30);
  const pts = frontierSeries(modelId)
    .filter((r) => r.output != null && cut.includes(r.as_of_date))
    .map((r) => r.output as number);
  if (pts.length < 2) return null;
  const lo = Math.min(...pts), hi = Math.max(...pts);
  const flat = hi === lo;
  const y = (v: number) => flat
    ? SPARK_H / 2
    : 2 + (1 - (v - lo) / (hi - lo)) * (SPARK_H - 4);
  const x = (i: number) => (i / (pts.length - 1)) * SPARK_W;
  let d = `M 0 ${y(pts[0]).toFixed(1)}`;
  for (let i = 1; i < pts.length; i++) {
    d += ` L ${x(i).toFixed(1)} ${y(pts[i - 1]).toFixed(1)}`
       + ` L ${x(i).toFixed(1)} ${y(pts[i]).toFixed(1)}`;
  }
  return { path: d, flat };
}
const pct = (now: number | null, prev: number | null) =>
  now != null && prev != null && prev !== 0
    ? `${(((now - prev) / prev) * 100).toFixed(0)}%` : null;

// ---------------------------------------------------------------------------
// Chart: gpt-5.6 tier output prices (log scale) across the record window.
// The 2026-07-30 reprice is the exhibit: Luna −80%, Terra −20%, Sol held.
// ---------------------------------------------------------------------------
const TIERS = [
  { id: 'gpt-5.6-sol',   label: 'sol',   color: 'var(--tok-c1)' },
  { id: 'gpt-5.6-terra', label: 'terra', color: 'var(--tok-c2)' },
  { id: 'gpt-5.6-luna',  label: 'luna',  color: 'var(--tok-c3)' },
];
const tierSeries = TIERS.map((t) => ({
  ...t,
  pts: frontierSeries(t.id)
    .filter((r) => r.output != null)
    .map((r) => ({ d: r.as_of_date, v: r.output as number })),
}));
const chartDays = frontierDays.filter((d) =>
  tierSeries.some((s) => s.pts.some((p) => p.d === d)));
// PAD_R sized for the longest right-edge series label ("terra $12" at 11px
// mono ≈ 62px past the +6 offset) — labels must fit inside the viewBox.
const W = 640, H = 230, PAD_L = 44, PAD_R = 78, PAD_T = 14, PAD_B = 26;
const xFor = (d: string) => {
  const i = chartDays.indexOf(d);
  return PAD_L + (i / Math.max(1, chartDays.length - 1)) * (W - PAD_L - PAD_R);
};
const LOG_MIN = Math.log10(1), LOG_MAX = Math.log10(40);
const yFor = (v: number) =>
  PAD_T + (1 - (Math.log10(v) - LOG_MIN) / (LOG_MAX - LOG_MIN)) * (H - PAD_T - PAD_B);
function stepPath(pts: { d: string; v: number }[]): string {
  if (!pts.length) return '';
  let p = `M ${xFor(pts[0].d).toFixed(1)} ${yFor(pts[0].v).toFixed(1)}`;
  for (let i = 1; i < pts.length; i++) {
    const x = xFor(pts[i].d), yPrev = yFor(pts[i - 1].v), y = yFor(pts[i].v);
    p += ` L ${x.toFixed(1)} ${yPrev.toFixed(1)} L ${x.toFixed(1)} ${y.toFixed(1)}`;
  }
  return p;
}
const yTicks = [1, 2, 5, 10, 30];
const xTickDays = chartDays.filter((_, i) =>
  i === 0 || i === chartDays.length - 1 || i === Math.floor(chartDays.length / 2));

// ---------------------------------------------------------------------------
// Open-weight serving table: breadth-sorted, most relevant.
// ---------------------------------------------------------------------------
const servedRows = [...served]
  .filter((r) => (r.n_providers ?? 0) >= 3)
  .sort((a, b) => (b.n_providers - a.n_providers)
    || Number(b.in_basket) - Number(a.in_basket)
    || (b.output_median ?? 0) - (a.output_median ?? 0))
  .slice(0, 16);
const servedAsOf = served[0]?.as_of_date ?? frontierLatestDay;

// ---------------------------------------------------------------------------
// Cross-model input/output comparison (grouped bars). Two constructions on
// one canvas, visually distinguished, NEVER pooled: first-party posted bars
// are solid; served-median bars are hatched and carry their n. Curated to
// the flagship rung of each family we track.
// ---------------------------------------------------------------------------
// Each pick prefers a FIRST-PARTY posted row when the record carries one
// (matched by pattern so a vendor's own id spelling doesn't need hardcoding)
// and falls back to the served median otherwise. When a vendor's own price
// list enters the record, its bar upgrades construction automatically and
// the n label drops, because the row is no longer a median.
const CMP_PICKS: {
  frontierMatch?: RegExp; servedId?: string;
  l1: string; l2: string; fl1?: string; fl2?: string;
}[] = [
  { frontierMatch: /^deepseek-v4-flash$/i, servedId: 'deepseekv4flash',
    l1: 'DeepSeek', l2: 'V4 Flash' },
  { frontierMatch: /qwen.*(3\.8|max)/i, servedId: 'qwen3coder480ba35binstruct',
    l1: 'Qwen3 Coder', l2: '480B' },
  { frontierMatch: /^kimi-k3$/i, servedId: 'kimik2thinking',
    l1: 'Kimi K2', l2: 'Thinking', fl1: 'Moonshot', fl2: 'Kimi K3' },
  { frontierMatch: /^gpt-5\.6-sol$/i,     l1: 'OpenAI',    l2: 'GPT-5.6 Sol' },
  { frontierMatch: /^Claude Opus 5$/i,    l1: 'Anthropic', l2: 'Opus 5' },
  { frontierMatch: /^Claude Fable 5$/i,   l1: 'Anthropic', l2: 'Fable 5' },
];
interface CmpBar {
  l1: string; l2: string; input: number; output: number;
  servedN: number | null;  // null = first-party posted
}
const cmpBars: CmpBar[] = CMP_PICKS.flatMap((p) => {
  if (p.frontierMatch) {
    const hit = [...latest.values()].find(
      (r) => p.frontierMatch!.test(r.model_id) && r.input != null && r.output != null);
    if (hit) {
      return [{ l1: p.fl1 ?? p.l1, l2: p.fl2 ?? p.l2, input: hit.input as number,
                output: hit.output as number, servedN: null }];
    }
  }
  const r = p.servedId ? served.find((s) => s.model_id === p.servedId) : undefined;
  return r && r.input_median != null && r.output_median != null
    ? [{ l1: p.l1, l2: p.l2, input: r.input_median, output: r.output_median,
         servedN: r.n_providers }]
    : [];
}).sort((a, b) => a.output - b.output);

const CW = 640, CH = 260, CPAD_L = 40, CPAD_R = 8, CPAD_T = 20, CPAD_B = 36;
const cmpMax = Math.max(1, ...cmpBars.map((b) => b.output)) * 1.06;
const cy = (v: number) =>
  Math.round((CPAD_T + (1 - v / cmpMax) * (CH - CPAD_T - CPAD_B)) * 10) / 10;
const cmpTicks = [0, 10, 20, 30, 40, 50].filter((t) => t <= cmpMax);
const GRP_W = (CW - CPAD_L - CPAD_R) / Math.max(1, cmpBars.length);
const BAR_W = 26, BAR_GAP = 2;
const fmtV = (v: number) => (v >= 10 ? `$${Math.round(v)}` : `$${v.toFixed(2)}`);

const windowStart = frontierDays[0] ?? '2026-07-03';
---
<Base
  title="Token Prices — GPT-5.6, Claude & Open-Weight Models · CCIR"
  description="Daily record of posted token prices: OpenAI GPT-5.6 (sol, terra, luna) and Anthropic Claude first-party price lists, plus cross-provider medians for Kimi K2, DeepSeek, Qwen and other open-weight models. USD per 1M tokens."
  ogImage="/og/tokens.png?v=2"
>
  <section class="wrap top">
    <div class="kicker">
      Token prices · USD per 1M tokens{modelsTracked > 0 ? ` · ${modelsTracked} models` : ''}
    </div>
    <h1>Token Prices</h1>
    <p class="dek">
      A token has two prices: what the model owner posts, and what
      independent providers charge to serve the same open model. Recorded
      daily, kept apart.
    </p>
  </section>

  <section class="wrap">
    {cmpBars.length >= 3 && (
      <div class="chart-block lead-chart">
        <div class="chart-title mono">
          posted price by model · input &amp; output · USD per 1M tokens · {servedAsOf}
        </div>
        <div class="cmp-legend mono">
          <span><span class="sw sw-in"></span> input</span>
          <span><span class="sw sw-out"></span> output</span>
        </div>
        <svg viewBox={`0 0 ${CW} ${CH}`} role="img"
          aria-label="Grouped bar chart comparing posted input and output prices per million tokens across models.">
          <defs>
            <pattern id="tok-hatch-in" width="5" height="5" patternUnits="userSpaceOnUse"
              patternTransform="rotate(45)">
              <rect width="5" height="5" fill="var(--tok-c1)" opacity="0.32" />
              <line x1="0" y1="0" x2="0" y2="5" stroke="var(--tok-c1)" stroke-width="2.2" />
            </pattern>
            <pattern id="tok-hatch-out" width="5" height="5" patternUnits="userSpaceOnUse"
              patternTransform="rotate(45)">
              <rect width="5" height="5" fill="var(--tok-c3)" opacity="0.32" />
              <line x1="0" y1="0" x2="0" y2="5" stroke="var(--tok-c3)" stroke-width="2.2" />
            </pattern>
          </defs>
          {cmpTicks.map((t) => (
            <>
              <line x1={CPAD_L} x2={CW - CPAD_R} y1={cy(t)} y2={cy(t)} class="grid" />
              <text x={CPAD_L - 6} y={cy(t) + 3} class="tick" text-anchor="end">${t}</text>
            </>
          ))}
          {cmpBars.map((b, i) => {
            const cx0 = CPAD_L + i * GRP_W + GRP_W / 2;
            const xIn = cx0 - BAR_W - BAR_GAP / 2;
            const xOut = cx0 + BAR_GAP / 2;
            const y0 = cy(0);
            const con = b.servedN != null
              ? `served median, n=${b.servedN} providers` : 'first-party posted';
            return (
              <>
                <rect x={xIn} width={BAR_W} y={cy(b.input)}
                  height={Math.max(1.5, y0 - cy(b.input))}
                  fill={b.servedN != null ? 'url(#tok-hatch-in)' : 'var(--tok-c1)'}>
                  <title>{`${b.l1} ${b.l2} — input ${fmtV(b.input)} per 1M tokens (${con})`}</title>
                </rect>
                <rect x={xOut} width={BAR_W} y={cy(b.output)}
                  height={Math.max(1.5, y0 - cy(b.output))}
                  fill={b.servedN != null ? 'url(#tok-hatch-out)' : 'var(--tok-c3)'}>
                  <title>{`${b.l1} ${b.l2} — output ${fmtV(b.output)} per 1M tokens (${con})`}</title>
                </rect>
                <text x={xIn + BAR_W / 2} y={cy(b.input) - 4} class="vlab"
                  text-anchor="middle">{fmtV(b.input)}</text>
                <text x={xOut + BAR_W / 2} y={cy(b.output) - 4} class="vlab"
                  text-anchor="middle">{fmtV(b.output)}</text>
                <text x={cx0} y={CH - 22} class="tick" text-anchor="middle">{b.l1}</text>
                <text x={cx0} y={CH - 11} class="tick" text-anchor="middle">
                  {b.l2}{b.servedN != null ? ` · n=${b.servedN}` : ''}
                </text>
              </>
            );
          })}
          <line x1={CPAD_L} x2={CW - CPAD_R} y1={cy(0)} y2={cy(0)} class="axis" />
        </svg>
        <p class="chart-note">
          Rows carrying an n are served medians across that many providers;
          the rest are the model owners' posted prices. Two constructions,
          never pooled.
        </p>
      </div>
    )}
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: 'CCIR Token Posted Price Record',
    description: 'Daily record of posted prices per 1 million tokens: '
      + 'first-party price lists from OpenAI and Anthropic (frontier posted '
      + 'construction) and cross-provider medians for open-weight models '
      + 'served by three or more independent providers (served construction). '
      + 'The two constructions are never pooled.',
    url: 'https://ccir.io/tokens',
    creator: { '@id': 'https://ccir.io/#org' },
    publisher: { '@id': 'https://ccir.io/#org' },
    isAccessibleForFree: true,
    temporalCoverage: `${windowStart}/..`,
    keywords: [
      'token prices', 'GPT-5.6 API pricing', 'Claude API pricing',
      'Kimi K2 price', 'DeepSeek price', 'price per million tokens',
      'LLM inference pricing', 'open-weight model pricing',
    ],
    variableMeasured: [
      { '@type': 'PropertyValue', name: 'input price', unitText: 'USD per 1M tokens' },
      { '@type': 'PropertyValue', name: 'cached input price', unitText: 'USD per 1M tokens' },
      { '@type': 'PropertyValue', name: 'output price', unitText: 'USD per 1M tokens' },
    ],
  })} />

  <section class="wrap">
    <div class="sec-head">
      <span class="sec-no">01</span>
      <h2>Frontier posted — first-party</h2>
      <span class="sec-note">from the owners' price lists · recorded since {windowStart}</span>
    </div>

    <div class="grid2">
      <div>
        <h3 class="prov">OpenAI <span class="prov-note">standard tier</span></h3>
        <table class="tbl">
          <thead><tr><th>Model</th><th>Input</th><th>Cached</th><th>Output</th><th>30d</th><th>Last reprice</th></tr></thead>
          <tbody>
            {openaiRows.map((r) => (
              <tr>
                <td class="mono model">{r.name}</td>
                <td class="mono">{fmt(r.input)}</td>
                <td class="mono dim">{fmt(r.cached)}</td>
                <td class="mono">{fmt(r.output)}</td>
                <td class="spark-cell">
                  {(() => { const sp = spark(r.id); return sp ? (
                    <svg viewBox={`0 0 ${SPARK_W} ${SPARK_H}`} class="spark"
                      aria-label={`30-day output price sparkline for ${r.name}`}>
                      <path d={sp.path} fill="none"
                        class={sp.flat ? 'spark-flat' : 'spark-line'} />
                    </svg>
                  ) : <span class="dim mono">—</span>; })()}
                </td>
                <td class="mono dim">
                  {r.reprice
                    ? `${r.reprice.date} (${pct(r.output, r.reprice.prevOutput)})`
                    : 'none in record'}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div>
        <h3 class="prov">Anthropic <span class="prov-note">model table</span></h3>
        <table class="tbl">
          <thead><tr><th>Model</th><th>Input</th><th>Cache hit</th><th>Output</th><th>30d</th><th>Last reprice</th></tr></thead>
          <tbody>
            {anthropicRows.map((r) => (
              <tr>
                <td class="mono model">{r.name}</td>
                <td class="mono">{fmt(r.input)}</td>
                <td class="mono dim">{fmt(r.cached)}</td>
                <td class="mono">{fmt(r.output)}</td>
                <td class="spark-cell">
                  {(() => { const sp = spark(r.id); return sp ? (
                    <svg viewBox={`0 0 ${SPARK_W} ${SPARK_H}`} class="spark"
                      aria-label={`30-day output price sparkline for ${r.name}`}>
                      <path d={sp.path} fill="none"
                        class={sp.flat ? 'spark-flat' : 'spark-line'} />
                    </svg>
                  ) : <span class="dim mono">—</span>; })()}
                </td>
                <td class="mono dim">
                  {r.reprice
                    ? `${r.reprice.date} (${pct(r.output, r.reprice.prevOutput)})`
                    : 'none in record'}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        {sonnetSep && (
          <p class="foot-note">
            Sonnet 5 is posted to step to {fmt(sonnetSep.input, 0)} in /
            {fmt(sonnetSep.output, 0)} out on 2026-09-01 — already on the record.
          </p>
        )}
      </div>
    </div>

    <div class="chart-block">
      <div class="chart-title mono">
        gpt-5.6 output price by tier · log scale · {chartDays[0]} → {frontierLatestDay}
      </div>
      <svg viewBox={`0 0 ${W} ${H}`} role="img"
        aria-label="Stepped line chart of gpt-5.6 output prices per million tokens by tier, log scale.">
        {yTicks.map((t) => (
          <>
            <line x1={PAD_L} x2={W - PAD_R} y1={yFor(t)} y2={yFor(t)} class="grid" />
            <text x={PAD_L - 6} y={yFor(t) + 3} class="tick" text-anchor="end">${t}</text>
          </>
        ))}
        {xTickDays.map((d) => (
          <text x={xFor(d)} y={H - 8} class="tick" text-anchor="middle">{d.slice(5)}</text>
        ))}
        {tierSeries.map((s) => (
          <>
            <path d={stepPath(s.pts)} fill="none" stroke={s.color} stroke-width="2" />
            {s.pts.length > 0 && (
              <text x={W - PAD_R + 6} y={yFor(s.pts[s.pts.length - 1].v) + 3}
                class="series-label" fill={s.color}>
                {s.label} ${s.pts[s.pts.length - 1].v}
              </text>
            )}
          </>
        ))}
      </svg>
      <p class="chart-note">
        One vendor, one day, three tiers: on 2026-07-30 the posted output
        price fell 80% on luna and 20% on terra while sol held.
      </p>
    </div>
  </section>

  <section class="wrap">
    <div class="sec-head">
      <span class="sec-no">02</span>
      <h2>Open-weight models — by serving breadth</h2>
      <span class="sec-note">cross-provider medians · n ≥ 3 · {servedAsOf}</span>
    </div>
    <table class="tbl wide sortable" id="served-tbl">
      <thead>
        <tr>
          <th data-t="s">Model</th><th data-t="n">Providers</th>
          <th data-t="n">Input median</th><th data-t="n">Output median</th>
          <th data-t="n">Output range</th>
        </tr>
      </thead>
      <tbody>
        {servedRows.map((r) => (
          <tr>
            <td class="mono model">{r.model_display}</td>
            <td class="mono">{r.n_providers}</td>
            <td class="mono">{fmt(r.input_median)}</td>
            <td class="mono">{fmt(r.output_median)}</td>
            <td class="mono dim">{fmt(r.output_min)} – {fmt(r.output_max)}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="foot-note">
      Each row is a median across independent providers of the same model,
      n disclosed. A wide range is dispersion in the serving market.
    </p>

  </section>

  <script is:inline>
    // Click-to-sort for the open-weight table. Numeric columns parse the
    // first number in the cell ("$0.55", "12", "$0.19 – $0.99" → its min);
    // first click sorts numeric columns descending, text ascending.
    (() => {
      const tbl = document.getElementById('served-tbl');
      if (!tbl) return;
      const tbody = tbl.tBodies[0];
      const num = (s) => {
        const m = s.replace(/[$,]/g, '').match(/-?\d+(?:\.\d+)?/);
        return m ? parseFloat(m[0]) : -Infinity;
      };
      tbl.querySelectorAll('th').forEach((th, i) => {
        th.addEventListener('click', () => {
          const numeric = th.dataset.t === 'n';
          const first = numeric ? 'descending' : 'ascending';
          const dir = th.getAttribute('aria-sort') === first
            ? (first === 'descending' ? 'ascending' : 'descending')
            : first;
          tbl.querySelectorAll('th').forEach((h) => h.removeAttribute('aria-sort'));
          th.setAttribute('aria-sort', dir);
          const sign = dir === 'ascending' ? 1 : -1;
          [...tbody.rows]
            .sort((a, b) => {
              const av = a.cells[i].textContent.trim();
              const bv = b.cells[i].textContent.trim();
              return sign * (numeric ? num(av) - num(bv) : av.localeCompare(bv));
            })
            .forEach((r) => tbody.appendChild(r));
        });
      });
    })();
  </script>

  <section class="wrap method">
    <details>
      <summary class="mono">Method</summary>
      <ul>
        <li>USD per 1 million tokens, as posted. Record runs from {windowStart}.</li>
        <li>Posted rows come from the model owners' own price lists, captured
          daily; a reprice appears on the day the list changed.</li>
        <li>Served rows are medians across independent providers of the same
          open-weight model, published at n ≥ 3.</li>
        <li>The two are never pooled — a posted price and a cross-provider
          median answer different questions.</li>
        <li>Token prices are not evidence about GPU rental rates. The link
          between them is serving efficiency, a vendor variable rather than a
          market price. CCIR publishes the GPU-hour record separately.</li>
      </ul>
    </details>
  </section>
</Base>

<style>
  .wrap { max-width: 1060px; margin: 0 auto; padding: 0 20px; }
  .top { padding-top: 40px; }
  .kicker {
    font-family: var(--font-mono); font-size: var(--fs-xs);
    letter-spacing: var(--tracking-eye); text-transform: uppercase;
    color: var(--accent);
  }
  h1 { margin: 8px 0 10px; }
  .dek { max-width: 700px; color: var(--ink-soft, var(--ink)); }

  .sec-head {
    display: flex; align-items: baseline; gap: 12px;
    margin: 44px 0 14px; border-bottom: 1px solid var(--rule, #8884);
    padding-bottom: 6px;
  }
  .sec-no { font-family: var(--font-mono); color: var(--accent); }
  .sec-head h2 { margin: 0; font-size: var(--fs-lg, 1.15rem); }
  .sec-note {
    margin-left: auto; font-family: var(--font-mono);
    font-size: var(--fs-xs); color: var(--ink-dim, #888);
