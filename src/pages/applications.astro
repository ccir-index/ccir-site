---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import {
  headlineRates, meta, headlineValue, headlineStatOf,
} from '../data/snapshot';
import type { Rate } from '../data/types';
import { bCurve, conCell } from '../data/term_b';
import { ivCards, IV_HAIRCUT, REPLAY_TROUGH } from '../lib/ivmodel';

// Calibrate against the global Neocloud B200 guaranteed on-demand series
// (John, 2026-09-24: B200, better numbers). Global over US: the US B200 panel
// is thin, and the global rate is where the /term ladder starts.
const REF_SERIES_ID = 'CRI-T2-B200-ALL-GTD-OD-ALL';
const ref = headlineRates.find((r) => r.series_id === REF_SERIES_ID);
// Headline stat per published convention: mean where the panel is deep
// (n>=10 sources), median below.
const closingRate = ref ? headlineValue(ref) : 0;
const statKind = ref ? headlineStatOf(ref) : 'median';

const round5c = (n: number) => Math.round(n / 0.05) * 0.05;
const round1c = (n: number) => Math.round(n * 100) / 100;
const fmt = (n: number) => n.toFixed(2);

// Watch levels, set at close as a share of the closing level.
const LEVEL_2 = round5c(closingRate * 0.92);
const LEVEL_3 = round5c(closingRate * 0.80);
const LEVEL_4 = round5c(closingRate * 0.69);

interface TrajRow {
  month: string;
  pct: number;
  value: number;
  level: 1 | 2 | 3 | 4;
  levelLabel: string;
  transition: boolean;
  improvement: boolean;
  response: string;
  check: string;
}
function classify(value: number): 1 | 2 | 3 | 4 {
  if (value >= LEVEL_2) return 1;
  if (value >= LEVEL_3) return 2;
  if (value >= LEVEL_4) return 3;
  return 4;
}
const LEVEL_LABELS: Record<number, string> = {
  1: 'Level 1 (Baseline)',
  2: 'Level 2 (Watch)',
  3: 'Level 3 (Review)',
  4: 'Level 4 (Escalate)',
};
const LEVEL_RESPONSES: Record<number, string> = {
  1: 'Quarterly price review; standard borrower reporting',
  2: 'Monthly price review; request the borrower\'s contract book',
  3: 'Monthly review; test debt service coverage at current rates; check reserve and sweep terms already in the facility',
  4: 'Credit committee review; stress re-leasing against the current term curve; weekly price tracking',
};
const levels = [
  { label: LEVEL_LABELS[1], range: `30-day average at or above $${fmt(LEVEL_2)}`, response: LEVEL_RESPONSES[1] },
  { label: LEVEL_LABELS[2], range: `$${fmt(LEVEL_3)} to $${fmt(LEVEL_2)}`, response: LEVEL_RESPONSES[2] },
  { label: LEVEL_LABELS[3], range: `$${fmt(LEVEL_4)} to $${fmt(LEVEL_3)}`, response: LEVEL_RESPONSES[3] },
  { label: LEVEL_LABELS[4], range: `Below $${fmt(LEVEL_4)}`, response: LEVEL_RESPONSES[4] },
];

const trajPcts: { month: string; pct: number; check: string }[] = [
  { month: 'Month 0 (Close)', pct: 1.00, check: 'Record the closing level and set watch levels' },
  { month: 'Month 3',         pct: 0.95, check: 'No change in posture' },
  { month: 'Month 6',         pct: 0.88, check: 'Check how much capacity sits under committed contracts' },
  { month: 'Month 9',         pct: 0.82, check: 'No change in posture' },
  { month: 'Month 12',        pct: 0.76, check: 'Recompute debt service coverage at the current 30-day average' },
  { month: 'Month 15',        pct: 0.71, check: 'No change in posture' },
  { month: 'Month 18',        pct: 0.65, check: 'Size re-leasing risk on contracts expiring within 12 months' },
  { month: 'Month 21',        pct: 0.74, check: 'Record the recovery; step review frequency back down' },
];
let prevLevel: 1 | 2 | 3 | 4 = 1;
const trajectory: TrajRow[] = trajPcts.map(({ month, pct, check }) => {
  const value = round1c(closingRate * pct);
  const level = classify(value);
  const transition = level > prevLevel;
  const improvement = level < prevLevel;
  const row: TrajRow = {
    month, pct, value, level,
    levelLabel: LEVEL_LABELS[level],
    transition, improvement,
    response: LEVEL_RESPONSES[level],
    check,
  };
  prevLevel = level;
  return row;
});

// Collateral value at close from /hardware: the B200 model value per GPU.
const FLEET = 8000;
const FACILITY = 200_000_000;
const b200Card = ivCards.find((c) => c.model === 'B200');
const fleetValue = b200Card ? b200Card.base * FLEET : 0;
const ltv = fleetValue > 0 ? FACILITY / fleetValue : 0;
const fmtM = (n: number) => `$${Math.round(n / 1e6).toLocaleString('en-US')}M`;

const exposureTerms: { term: string; value: string }[] = [
  { term: 'Borrower', value: 'A GPU-rich neocloud special-purpose entity (SPE)' },
  { term: 'Facility type', value: 'Senior-secured term loan' },
  { term: 'Facility size', value: '$200,000,000' },
  { term: 'Tenor', value: '4 years, scheduled amortization with bullet at maturity' },
  { term: 'Collateral', value: 'First-lien security interest in 1,000 B200 8-GPU nodes (8,000 GPUs)' },
  { term: 'Collateral value at close', value: `${fmtM(fleetValue)} at the CCIR modeled value of $${Math.round(b200Card?.base ?? 0).toLocaleString('en-US')} per GPU (/hardware); loan-to-value ${Math.round(ltv * 100)}%` },
  { term: 'Monitored series', value: `${REF_SERIES_ID}, published by CCIR (Neocloud operator segment, B200, guaranteed on-demand, global)` },
  { term: 'Series level at close', value: `$${fmt(closingRate)} per GPU per hour (as of ${meta.as_of_date})` },
  { term: 'Smoothing', value: '30-day average of daily prints' },
  { term: 'Review date', value: 'Last business day of each month' },
];

// ---------------------------------------------------------------------------
// Use case 02: re-leasing (rollover) risk on B200 (John, 2026-09-24), built
// on /term and /hardware:
//  - anchor contract = the /term 2Y contracted cell (trailing 12 months,
//    sqrt-GPU weighted, bundled at estimate);
//  - base re-lease = posted global neocloud on-demand (the /term ladder
//    start) less the measured posted-to-contracted discount (/hardware);
//  - stress re-lease = base at the low of the 2024-25 H100 replay (/hardware).
const b200Curve = bCurve('B200');
const anchorCell = conCell('B200', '2Y');
const ANCHOR_RATE = anchorCell?.rate ?? 0;
const postedOd = b200Curve.od?.value ?? 0;
const postedOdSellers = b200Curve.od?.sellers ?? 0;
const discount = IV_HAIRCUT?.haircut ?? 0;
const reLeaseBase = postedOd * (1 - discount);
const reLeaseStress = reLeaseBase * REPLAY_TROUGH;

// Stylized facility for the rollover exhibit. Anchor share and closing DSCR
// are illustrative; every rate is live.
const FLEET_GPUS = FLEET;           // 1,000 8-GPU nodes
const ANCHOR_SHARE = 0.70;          // capacity under the expiring anchor contract
const CLOSE_DSCR = 1.45;            // DSCR at close, on total contracted book
// At close the rest of the fleet sells at the base re-lease rate. At
// rollover the whole fleet reprices: base, then stress.
const revClose = ANCHOR_SHARE * ANCHOR_RATE + (1 - ANCHOR_SHARE) * reLeaseBase;
const dscrAt = (rate: number) => (revClose > 0 ? (rate / revClose) * CLOSE_DSCR : 0);
const dscrBase = dscrAt(reLeaseBase);
const dscrStress = dscrAt(reLeaseStress);
const pctVsAnchor = (r: number) => (ANCHOR_RATE > 0 ? ((r - ANCHOR_RATE) / ANCHOR_RATE) * 100 : 0);

// ---------------------------------------------------------------------------
// UC01 history: the watch levels run against reconstructed history. Rates are
// the stepped-panel monthly medians from the archived-page backfill
// (/research/od-vs-committed), NOT the live series; close = 2024-02 at $4.30,
// levels at 92/80/69% of close rounded to $0.05: 3.95 / 3.45 / 2.95.
const BACKTEST_CLOSE = 4.30;
const backtest: { period: string; rate: string; level: string; cls: string; posture: string }[] = [
  { period: 'Feb – Jun 2024', rate: '$4.30', level: 'Level 1 · Baseline', cls: 't1', posture: 'Quarterly review' },
  { period: 'Jul – Aug 2024', rate: '$3.92 → $3.49', level: 'Level 2 · Watch', cls: 't2', posture: 'Monthly review; contract book requested' },
  { period: 'Sep – Nov 2024', rate: '$3.24 → $2.99', level: 'Level 3 · Review', cls: 't3', posture: 'Debt service coverage tested at current rates' },
  { period: 'Dec 2024 – Nov 2025', rate: '$2.79 – $2.92', level: 'Level 4 · Escalate (12 months)', cls: 't4', posture: 'Committee review; re-leasing stressed against the term curve' },
  { period: 'Dec 2025 – Feb 2026', rate: '$3.18', level: 'Level 3 · improvement', cls: 't3', posture: 'Review frequency steps down' },
  { period: 'Mar – Apr 2026', rate: '$3.74', level: 'Level 2', cls: 't2', posture: 'Further step-down' },
  { period: 'May 2026', rate: '$3.98', level: 'Level 1 · restored', cls: 't1', posture: 'Back to quarterly review' },
  { period: 'Jun 2026', rate: '$3.39', level: 'Level 3 · re-tightening', cls: 't3', posture: 'Sharp one-month drop; the 15% fast-move check applies' },
];

// ---------------------------------------------------------------------------
// Use case 03: multi-generation pool monitoring. Pool rate = unit-weighted
// average of the published per-generation global Neocloud guaranteed
// on-demand cells (global, matching Use case 01 and the /term ladder start),
// weights fixed at closing per the asset schedule.
function poolCell(chip: string): Rate | undefined {
  return headlineRates
    .filter((r) => r.tier === 'T2' && r.gpu_model === chip &&
                   r.commitment_term === 'OnDemand' && r.form_factor === 'ALL' &&
                   r.region === 'ALL' && r.interruptibility === 'GTD' &&
                   r.promotion_status !== 'Shadow')
    .sort((a, b) => (b.n_sources ?? 0) - (a.n_sources ?? 0))[0];
}
const POOL = [
  { chip: 'B200', weight: 0.50 },
  { chip: 'H200', weight: 0.30 },
  { chip: 'H100', weight: 0.20 },
];
const poolRows = POOL.map((p) => {
  const cell = poolCell(p.chip);
  return { ...p, cell, rate: cell ? headlineValue(cell) : null };
}).filter((r) => r.rate != null);
const poolWeightSum = poolRows.reduce((s, r) => s + r.weight, 0);
const poolRate = poolRows.reduce((s, r) => s + r.weight * (r.rate as number), 0) / (poolWeightSum || 1);

// On-page contents. ids match the anchored use-case articles and section h3s.
const toc: { id: string; kicker: string; label: string; secs: string[][] }[] = [
  {
    id: 'uc-01',
    kicker: 'Use case 01',
    label: 'Tracking Collateral Earning Power',
    secs: [
      ['uc-01-s01', 'Why Watch the Market Rate'],
      ['uc-01-s02', 'Hypothetical Exposure'],
      ['uc-01-s03', 'Setting Watch Levels'],
      ['uc-01-s04', 'Worked Numerical Example'],
      ['uc-01-s05', 'The Watch Levels Against Three Years of History'],
      ['uc-01-s06', 'Weighting by Exposed Capacity'],
      ['uc-01-s07', 'Limitations'],
    ],
  },
  {
    id: 'uc-02',
    kicker: 'Use case 02',
    label: 'Re-Leasing Risk Sized Against the Term Curve',
    secs: [
      ['uc-02-s01', 'Why Rollover Is the Central Credit Question'],
      ['uc-02-s02', 'Worked Rollover Exhibit'],
      ['uc-02-s03', 'What to Watch and When'],
      ['uc-02-s04', 'Limitations'],
    ],
  },
  {
    id: 'uc-03',
    kicker: 'Use case 03',
    label: 'Monitoring a Multi-Generation Pool',
    secs: [
      ['uc-03-s01', 'The Pool Rate'],
      ['uc-03-s02', 'The Property That Makes Pools Monitorable'],
      ['uc-03-s03', 'Adjacent Practice and Limitations'],
    ],
  },
  {
    id: 'data-note',
    kicker: 'Note',
    label: 'How to Reference CCIR Data',
    secs: [],
  },
];
---
<Base
  title="Monitoring GPU-Backed Credit with Market Data · CCIR"
  ogImage="/og/applications.png"
  description="Worked examples showing how lenders, credit analysts and risk teams can use CCIR's published GPU rental price data to monitor GPU-backed exposures. Covers price tracking against market rates, re-leasing risk sized against the published term curve, and monitoring a multi-generation pool."
>
  <nav class="apps-navband" aria-label="Use cases">
    <div class="wrap apps-nav-inner">
      {toc.map((u) => (
        <a class="apps-nav-link" href={'#' + u.id}>
          <span class="apps-nav-n">{u.kicker.replace('Use case ', 'UC')}</span> {u.label}
        </a>
      ))}
    </div>
  </nav>
  <section class="wrap page-top">
    <PageHeader title="Applications" kicker="Worked Monitoring Examples" asOf={meta.as_of_date} display />
    <p class="dek">
      Worked examples showing how lenders, credit analysts and risk teams can
      use CCIR's published market data to monitor GPU-backed exposures. Each
      example uses a specific CCIR data series and calibrates to today's
      snapshot.
    </p>

    <nav class="toc" id="contents" aria-label="Contents">
      <div class="toc-kicker">Contents</div>
      <div class="toc-grid">
        {toc.map((u) => (
          <div class="toc-group">
            <a class="toc-uc" href={'#' + u.id}>
              <span class="toc-uc-kicker">{u.kicker}</span>
              {u.label}
            </a>
            {u.secs.length > 0 && (
              <ol class="toc-secs">
                {u.secs.map((s) => (
                  <li><a href={'#' + s[0]}>{s[1]}</a></li>
                ))}
              </ol>
            )}
          </div>
        ))}
      </div>
    </nav>

    <article class="usecase" id="uc-01">
      <header class="uc-head">
        <span class="uc-kicker">Use case 01 · Senior-secured term loan</span>
        <h2>Tracking Collateral Earning Power Against the Market Rate</h2>
        <p class="uc-lede">
          A worked example of how a lender tracking collateral earning power
          might watch a published CCIR series. The lender sets watch levels
          below the level at close. Each level maps to a monitoring response,
          such as a more frequent review or a request for the contract book.
          The example is illustrative. It is not a model form or a
          recommended practice.
        </p>
      </header>

      <section class="uc-rate">
        <div class="rate-kicker">Monitored series (live, calibrating this example)</div>
        <div class="rate-id">{REF_SERIES_ID}</div>
        <div class="rate-price">${fmt(closingRate)}<span class="rate-unit">/GPU-hr</span></div>
        <div class="rate-meta">
          Neocloud operator segment · B200 · Guaranteed on-demand · Global
          <span class="sep">·</span>
          <span title="Observations are qualifying posted listings in the computation window; a source contributes one vote to the statistic however many of its listings pool into the cell (operator-equal aggregation).">{statKind} of {ref?.n_sources} sources / {ref?.n_observations} observations</span>
          <span class="sep">·</span>
          as of {meta.as_of_date}
        </div>
        <div class="rate-thresholds">
          <span><strong>Level 2 watch</strong> ${fmt(LEVEL_2)} <span class="dim">(92% of close)</span></span>
          <span><strong>Level 3 watch</strong> ${fmt(LEVEL_3)} <span class="dim">(80% of close)</span></span>
          <span><strong>Level 4 watch</strong> ${fmt(LEVEL_4)} <span class="dim">(69% of close)</span></span>
        </div>
      </section>

      <section class="sec">
        <h3 id="uc-01-s01"><span class="sec-n">01</span> Why Watch the Market Rate</h3>
        <p>
          A GPU earns what the rental market pays for it. A published market
          rate is therefore a direct read on the earning power behind a
          GPU-backed loan. Borrower reports arrive monthly or quarterly and
          reflect the borrower's own pricing. A daily series from an outside
          source gives the lender an independent view between reports.
        </p>
        <p>
          Commodity lenders already work this way. Reserve-based lenders watch
          oil and gas strip prices. Other commodity lenders track Henry Hub,
          Platts assessments and LME cash prices. GPU rental prices can play
          the same role for compute collateral.
        </p>
        <p>
          Watch levels turn the series into a routine. The lender fixes the
          levels at close. On each review date, the 30-day average sits either
          above or below each level. The response steps up in stages. Small
          moves prompt a closer look, and large moves prompt a full review.
        </p>
      </section>

      <section class="sec">
        <h3 id="uc-01-s02"><span class="sec-n">02</span> Hypothetical Exposure</h3>
        <div class="ftable-wrap">
          <table class="ftable">
            <tbody>
              {exposureTerms.map(({ term, value }) => (
                <tr>
                  <th>{term}</th>
                  <td>{value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="sec">
        <h3 id="uc-01-s03"><span class="sec-n">03</span> Setting Watch Levels</h3>
        <p>
          The example sets three watch levels at 92%, 80% and 69% of the
          closing level, rounded to the nearest $0.05. The monitor tests the
          30-day average of daily prints on the last business day of each
          month. The average smooths day-to-day changes in panel composition.
        </p>
        <div class="ftable-wrap">
          <table class="ftable">
            <thead>
              <tr>
                <th>Level</th>
                <th>Series range</th>
                <th>Monitoring response</th>
              </tr>
            </thead>
            <tbody>
              {levels.map((l) => (
                <tr>
                  <td class="feat">{l.label}</td>
                  <td>{l.range}</td>
                  <td>{l.response}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p>
          The monitor also runs a fast-move check between review dates. If a
          daily print falls more than 15% below the last 30-day average, the
          lender reviews early. Without this check, a sharp fall early in the
          month would wait weeks for the next review.
        </p>
        <p>
          The levels in this example set monitoring responses only. They have
          no contractual effect. Any contractual terms in a facility are for
          the parties and their counsel.
        </p>
      </section>

      <section class="sec">
        <h3 id="uc-01-s04"><span class="sec-n">04</span> Worked Numerical Example</h3>
        <p class="calib-note">
          Calibration: values below derive from a closing level of
          <strong>${fmt(closingRate)}</strong> per GPU per hour
          ({REF_SERIES_ID}, published by CCIR on {meta.as_of_date}) and a
          stylized 24-month rate path. Watch levels sit at 92% / 80% / 69% of
          close, rounded to the nearest $0.05.
        </p>
        <div class="ftable-wrap">
          <table class="traj">
            <thead>
              <tr>
                <th>Review Date</th>
                <th class="num">30-Day Avg</th>
                <th class="num">% of Close</th>
                <th>Level</th>
                <th>Monitoring Response</th>
                <th>What the Monitor Checks</th>
              </tr>
            </thead>
            <tbody>
              {trajectory.map((r) => (
                <tr class={r.transition ? 'transition' : r.improvement ? 'improvement' : ''}>
                  <td>{r.month}</td>
                  <td class="num">${fmt(r.value)}</td>
                  <td class="num">{(r.pct * 100).toFixed(0)}%</td>
                  <td class={`tier tier-${r.level} ${r.transition ? 'tier-transition' : ''} ${r.improvement ? 'tier-improvement' : ''}`}>
                    {r.levelLabel}
                  </td>
                  <td class="reqs">{r.response}</td>
                  <td class="cure">{r.check}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p>
          <strong>The series sets the pace of review.</strong> Each change in
          level comes from the published data. The lender decides in advance
          what each level means for its own process.
        </p>
        <p>
          <strong>Some checks take longer than others.</strong> A price review
          takes a day. Gathering a contract book or rerunning a coverage model
          takes weeks. Staged levels give the lender time to prepare each step.
        </p>
        <p>
          <strong>Recovery steps the review back down.</strong> When the rate
          recovers (Month 21 in the example), review frequency falls back. The
          lender records the recovery with the data that drove it.
        </p>
      </section>

      <section class="sec">
        <h3 id="uc-01-s05"><span class="sec-n">05</span> The Watch Levels Against Three Years of History</h3>
        <p>
          B200 has not yet been through a full price cycle. H100 has, so this
          section runs the same watch structure on H100 history in place of
          a stylized path. Rates are the monthly neocloud H100 guaranteed
          on-demand medians from CCIR's archived-page backfill
          (<a href="/research/od-vs-committed">On-Demand vs Committed, Three
          Years</a>). The exposure starts in February 2024 at
          ${fmt(BACKTEST_CLOSE)}. Watch levels sit at 92% / 80% / 69% of that
          level ($3.95 / $3.45 / $2.95).
        </p>
        <div class="ftable-wrap">
          <table class="traj">
            <thead>
              <tr><th>Period</th><th class="num">Series level</th><th>Level</th><th>Monitoring posture</th></tr>
            </thead>
            <tbody>
              {backtest.map((r) => (
                <tr>
                  <td>{r.period}</td>
                  <td class="num">{r.rate}</td>
                  <td class={`tier tier-${r.cls.slice(1)}`}>{r.level}</td>
                  <td class="reqs">{r.posture}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p>
          <strong>Twelve months at Level 4.</strong> Through the 2025 price
          floor, a lender following this routine would have run its fullest
          review for a year. When the market turned in December 2025, the
          posture stepped down. It reached baseline by May 2026.
        </p>
        <p>
          <strong>Every change in level came from the published data.</strong>
          The record shows eight level changes in twenty-nine months. Each one
          traces to a monthly print.
        </p>
        <p class="calib-note">
          Calibration notes: the exhibit uses monthly stepped-panel medians in
          place of the 30-day daily average. The backfill panel is thin early.
          It uses a different collection method from the live daily series,
          and no splicing is implied. The single-month drop in June 2026 shows
          why the routine smooths on a 30-day average and adds a 15% fast-move
          check.
        </p>
      </section>

      <section class="sec">
        <h3 id="uc-01-s06"><span class="sec-n">06</span> Weighting by Exposed Capacity</h3>
        <p>
          A heavily contracted borrower's revenue does not move with the
          market rate. A raw price level would flag that borrower as often as
          an uncontracted one. Reserve-based lenders handle the same issue by
          valuing hedged volumes at their hedge prices. Committed customer
          contracts play that role for compute.
        </p>
        <p>
          The monitor can blend the two. Contracted capacity counts at its
          contract rate. Exposed capacity counts at the 30-day market average.
          Exposed capacity is anything uncontracted or under a contract that
          expires within 12 months. The monitor compares the blended rate with
          the watch levels.
        </p>
        <p>
          The blend tracks contract expiry. Far from expiry, the market rate
          touches only the uncontracted share. As contracts approach expiry,
          more capacity is exposed, and the same market level weighs more
          heavily. The table shows the 2025 floor in the Section 05 history,
          with the market at $2.79 and contracts written at close.
        </p>
        <div class="ftable-wrap">
          <table class="ftable">
            <thead><tr><th>Contracted share (beyond 12 mo)</th><th>Blended rate</th><th>Level at the 2025 floor</th></tr></thead>
            <tbody>
              <tr><td>85%</td><td>$4.07</td><td>Level 1 · Baseline</td></tr>
              <tr><td>50%</td><td>$3.55</td><td>Level 2 · Watch</td></tr>
              <tr><td>15%</td><td>$3.02</td><td>Level 3 · Review</td></tr>
              <tr><td>0% (market rate only)</td><td>$2.79</td><td>Level 4 · Escalate</td></tr>
            </tbody>
          </table>
        </div>
        <p>
          <strong>What the blend needs from the borrower:</strong> a monthly
          schedule of contracted rates, covered capacity and expiry dates. The
          same inputs drive the rollover exhibit in Use case 02. One data set
          supports both: the published series plus the borrower's contract
          ladder.
        </p>
      </section>

      <section class="sec">
        <h3 id="uc-01-s07"><span class="sec-n">07</span> Limitations</h3>
        <p>
          <strong>This is illustrative.</strong> The hypothetical exposure,
          dollar levels, breakpoints and responses are designed for clarity. A
          real monitoring program depends on the borrower, the pool, the
          facility terms and market conditions.
        </p>
        <p>
          <strong>Watch-level calibration is the central judgment.</strong> The
          example uses 92% / 80% / 69% of the closing level. A lender might
          instead use absolute dollar levels or a mix of both.
        </p>
        <p>
          <strong>Panel depth matters.</strong> Each series discloses its
          number of sources. A thin series moves more from day to day, and a
          monitor should read it with that in mind.
        </p>
      </section>
    </article>

    <article class="usecase" id="uc-02">
      <header class="uc-head">
        <span class="uc-kicker">Use case 02 · Contract rollover</span>
        <h2>Re-Leasing Risk Sized Against the Published Term Curve</h2>
        <p class="uc-lede">
          A worked example of contract rollover in GPU-backed lending. A
          borrower's anchor customer contract expires mid-loan. The freed
          capacity must be re-leased at then-prevailing rates. A lender
          watching this risk can size it against the published term curve
          months before the contract expires. The approach mirrors the
          market-rent assumptions used in commercial real estate and aircraft
          leasing. The example is illustrative.
        </p>
      </header>

      <section class="uc-rate">
        <div class="rate-kicker">Re-lease rate at rollover (live, calibrating this example)</div>
        <div class="rate-id">B200 · global Neocloud · from <a href="/term">/term</a> and <a href="/hardware">/hardware</a></div>
        <div class="rate-price">${fmt(reLeaseBase)}<span class="rate-unit">/GPU-hr · base re-lease</span></div>
        <div class="rate-meta">
          Posted on-demand ${fmt(postedOd)} (/term ladder, {postedOdSellers} sellers) less the measured
          posted-to-contracted discount of {Math.round(discount * 100)}%
          <span class="sep">·</span>
          as of {meta.as_of_date}
        </div>
        <div class="rate-thresholds">
          {anchorCell?.rate != null && (
            <span><strong>Contracted 2Y</strong> ${fmt(ANCHOR_RATE)} <span class="dim">({anchorCell.n} deals, ${fmt(anchorCell.min!)}–${fmt(anchorCell.max!)})</span></span>
          )}
          <span><strong>Base re-lease</strong> ${fmt(reLeaseBase)}</span>
          <span><strong>Stress re-lease</strong> ${fmt(reLeaseStress)} <span class="dim">(2024–25 replay low)</span></span>
        </div>
      </section>

      <section class="sec">
        <h3 id="uc-02-s01"><span class="sec-n">01</span> Why Rollover Is the Central Credit Question</h3>
        <p>
          Customer contracts usually run two to five years. The facilities
          they support often mature later. The capacity behind the loan must
          then be re-contracted at least once before repayment. No one has
          locked that future rate, and few tools exist to hedge it. What the
          capacity earns on re-lease is the credit question.
        </p>
        <p>
          Three published numbers size it. The anchor contract is priced like
          the contracted rates on <a href="/term">/term</a>. The rate a new
          contract would sign at today is the posted on-demand rate less the
          measured gap between posted and contracted prices. The downside is
          the stress path on <a href="/hardware">/hardware</a>: a replay of the
          2024–25 H100 decline, when on-demand rates fell 61% in 18 months.
        </p>
        <p>
          Commercial real estate lenders handle the same question with
          market-rent assumptions. Aircraft lessors use appraiser-published
          re-leasing rates. For GPUs, the market rent is observable daily.
        </p>
      </section>

      <section class="sec">
        <h3 id="uc-02-s02"><span class="sec-n">02</span> Worked Rollover Exhibit</h3>
        <p class="calib-note">
          Calibration: stylized facility of {FLEET_GPUS.toLocaleString('en-US')} B200
          GPUs (1,000 nodes). {(ANCHOR_SHARE * 100).toFixed(0)}% of capacity
          sits under a 2-year anchor contract at the /term 2Y contracted rate
          of ${fmt(ANCHOR_RATE)}. The rest sells at the base re-lease rate.
          DSCR at close {CLOSE_DSCR.toFixed(2)}x. At rollover the whole fleet
          reprices. Margins and debt service stay constant to isolate the
          price effect. Every rate is live as of {meta.as_of_date}.
        </p>
        <div class="ftable-wrap">
          <table class="ftable">
            <thead><tr><th>Case</th><th class="num">Rate $/GPU-hr</th><th class="num">vs anchor</th><th class="num">DSCR</th></tr></thead>
            <tbody>
              <tr><td>At close (anchor contract)</td><td class="num">{fmt(ANCHOR_RATE)}</td><td class="num">—</td><td class="num">{CLOSE_DSCR.toFixed(2)}x</td></tr>
              <tr><td>Rollover, base re-lease</td><td class="num">{fmt(reLeaseBase)}</td><td class="num">{pctVsAnchor(reLeaseBase) >= 0 ? '+' : '−'}{Math.abs(pctVsAnchor(reLeaseBase)).toFixed(0)}%</td><td class="num"><strong>{dscrBase.toFixed(2)}x</strong></td></tr>
              <tr><td>Rollover, stress re-lease</td><td class="num">{fmt(reLeaseStress)}</td><td class="num">{pctVsAnchor(reLeaseStress) >= 0 ? '+' : '−'}{Math.abs(pctVsAnchor(reLeaseStress)).toFixed(0)}%</td><td class="num"><strong>{dscrStress.toFixed(2)}x</strong></td></tr>
            </tbody>
          </table>
        </div>
        <p>
          <strong>The exhibit sizes the risk ahead of the expiry.</strong> The
          base and stress cases are computable on any publication date. They
          need only the borrower's contract book and the published rates. The
          lender can see the gap months before the revenue changes.
        </p>
        <p>
          <strong>A coverage flag at 1.20x</strong> prompts a review of the
          borrower's re-leasing plan and pipeline, and a check of any reserve
          terms already in the facility.
        </p>
      </section>

      <section class="sec">
        <h3 id="uc-02-s03"><span class="sec-n">03</span> What to Watch and When</h3>
        <p>
          A lender tracking rollover risk might follow a simple routine.
        </p>
        <p>
          <strong>Start 180 days out.</strong> Begin the rollover check 180
          days before any contract that supplies 20% or more of gross rental
          revenue expires. Repeat it monthly until the contract is replaced or
          renewed.
        </p>
        <p>
          <strong>Re-price only the expiring block.</strong> Hold every other
          contract at its contracted rate. Re-price the expiring capacity at
          the base re-lease rate, then at the stress rate. Compare projected
          cash flow with scheduled debt service in both cases.
        </p>
        <p>
          <strong>Watch the contracted rates as they file.</strong> New deals
          on <a href="/term">/term</a> show where contracts are signing now.
          A new filing below the base re-lease rate is an early sign that the
          discount is widening.
        </p>
        <p>
          <strong>Every moving input comes from outside the borrower.</strong>
          The rates come from published data. The check date comes from the
          contract calendar.
        </p>
      </section>

      <section class="sec">
        <h3 id="uc-02-s04"><span class="sec-n">04</span> Limitations</h3>
        <p>
          <strong>This is illustrative.</strong> Fleet size, anchor share and
          closing DSCR are stylized. The contracted rate rests on a few filed
          deals, and the count and range print above. The posted-to-contracted
          discount is measured across chips and tenors, and a single deal can
          sit well above or below it. The stress applies H100's history to
          B200, which has not yet been through a downturn. Utilization on
          re-leased capacity stays at the contracted level.
        </p>
      </section>

    </article>

    <article class="usecase" id="uc-03">
      <header class="uc-head">
        <span class="uc-kicker">Use case 03 · Pool surveillance</span>
        <h2>Monitoring a Multi-Generation Pool</h2>
        <p class="uc-lede">
          Securitized and warehouse pools usually hold mixed fleets across chip
          generations. This worked example builds a pool rate for such a fleet.
          It is a unit-weighted basket of the published per-generation series,
          with weights from the asset schedule. Aircraft and auto lenders watch
          mixed fleets in a similar way. The example is illustrative.
        </p>
      </header>

      <section class="uc-rate">
        <div class="rate-kicker">Worked pool (live, calibrating this example)</div>
        <div class="rate-id">{poolRows.map((r) => `${(r.weight * 100).toFixed(0)}% ${r.chip}`).join(' · ')}</div>
        <div class="rate-price">${fmt(poolRate)}<span class="rate-unit">/GPU-hr · Pool rate</span></div>
        <div class="rate-meta">
          Unit-weighted basket of Neocloud guaranteed on-demand cells
          <span class="sep">·</span>
          as of {meta.as_of_date}
        </div>
        <div class="rate-thresholds">
          {poolRows.map((r) => (
            <span><strong>{r.chip}</strong> ${fmt(r.rate as number)} <span class="dim">× {(r.weight * 100).toFixed(0)}%</span></span>
          ))}
        </div>
      </section>

      <section class="sec">
        <h3 id="uc-03-s01"><span class="sec-n">01</span> The Pool Rate</h3>
        <p>
          The pool rate is the weighted average of the CCIR series for each
          generation in the asset schedule. For each generation, the example
          uses the global Neocloud guaranteed on-demand series.
          Each weight is that generation's share of pool GPU units. Weights
          stay fixed until a servicer report shows a substitution, addition or
          disposition.
        </p>
        <p>
          Every input is a published series with disclosed panel depth. The
          weights come from the deal's own asset schedule. Trustee, servicer,
          rating analysts and investors can all compute the same number. The
          watch levels in Use case 01 apply unchanged to the pool rate.
        </p>
      </section>

      <section class="sec">
        <h3 id="uc-03-s02"><span class="sec-n">02</span> The Property That Makes Pools Monitorable</h3>
        <p>
          The cross-section of generation pricing is log-linear in age at a
          common slope (≈ −26% per year; see
          <a href="/research/gpu-age-curve">the age-curve note</a>). That has
          a direct consequence for pools. <strong>A static pool's earning
          power declines at about the same rate regardless of its generation
          mix.</strong> Mix sets the level. It does not change the slope. The
          only lever that changes a pool's decline path is substitution,
          replacing aging units with newer generations. Surveillance checks
          that servicer behavior.
        </p>
        <p>
          Surveillance therefore watches four things. The first is the pool
          rate against its closing level. The second is mix drift in the
          servicer report against the weights in use. The third is whether
          substitutions entered the basket on schedule. The fourth is panel
          depth <em>n</em> on each underlying cell, so a thinning input shows
          early. A generation without a published cell (a new chip in its
          first weeks) stays outside the basket until its series publishes.
        </p>
      </section>

      <section class="sec">
        <h3 id="uc-03-s03"><span class="sec-n">03</span> Adjacent Practice and Limitations</h3>
        <p>
          Adjacent asset classes use the same construction. Aircraft ABS
          monitors fleet value on appraisals weighted by airframe type and
          vintage. Container ABS tracks per-diem rates by box type and age.
          Auto ABS surveillance marks pools against vintage and segment auction
          data. The per-generation GPU series publish daily.
        </p>
        <p>
          Limitations: the basket inherits each cell's panel depth, and thin
          cells are disclosed. Unit weighting is one convention. Cost-basis or
          capacity weighting are alternatives. The pool rate measures the
          earning power of the collateral. It is not a valuation of it.
        </p>
      </section>
    </article>

