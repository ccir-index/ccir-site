---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import {
  headlineRates, meta, headlineValue,
} from '../data/snapshot';
import type { Rate } from '../data/types';
import { bCurve, conCell } from '../data/term_b';
import { ivCards, IV_HAIRCUT } from '../lib/ivmodel';

// Calibrate against the global Neocloud B200 guaranteed on-demand series
// (John, 2026-09-24: B200, better numbers). Global over US: the US B200 panel
// is thin, and the global rate is where the /term ladder starts.
const REF_SERIES_ID = 'CRI-T2-B200-ALL-GTD-OD-ALL';
const ref = headlineRates.find((r) => r.series_id === REF_SERIES_ID);
// Headline stat per published convention: mean where the panel is deep
// (n>=10 sources), median below.
const closingRate = ref ? headlineValue(ref) : 0;
// Use case 03 watches the IMPLIED contracted rate (John, 2026-09-24): posted
// on-demand less the measured posted-to-contracted discount (/hardware). The
// posted series is the daily direction signal; contracts sign near the
// implied level.
const DISCOUNT = IV_HAIRCUT?.haircut ?? 0;
const impliedClose = closingRate * (1 - DISCOUNT);

const round5c = (n: number) => Math.round(n / 0.05) * 0.05;
const round1c = (n: number) => Math.round(n * 100) / 100;
const fmt = (n: number) => n.toFixed(2);

// Watch levels, set at close as a share of the implied contracted rate.
const LEVEL_2 = round5c(impliedClose * 0.92);
const LEVEL_3 = round5c(impliedClose * 0.80);
const LEVEL_4 = round5c(impliedClose * 0.69);

interface TrajRow {
  month: string;
  pct: number;
  value: number;
  level: 1 | 2 | 3 | 4;
  levelLabel: string;
  transition: boolean;
  improvement: boolean;
  response: string;
  check: string;
}
function classify(value: number): 1 | 2 | 3 | 4 {
  if (value >= LEVEL_2) return 1;
  if (value >= LEVEL_3) return 2;
  if (value >= LEVEL_4) return 3;
  return 4;
}
const LEVEL_LABELS: Record<number, string> = {
  1: 'Level 1 (Baseline)',
  2: 'Level 2 (Watch)',
  3: 'Level 3 (Review)',
  4: 'Level 4 (Escalate)',
};
const LEVEL_RESPONSES: Record<number, string> = {
  1: 'Quarterly price review; standard borrower reporting',
  2: 'Monthly price review; request the borrower\'s contract book',
  3: 'Monthly review; test debt service coverage at current rates; check reserve and sweep terms already in the facility',
  4: 'Credit committee review; stress re-leasing against the current term curve; weekly price tracking',
};
const levels = [
  { label: LEVEL_LABELS[1], range: `30-day average at or above $${fmt(LEVEL_2)}`, response: LEVEL_RESPONSES[1] },
  { label: LEVEL_LABELS[2], range: `$${fmt(LEVEL_3)} to $${fmt(LEVEL_2)}`, response: LEVEL_RESPONSES[2] },
  { label: LEVEL_LABELS[3], range: `$${fmt(LEVEL_4)} to $${fmt(LEVEL_3)}`, response: LEVEL_RESPONSES[3] },
  { label: LEVEL_LABELS[4], range: `Below $${fmt(LEVEL_4)}`, response: LEVEL_RESPONSES[4] },
];

const trajPcts: { month: string; pct: number; check: string }[] = [
  { month: 'Month 0 (Close)', pct: 1.00, check: 'Record the closing level and set watch levels' },
  { month: 'Month 3',         pct: 0.95, check: 'No change in posture' },
  { month: 'Month 6',         pct: 0.88, check: 'Check how much capacity sits under committed contracts' },
  { month: 'Month 9',         pct: 0.82, check: 'No change in posture' },
  { month: 'Month 12',        pct: 0.76, check: 'Recompute debt service coverage at the current 30-day average' },
  { month: 'Month 15',        pct: 0.71, check: 'No change in posture' },
  { month: 'Month 18',        pct: 0.65, check: 'Size re-leasing risk on contracts expiring within 12 months' },
  { month: 'Month 21',        pct: 0.74, check: 'Record the recovery; step review frequency back down' },
];
let prevLevel: 1 | 2 | 3 | 4 = 1;
const trajectory: TrajRow[] = trajPcts.map(({ month, pct, check }) => {
  const value = round1c(impliedClose * pct);
  const level = classify(value);
  const transition = level > prevLevel;
  const improvement = level < prevLevel;
  const row: TrajRow = {
    month, pct, value, level,
    levelLabel: LEVEL_LABELS[level],
    transition, improvement,
    response: LEVEL_RESPONSES[level],
    check,
  };
  prevLevel = level;
  return row;
});

// Use case 01: collateral value and loan-to-value from /hardware (John,
// 2026-09-24). The fleet is marked at the model value per GPU, with its range
// and the 2024-25 replay stress. LTV watch levels are illustrative.
const FLEET = 8000;
const FACILITY = 200_000_000;
const b200Card = ivCards.find((c) => c.model === 'B200');
const fleetValue = b200Card ? b200Card.base * FLEET : 0;
const ltv = fleetValue > 0 ? FACILITY / fleetValue : 0;
const fmtM = (n: number) => `$${Math.round(n / 1e6).toLocaleString('en-US')}M`;
const fmtK = (n: number) => `$${(n / 1000).toFixed(1)}k`;
const pctS = (x: number) => `${Math.round(x * 100)}%`;

const LTV_LEVELS = [0.80, 0.90, 1.00];
function ltvLevel(x: number): 1 | 2 | 3 | 4 {
  if (x <= LTV_LEVELS[0]) return 1;
  if (x <= LTV_LEVELS[1]) return 2;
  if (x <= LTV_LEVELS[2]) return 3;
  return 4;
}
const LTV_RESPONSES: Record<number, string> = {
  1: 'Quarterly value review; standard borrower reporting',
  2: 'Monthly value review; request the contract book',
  3: 'Monthly review; test coverage at current rates; check reserve and sweep terms already in the facility',
  4: 'Credit committee review; stress re-leasing; weekly value tracking',
};
const ltvLevels = [
  { label: LEVEL_LABELS[1], range: `LTV at or below ${pctS(LTV_LEVELS[0])}`, response: LTV_RESPONSES[1] },
  { label: LEVEL_LABELS[2], range: `${pctS(LTV_LEVELS[0])} to ${pctS(LTV_LEVELS[1])}`, response: LTV_RESPONSES[2] },
  { label: LEVEL_LABELS[3], range: `${pctS(LTV_LEVELS[1])} to ${pctS(LTV_LEVELS[2])}`, response: LTV_RESPONSES[3] },
  { label: LEVEL_LABELS[4], range: `Above ${pctS(LTV_LEVELS[2])}`, response: LTV_RESPONSES[4] },
];
const valueCases = b200Card ? [
  { name: 'Model value', per: b200Card.base },
  { name: 'Range, low', per: b200Card.lo },
  { name: 'Range, high', per: b200Card.hi },
  { name: 'Stress (2024–25 replay)', per: b200Card.intStress },
].map((c) => {
  const v = c.per * FLEET, x = FACILITY / v, lv = ltvLevel(x);
  return { ...c, value: v, ltv: x, level: lv, label: LEVEL_LABELS[lv] };
}) : [];

const exposureTerms: { term: string; value: string }[] = [
  { term: 'Borrower', value: 'A GPU-rich neocloud special-purpose entity (SPE)' },
  { term: 'Facility type', value: 'Senior-secured term loan' },
  { term: 'Facility size', value: '$200,000,000' },
  { term: 'Tenor', value: '4 years, scheduled amortization with bullet at maturity' },
  { term: 'Collateral', value: 'First-lien security interest in 1,000 B200 8-GPU nodes (8,000 GPUs)' },
  { term: 'Collateral value at close', value: `${fmtM(fleetValue)} at the CCIR model value of $${Math.round(b200Card?.base ?? 0).toLocaleString('en-US')} per GPU` },
  { term: 'Loan-to-value at close', value: pctS(ltv) },
  { term: 'Review date', value: 'Last business day of each month' },
];

// Pool: unit weights across generations, each marked at its own /hardware
// value. Same 8,000-GPU size as the single-chip example.
const POOL = [
  { chip: 'B200', weight: 0.50 },
  { chip: 'H200', weight: 0.30 },
  { chip: 'H100', weight: 0.20 },
];
const poolRows = POOL.map((p) => {
  const c = ivCards.find((x) => x.model === p.chip);
  return c ? { ...p, units: Math.round(p.weight * FLEET), per: c.base, stress: c.intStress } : null;
}).filter((r): r is NonNullable<typeof r> => r != null);
const poolValue = poolRows.reduce((a, r) => a + r.units * r.per, 0);
const poolStress = poolRows.reduce((a, r) => a + r.units * r.stress, 0);

// Use case 03 monitor terms.
const monitorTerms: { term: string; value: string }[] = [
  { term: 'Monitored series', value: `${REF_SERIES_ID}, published by CCIR (Neocloud operator segment, B200, guaranteed on-demand, global)` },
  { term: 'Posted level at close', value: `$${fmt(closingRate)} per GPU per hour (as of ${meta.as_of_date})` },
  { term: 'Posted-to-contracted discount', value: `${Math.round(DISCOUNT * 100)}%, measured across filed deals (/hardware)` },
  { term: 'Implied contracted rate at close', value: `$${fmt(impliedClose)} per GPU per hour` },
  { term: 'Smoothing', value: '30-day average of daily prints' },
  { term: 'Review date', value: 'Last business day of each month' },
];

// ---------------------------------------------------------------------------
// Use case 01: re-leasing (rollover) risk on B200 (John, 2026-09-24).
// Base re-lease is a RANGE: low = posted global neocloud on-demand (the
// /term ladder start) less the measured posted-to-contracted discount; high
// = the /term 2Y contracted cell (trailing 12 months). Triggers sit a set
// percentage below the low end. Either test input can trip them: the 30-day
// implied rate, or the rate in a new B200 filing on /term.
const b200Curve = bCurve('B200');
const anchorCell = conCell('B200', '2Y');
const ANCHOR_RATE = anchorCell?.rate ?? 0;
const postedOd = b200Curve.od?.value ?? 0;
const discount = DISCOUNT;
const reLeaseBase = postedOd * (1 - discount);
const baseLo = Math.min(reLeaseBase, ANCHOR_RATE || reLeaseBase);
const baseHi = Math.max(reLeaseBase, ANCHOR_RATE);
const WATCH_PCT = 0.10, TRIGGER_PCT = 0.20;
const watchRate = baseLo * (1 - WATCH_PCT);
const triggerRate = baseLo * (1 - TRIGGER_PCT);

// Stylized facility for the rollover exhibit. Anchor share and closing DSCR
// are illustrative; every rate is live.
const FLEET_GPUS = FLEET;           // 1,000 8-GPU nodes
const ANCHOR_SHARE = 0.70;          // capacity under the expiring anchor contract
const CLOSE_DSCR = 1.45;            // DSCR at close, on total contracted book
// At close the rest of the fleet sells at the implied rate. At rollover the
// whole fleet reprices.
const revClose = ANCHOR_SHARE * ANCHOR_RATE + (1 - ANCHOR_SHARE) * reLeaseBase;
const dscrAt = (rate: number) => (revClose > 0 ? (rate / revClose) * CLOSE_DSCR : 0);

// ---------------------------------------------------------------------------
// UC01 history: the watch levels run against reconstructed history. Rates are
// the stepped-panel monthly medians from the archived-page backfill
// (/research/od-vs-committed), NOT the live series; close = 2024-02 at $4.30,
// levels at 92/80/69% of close rounded to $0.05: 3.95 / 3.45 / 2.95.
const BACKTEST_CLOSE = 4.30;
const backtest: { period: string; rate: string; level: string; cls: string; posture: string }[] = [
  { period: 'Feb – Jun 2024', rate: '$4.30', level: 'Level 1 · Baseline', cls: 't1', posture: 'Quarterly review' },
  { period: 'Jul – Aug 2024', rate: '$3.92 → $3.49', level: 'Level 2 · Watch', cls: 't2', posture: 'Monthly review; contract book requested' },
  { period: 'Sep – Nov 2024', rate: '$3.24 → $2.99', level: 'Level 3 · Review', cls: 't3', posture: 'Debt service coverage tested at current rates' },
  { period: 'Dec 2024 – Nov 2025', rate: '$2.79 – $2.92', level: 'Level 4 · Escalate (12 months)', cls: 't4', posture: 'Committee review; re-leasing stressed against the term curve' },
  { period: 'Dec 2025 – Feb 2026', rate: '$3.18', level: 'Level 3 · improvement', cls: 't3', posture: 'Review frequency steps down' },
  { period: 'Mar – Apr 2026', rate: '$3.74', level: 'Level 2', cls: 't2', posture: 'Further step-down' },
  { period: 'May 2026', rate: '$3.98', level: 'Level 1 · restored', cls: 't1', posture: 'Back to quarterly review' },
  { period: 'Jun 2026', rate: '$3.39', level: 'Level 3 · re-tightening', cls: 't3', posture: 'Sharp one-month drop; the 15% fast-move check applies' },
];

// On-page contents. ids match the anchored use-case articles and section h3s.
const toc: { id: string; kicker: string; label: string; secs: string[][] }[] = [
  {
    id: 'uc-01',
    kicker: 'Use case 01',
    label: 'Re-Leasing Risk Sized Against the Term Curve',
    secs: [
      ['uc-01-s01', 'Why Rollover Is the Central Credit Question'],
      ['uc-01-s02', 'Worked Rollover Exhibit'],
      ['uc-01-s03', 'What to Watch and When'],
      ['uc-01-s04', 'Limitations'],
    ],
  },
  {
    id: 'uc-02',
    kicker: 'Use case 02',
    label: 'Collateral Value and Loan-to-Value',
    secs: [
      ['uc-02-s01', 'Why Mark the Collateral'],
      ['uc-02-s02', 'Hypothetical Exposure'],
      ['uc-02-s03', 'Value, Range and Stress'],
      ['uc-02-s04', 'Mixed-Generation Pools'],
      ['uc-02-s05', 'Limitations'],
    ],
  },
  {
    id: 'uc-03',
    kicker: 'Use case 03',
    label: 'Watching Market Direction',
    secs: [
      ['uc-03-s01', 'Why Watch the Daily Rate'],
      ['uc-03-s02', 'The Monitor'],
      ['uc-03-s03', 'Setting Watch Levels'],
      ['uc-03-s04', 'Worked Numerical Example'],
      ['uc-03-s05', 'The Watch Levels Against Three Years of History'],
      ['uc-03-s06', 'Weighting by Exposed Capacity'],
      ['uc-03-s07', 'Limitations'],
    ],
  },
  {
    id: 'data-note',
    kicker: 'Note',
    label: 'How to Reference CCIR Data',
    secs: [],
  },
];
---
<Base
  title="Monitoring GPU-Backed Credit with Market Data · CCIR"
  ogImage="/og/applications.png"
  description="Worked examples showing how lenders, credit analysts and risk teams can use CCIR's published data to monitor GPU-backed exposures: re-leasing risk sized against contracted and posted term rates, collateral value and loan-to-value, and market direction from the daily rate."
>
  <nav class="apps-navband" aria-label="Use cases">
    <div class="wrap apps-nav-inner">
      {toc.map((u) => (
        <a class="apps-nav-link" href={'#' + u.id}>
          <span class="apps-nav-n">{u.kicker.replace('Use case ', 'UC')}</span> {u.label}
        </a>
      ))}
    </div>
  </nav>
  <section class="wrap page-top">
    <PageHeader title="Applications" kicker="Worked Monitoring Examples" asOf={meta.as_of_date} display />
    <p class="dek">
      Worked examples showing how lenders, credit analysts and risk teams can
      use CCIR's published market data to monitor GPU-backed exposures. Each
      example uses a specific CCIR data series and calibrates to today's
      snapshot.
    </p>

    <nav class="toc" id="contents" aria-label="Contents">
      <div class="toc-kicker">Contents</div>
      <div class="toc-grid">
        {toc.map((u) => (
          <div class="toc-group">
            <a class="toc-uc" href={'#' + u.id}>
              <span class="toc-uc-kicker">{u.kicker}</span>
              {u.label}
            </a>
            {u.secs.length > 0 && (
              <ol class="toc-secs">
                {u.secs.map((s) => (
                  <li><a href={'#' + s[0]}>{s[1]}</a></li>
                ))}
              </ol>
            )}
          </div>
        ))}
      </div>
    </nav>

    <article class="usecase" id="uc-01">
      <header class="uc-head">
        <span class="uc-kicker">Use case 01 · Contract rollover</span>
        <h2>Re-Leasing Risk Sized Against the Published Term Curve</h2>
        <p class="uc-lede">
          A worked example of contract rollover in GPU-backed lending. A
          borrower's anchor customer contract expires mid-loan. The freed
          capacity must be re-leased at then-prevailing rates. A lender
          watching this risk can size it against the published term curve
          months before the contract expires. The approach mirrors the
          market-rent assumptions used in commercial real estate and aircraft
          leasing. The example is illustrative.
        </p>
      </header>

      <section class="uc-rate">
        <div class="rate-kicker">Base re-lease range (live, calibrating this example)</div>
        <div class="rate-id">B200 · global Neocloud</div>
        <div class="rate-price">${fmt(baseLo)}–${fmt(baseHi)}<span class="rate-unit">/GPU-hr</span></div>
        <div class="rate-meta">
          Posted on-demand less the measured discount, to contracted 2Y on <a href="/term">/term</a>
          <span class="sep">·</span>
          as of {meta.as_of_date}
        </div>
        <div class="rate-thresholds">
          <span><strong>Watch</strong> ${fmt(watchRate)} <span class="dim">({Math.round(WATCH_PCT * 100)}% below)</span></span>
          <span><strong>Trigger</strong> ${fmt(triggerRate)} <span class="dim">({Math.round(TRIGGER_PCT * 100)}% below)</span></span>
        </div>
      </section>

      <section class="sec">
        <h3 id="uc-01-s01"><span class="sec-n">01</span> Why Rollover Is the Central Credit Question</h3>
        <p>
          Customer contracts usually run two to five years. The facilities
          they support often mature later. The capacity behind the loan must
          then be re-contracted at least once before repayment. No one has
          locked that future rate, and few tools exist to hedge it. What the
          capacity earns on re-lease is the credit question.
        </p>
        <p>
          Two published numbers bound the base case. The low end is the
          posted on-demand rate less the measured gap between posted and
          contracted prices. The high end is what B200 contracts signed at
          over the last 12 months, from <a href="/term">/term</a>. The
          lender sets triggers a fixed percentage below the low end.
        </p>
        <p>
          Commercial real estate lenders handle the same question with
          market-rent assumptions. Aircraft lessors use appraiser-published
          re-leasing rates. For GPUs, the market rent is observable daily.
        </p>
      </section>

      <section class="sec">
        <h3 id="uc-01-s02"><span class="sec-n">02</span> Worked Rollover Exhibit</h3>
        <p class="calib-note">
          Calibration: stylized facility of {FLEET_GPUS.toLocaleString('en-US')} B200
          GPUs (1,000 nodes). {(ANCHOR_SHARE * 100).toFixed(0)}% of capacity
          sits under a 2-year anchor contract at the /term 2Y contracted rate
          of ${fmt(ANCHOR_RATE)}. The rest sells at the implied rate of
          ${fmt(reLeaseBase)}.
          DSCR at close {CLOSE_DSCR.toFixed(2)}x. At rollover the whole fleet
          reprices. Margins and debt service stay constant to isolate the
          price effect. Every rate is live as of {meta.as_of_date}.
        </p>
        <div class="ftable-wrap">
          <table class="ftable">
            <thead><tr><th>Case at rollover</th><th class="num">Rate $/GPU-hr</th><th class="num">DSCR</th><th>Response</th></tr></thead>
            <tbody>
              <tr><td>At close</td><td class="num">{fmt(ANCHOR_RATE)}</td><td class="num">{CLOSE_DSCR.toFixed(2)}x</td><td>Record the base range</td></tr>
              <tr><td>Base range</td><td class="num">{fmt(baseLo)}–{fmt(baseHi)}</td><td class="num">{dscrAt(baseLo).toFixed(2)}x–{dscrAt(baseHi).toFixed(2)}x</td><td>Standard review</td></tr>
              <tr><td>Watch, {Math.round(WATCH_PCT * 100)}% below the low end</td><td class="num">{fmt(watchRate)}</td><td class="num">{dscrAt(watchRate).toFixed(2)}x</td><td>Monthly review; request the re-leasing pipeline</td></tr>
              <tr><td>Trigger, {Math.round(TRIGGER_PCT * 100)}% below the low end</td><td class="num">{fmt(triggerRate)}</td><td class="num"><strong>{dscrAt(triggerRate).toFixed(2)}x</strong></td><td>Coverage test; reserve and sweep terms</td></tr>
            </tbody>
          </table>
        </div>
        <p>
          <strong>The trigger lands where coverage breaks.</strong> At
          {Math.round(TRIGGER_PCT * 100)}% below the low end, projected DSCR
          falls under 1.20x. The lender can see that point months before the
          contract expires, from published data and the borrower's contract
          book.
        </p>
      </section>

      <section class="sec">
        <h3 id="uc-01-s03"><span class="sec-n">03</span> What to Watch and When</h3>
        <p>
          A lender tracking rollover risk might follow a simple routine.
        </p>
        <p>
          <strong>Start 180 days out.</strong> Begin the rollover check 180
          days before any contract that supplies 20% or more of gross rental
          revenue expires. Repeat it monthly until the contract is replaced or
          renewed.
        </p>
        <p>
          <strong>Two inputs can trip the trigger.</strong> The first is the
          30-day average of the implied rate: posted on-demand less the
          measured discount. The second is the rate in any new B200 filing on
          <a href="/term">/term</a>. Either one below the watch or trigger
          level sets the response.
        </p>
        <p>
          <strong>Re-price only the expiring block.</strong> Hold every other
          contract at its contracted rate. Re-price the expiring capacity at
          the current test rate. Compare projected cash flow with scheduled
          debt service.
        </p>
        <p>
          <strong>Every moving input comes from outside the borrower.</strong>
          The rates come from published data. The check date comes from the
          contract calendar.
        </p>
      </section>

      <section class="sec">
        <h3 id="uc-01-s04"><span class="sec-n">04</span> Limitations</h3>
        <p>
          <strong>This is illustrative.</strong> Fleet size, anchor share and
          closing DSCR are stylized. The contracted rate rests on a few filed
          deals. The posted-to-contracted discount is measured across chips
          and tenors, and a single deal can sit well above or below it. The
          10% and 20% trigger distances are examples. Utilization on
          re-leased capacity stays at the contracted level. Any contractual
          terms are for the parties and their counsel.
        </p>
      </section>

    </article>

    <article class="usecase" id="uc-02">
      <header class="uc-head">
        <span class="uc-kicker">Use case 02 · Senior-secured term loan</span>
        <h2>Collateral Value and Loan-to-Value</h2>
        <p class="uc-lede">
          A worked example of marking GPU collateral at a published model
          value. The lender tracks loan-to-value against levels set at close.
          Each level maps to a monitoring response. The example is
          illustrative. It is not a model form or a recommended practice.
        </p>
      </header>

      <section class="uc-rate">
        <div class="rate-kicker">Collateral value (live, calibrating this example)</div>
        <div class="rate-id">1,000 B200 nodes · 8,000 GPUs · <a href="/hardware">/hardware</a></div>
        <div class="rate-price">{fmtM(fleetValue)}<span class="rate-unit"> · LTV {pctS(ltv)}</span></div>
        <div class="rate-meta">
          Model value {fmtK(b200Card?.base ?? 0)} per GPU
          <span class="sep">·</span>
          as of {meta.as_of_date}
        </div>
        <div class="rate-thresholds">
          <span><strong>Level 2 watch</strong> LTV above {pctS(LTV_LEVELS[0])}</span>
          <span><strong>Level 3 watch</strong> above {pctS(LTV_LEVELS[1])}</span>
          <span><strong>Level 4 watch</strong> above {pctS(LTV_LEVELS[2])}</span>
        </div>
      </section>

      <section class="sec">
        <h3 id="uc-02-s01"><span class="sec-n">01</span> Why Mark the Collateral</h3>
        <p>
          A GPU is worth what it can earn over its remaining life. The
          <a href="/hardware">/hardware</a> model values each chip on that
          basis. It uses contracted rates where enough deals are on file, a
          disclosed discount rate and a disclosed life. Asks, sales and
          new-chip prices sit beside it as checks.
        </p>
        <p>
          Most credit documents amortize GPU collateral on a fixed schedule.
          A published value gives the lender a second view that moves with
          the market. It comes with a range and a stress case, so the lender
          can see how much cushion the loan has in each.
        </p>
      </section>

      <section class="sec">
        <h3 id="uc-02-s02"><span class="sec-n">02</span> Hypothetical Exposure</h3>
        <div class="ftable-wrap">
          <table class="ftable">
            <tbody>
              {exposureTerms.map(({ term, value }) => (
                <tr>
                  <th>{term}</th>
                  <td>{value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="sec">
        <h3 id="uc-02-s03"><span class="sec-n">03</span> Value, Range and Stress</h3>
        <p>
          The example sets loan-to-value levels at {pctS(LTV_LEVELS[0])},
          {' '}{pctS(LTV_LEVELS[1])} and {pctS(LTV_LEVELS[2])}. The table marks
          the fleet at the model value, both ends of its range and the stress
          case. The stress case assumes no contract and replays the 2024–25
          H100 decline, when on-demand rates fell 61% in 18 months.
        </p>
        <div class="ftable-wrap">
          <table class="ftable">
            <thead>
              <tr><th>Level</th><th>LTV range</th><th>Monitoring response</th></tr>
            </thead>
            <tbody>
              {ltvLevels.map((l) => (
                <tr>
                  <td class="feat">{l.label}</td>
                  <td>{l.range}</td>
                  <td>{l.response}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="ftable-wrap">
          <table class="traj">
            <thead>
              <tr><th>Case</th><th class="num">Per GPU</th><th class="num">Fleet value</th><th class="num">LTV</th><th>Level</th></tr>
            </thead>
            <tbody>
              {valueCases.map((c) => (
                <tr>
                  <td>{c.name}</td>
                  <td class="num">{fmtK(c.per)}</td>
                  <td class="num">{fmtM(c.value)}</td>
                  <td class="num">{pctS(c.ltv)}</td>
                  <td class={`tier tier-${c.level}`}>{c.label}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p>
          <strong>The stress case is where the cushion shows.</strong> A loan
          that sits at baseline on the model value can move to escalation if
          the fleet loses its contracts in a downturn. The contract book is
          what protects the lender, and Use case 01 sizes that risk.
        </p>
        <p>
          The value is recomputed with each daily data refresh. The levels in
          this example set monitoring responses only. They have no
          contractual effect.
        </p>
      </section>

      <section class="sec">
        <h3 id="uc-02-s04"><span class="sec-n">04</span> Mixed-Generation Pools</h3>
        <p>
          Warehouse and securitized pools usually hold several generations.
          Each generation is marked at its own model value and weighted by
          its units in the asset schedule. The same loan-to-value levels
          apply to the pool.
        </p>
        <div class="ftable-wrap">
          <table class="traj">
            <thead>
              <tr><th>Generation</th><th class="num">Units</th><th class="num">Per GPU</th><th class="num">Value</th><th class="num">Stress</th></tr>
            </thead>
            <tbody>
              {poolRows.map((r) => (
                <tr>
                  <td>{r.chip}</td>
                  <td class="num">{r.units.toLocaleString('en-US')}</td>
                  <td class="num">{fmtK(r.per)}</td>
                  <td class="num">{fmtM(r.units * r.per)}</td>
                  <td class="num">{fmtM(r.units * r.stress)}</td>
                </tr>
              ))}
              <tr>
                <td><strong>Pool</strong></td>
                <td class="num">{FLEET.toLocaleString('en-US')}</td>
                <td class="num">{fmtK(poolValue / FLEET)}</td>
                <td class="num"><strong>{fmtM(poolValue)}</strong></td>
                <td class="num">{fmtM(poolStress)}</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p>
          Surveillance watches the pool value against its closing level, mix
          drift in the servicer report, and whether substitutions entered on
          schedule. A generation without a published value stays outside the
          pool mark until one publishes.
        </p>
      </section>

      <section class="sec">
        <h3 id="uc-02-s05"><span class="sec-n">05</span> Limitations</h3>
        <p>
          <strong>This is illustrative.</strong> The exposure, levels and
          responses are designed for clarity. The value is a model output with
          every assumption disclosed on <a href="/hardware">/hardware</a>. It
          is not an appraisal. B300, B200 and H200 values are modeled only,
          with no sales record yet to check them against.
        </p>
      </section>
    </article>

    <article class="usecase" id="uc-03">
      <header class="uc-head">
        <span class="uc-kicker">Use case 03 · Daily monitoring</span>
        <h2>Watching Market Direction</h2>
        <p class="uc-lede">
          The posted rate is the only GPU price published every day. Contracts
          sign well below it, so the monitor watches the implied contracted
          rate: the posted rate less the measured posted-to-contracted
          discount. Watch levels below the closing level map to monitoring
          responses. The example is illustrative. It is not a model form or
          a recommended practice.
        </p>
      </header>

      <section class="uc-rate">
        <div class="rate-kicker">Implied contracted rate (live, calibrating this example)</div>
        <div class="rate-id">{REF_SERIES_ID}</div>
        <div class="rate-price">${fmt(impliedClose)}<span class="rate-unit">/GPU-hr · implied contracted</span></div>
        <div class="rate-meta">
          Posted ${fmt(closingRate)} less the measured {Math.round(DISCOUNT * 100)}% discount
          <span class="sep">·</span>
          Neocloud · B200 · Guaranteed on-demand · Global
          <span class="sep">·</span>
          as of {meta.as_of_date}
        </div>
        <div class="rate-thresholds">
          <span><strong>Level 2 watch</strong> ${fmt(LEVEL_2)} <span class="dim">(92%)</span></span>
          <span><strong>Level 3 watch</strong> ${fmt(LEVEL_3)} <span class="dim">(80%)</span></span>
          <span><strong>Level 4 watch</strong> ${fmt(LEVEL_4)} <span class="dim">(69%)</span></span>
        </div>
      </section>

      <section class="sec">
        <h3 id="uc-03-s01"><span class="sec-n">01</span> Why Watch the Daily Rate</h3>
        <p>
          Contracted rates arrive a few filings at a time, often months apart.
          The posted on-demand rate prints every day. It sits well above what
          contracts sign at, so its level overstates what a fleet earns. Its
          direction is the early read. CCIR's archived history shows the gap
          between posted on-demand and posted committed prices held roughly
          steady from 2024 to 2026.
        </p>
        <p>
          The monitor therefore converts the posted rate to an implied
          contracted rate. It applies the posted-to-contracted discount
          measured across filed deals, {Math.round(DISCOUNT * 100)}% today. The
          implied rate sits near the borrower's own contract book, so watch
          levels on it read in the same units as the revenue.
        </p>
        <p>
          Commodity lenders already work this way. Reserve-based lenders watch
          oil and gas strip prices. Other commodity lenders track Henry Hub,
          Platts assessments and LME cash prices. Watch levels turn the series
          into a routine. The lender fixes the levels at close. Small moves
          prompt a closer look, and large moves prompt a full review.
        </p>
      </section>

      <section class="sec">
        <h3 id="uc-03-s02"><span class="sec-n">02</span> The Monitor</h3>
        <div class="ftable-wrap">
          <table class="ftable">
            <tbody>
              {monitorTerms.map(({ term, value }) => (
                <tr>
                  <th>{term}</th>
                  <td>{value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="sec">
        <h3 id="uc-03-s03"><span class="sec-n">03</span> Setting Watch Levels</h3>
        <p>
          The example sets three watch levels at 92%, 80% and 69% of the
          implied contracted rate at close, rounded to the nearest $0.05. The monitor tests the
          30-day average of daily prints on the last business day of each
          month. The average smooths day-to-day changes in panel composition.
        </p>
        <div class="ftable-wrap">
          <table class="ftable">
            <thead>
              <tr>
                <th>Level</th>
                <th>Series range</th>
                <th>Monitoring response</th>
              </tr>
            </thead>
            <tbody>
              {levels.map((l) => (
                <tr>
                  <td class="feat">{l.label}</td>
                  <td>{l.range}</td>
                  <td>{l.response}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p>
          The monitor also runs a fast-move check between review dates. If a
          daily print falls more than 15% below the last 30-day average, the
          lender reviews early. Without this check, a sharp fall early in the
          month would wait weeks for the next review.
        </p>
        <p>
          The levels in this example set monitoring responses only. They have
          no contractual effect. Any contractual terms in a facility are for
          the parties and their counsel.
        </p>
      </section>

      <section class="sec">
        <h3 id="uc-03-s04"><span class="sec-n">04</span> Worked Numerical Example</h3>
        <p class="calib-note">
          Calibration: an implied contracted rate at close of
          <strong>${fmt(impliedClose)}</strong> per GPU per hour
          ({REF_SERIES_ID} at ${fmt(closingRate)} on {meta.as_of_date}, less
          the {Math.round(DISCOUNT * 100)}% discount). The path is stylized
          over 24 months.
        </p>
        <div class="ftable-wrap">
          <table class="traj">
            <thead>
              <tr>
                <th>Review Date</th>
                <th class="num">30-Day Avg</th>
                <th class="num">% of Close</th>
                <th>Level</th>
                <th>Monitoring Response</th>
                <th>What the Monitor Checks</th>
              </tr>
            </thead>
            <tbody>
              {trajectory.map((r) => (
                <tr class={r.transition ? 'transition' : r.improvement ? 'improvement' : ''}>
                  <td>{r.month}</td>
                  <td class="num">${fmt(r.value)}</td>
                  <td class="num">{(r.pct * 100).toFixed(0)}%</td>
                  <td class={`tier tier-${r.level} ${r.transition ? 'tier-transition' : ''} ${r.improvement ? 'tier-improvement' : ''}`}>
                    {r.levelLabel}
                  </td>
                  <td class="reqs">{r.response}</td>
                  <td class="cure">{r.check}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p>
          <strong>The series sets the pace of review.</strong> Each change in
          level comes from the published data. The lender decides in advance
          what each level means for its own process.
        </p>
        <p>
          <strong>Some checks take longer than others.</strong> A price review
          takes a day. Gathering a contract book or rerunning a coverage model
          takes weeks. Staged levels give the lender time to prepare each step.
        </p>
        <p>
          <strong>Recovery steps the review back down.</strong> When the rate
          recovers (Month 21 in the example), review frequency falls back. The
          lender records the recovery with the data that drove it.
        </p>
      </section>

      <section class="sec">
        <h3 id="uc-03-s05"><span class="sec-n">05</span> The Watch Levels Against Three Years of History</h3>
        <p>
          B200 has not yet been through a full price cycle. H100 has, so this
          section runs the same watch structure on H100 history in place of
          a stylized path. With a steady discount, the posted and implied
          rates cross each level on the same dates. Rates are the monthly neocloud H100 guaranteed
          on-demand medians from CCIR's archived-page backfill
          (<a href="/research/od-vs-committed">On-Demand vs Committed, Three
          Years</a>). The exposure starts in February 2024 at
          ${fmt(BACKTEST_CLOSE)}. Watch levels sit at 92% / 80% / 69% of that
          level ($3.95 / $3.45 / $2.95).
        </p>
        <div class="ftable-wrap">
          <table class="traj">
            <thead>
              <tr><th>Period</th><th class="num">Series level</th><th>Level</th><th>Monitoring posture</th></tr>
            </thead>
            <tbody>
              {backtest.map((r) => (
                <tr>
                  <td>{r.period}</td>
                  <td class="num">{r.rate}</td>
                  <td class={`tier tier-${r.cls.slice(1)}`}>{r.level}</td>
                  <td class="reqs">{r.posture}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p>
          <strong>Twelve months at Level 4.</strong> Through the 2025 price
          floor, a lender following this routine would have run its fullest
          review for a year. When the market turned in December 2025, the
          posture stepped down. It reached baseline by May 2026.
        </p>
        <p>
          <strong>Every change in level came from the published data.</strong>
          The record shows eight level changes in twenty-nine months. Each one
          traces to a monthly print.
        </p>
        <p class="calib-note">
          Calibration notes: the exhibit uses monthly stepped-panel medians in
          place of the 30-day daily average. The backfill panel is thin early.
          It uses a different collection method from the live daily series,
          and no splicing is implied. The single-month drop in June 2026 shows
          why the routine smooths on a 30-day average and adds a 15% fast-move
          check.
        </p>
      </section>

      <section class="sec">
        <h3 id="uc-03-s06"><span class="sec-n">06</span> Weighting by Exposed Capacity</h3>
        <p>
          A heavily contracted borrower's revenue does not move with the
          market. The monitor can blend the two. Contracted capacity counts at
          its contract rate. Exposed capacity counts at the implied contracted
          rate. Exposed capacity is anything uncontracted or under a contract
          that expires within 12 months. The monitor compares the blended rate
          with the watch levels.
        </p>
        <p>
          The blend tracks contract expiry. Far from expiry, the market touches
          only the uncontracted share. As contracts approach expiry, more
          capacity is exposed, and the same market level weighs more heavily.
          The blend needs a monthly schedule of contracted rates, covered
          capacity and expiry dates from the borrower. The rollover exhibit in
          Use case 01 uses the same inputs.
        </p>
      </section>

      <section class="sec">
        <h3 id="uc-03-s07"><span class="sec-n">07</span> Limitations</h3>
        <p>
          <strong>This is illustrative.</strong> The hypothetical exposure,
          dollar levels, breakpoints and responses are designed for clarity. A
          real monitoring program depends on the borrower, the pool, the
          facility terms and market conditions.
        </p>
        <p>
          <strong>Watch-level calibration is the central judgment.</strong> The
          example uses 92% / 80% / 69% of the closing level. A lender might
          instead use absolute dollar levels or a mix of both.
        </p>
        <p>
          <strong>The discount is measured today.</strong> It comes from the
          deals on file across chips and tenors. It may widen or narrow over
          time, and new filings on <a href="/term">/term</a> show which way.
        </p>
      </section>
    </article>

    <article class="usecase" id="data-note">
      <header class="uc-head">
        <span class="uc-kicker">Note · Using CCIR data</span>
        <h2>How to Reference CCIR Data</h2>
        <p class="uc-lede">
          CCIR publishes market data and research for information and
          monitoring. When a report or internal policy uses a CCIR series, cite
          the series ID, the publication date and the methodology version in
