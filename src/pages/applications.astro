---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { meta } from '../data/snapshot';
import { bCurve, conCell } from '../data/term_b';
import { ivCards, IV_HAIRCUT } from '../lib/ivmodel';

// Series cited in the data note: the global Neocloud B200 guaranteed on-demand.
const REF_SERIES_ID = 'CRI-T2-B200-ALL-GTD-OD-ALL';
// Measured posted-to-contracted discount (/hardware), used by Use case 01.
const DISCOUNT = IV_HAIRCUT?.haircut ?? 0;

const fmt = (n: number) => n.toFixed(2);

const LEVEL_LABELS: Record<number, string> = {
  1: 'Level 1 (Baseline)',
  2: 'Level 2 (Watch)',
  3: 'Level 3 (Review)',
  4: 'Level 4 (Escalate)',
};
// Use case 02: collateral value and loan-to-value from /hardware (John,
// 2026-09-24). The fleet is marked at the model value per GPU, with its range.
// Stress case pulled from live (John, 2026-09-26). LTV watch levels are illustrative.
const FLEET = 8000;
const FACILITY = 200_000_000;
const b200Card = ivCards.find((c) => c.model === 'B200');
const fleetValue = b200Card ? b200Card.base * FLEET : 0;
const ltv = fleetValue > 0 ? FACILITY / fleetValue : 0;
const fmtM = (n: number) => `$${Math.round(n / 1e6).toLocaleString('en-US')}M`;
const fmtK = (n: number) => `$${(n / 1000).toFixed(1)}k`;
const pctS = (x: number) => `${Math.round(x * 100)}%`;

const LTV_LEVELS = [0.80, 0.90, 1.00];
function ltvLevel(x: number): 1 | 2 | 3 | 4 {
  if (x <= LTV_LEVELS[0]) return 1;
  if (x <= LTV_LEVELS[1]) return 2;
  if (x <= LTV_LEVELS[2]) return 3;
  return 4;
}
const LTV_RESPONSES: Record<number, string> = {
  1: 'Quarterly value review; standard borrower reporting',
  2: 'Monthly value review; request the contract book',
  3: 'Monthly review; test coverage at current rates; check reserve and sweep terms already in the facility',
  4: 'Credit committee review; stress re-leasing; weekly value tracking',
};
const ltvLevels = [
  { label: LEVEL_LABELS[1], range: `LTV at or below ${pctS(LTV_LEVELS[0])}`, response: LTV_RESPONSES[1] },
  { label: LEVEL_LABELS[2], range: `${pctS(LTV_LEVELS[0])} to ${pctS(LTV_LEVELS[1])}`, response: LTV_RESPONSES[2] },
  { label: LEVEL_LABELS[3], range: `${pctS(LTV_LEVELS[1])} to ${pctS(LTV_LEVELS[2])}`, response: LTV_RESPONSES[3] },
  { label: LEVEL_LABELS[4], range: `Above ${pctS(LTV_LEVELS[2])}`, response: LTV_RESPONSES[4] },
];
const valueCases = b200Card ? [
  { name: 'Model value', per: b200Card.base },
  { name: 'Range, low', per: b200Card.lo },
  { name: 'Range, high', per: b200Card.hi },
].map((c) => {
  const v = c.per * FLEET, x = FACILITY / v, lv = ltvLevel(x);
  return { ...c, value: v, ltv: x, level: lv, label: LEVEL_LABELS[lv] };
}) : [];

const exposureTerms: { term: string; value: string }[] = [
  { term: 'Borrower', value: 'A GPU-rich neocloud special-purpose entity (SPE)' },
  { term: 'Facility type', value: 'Senior-secured term loan' },
  { term: 'Facility size', value: '$200,000,000' },
  { term: 'Tenor', value: '4 years, scheduled amortization with bullet at maturity' },
  { term: 'Collateral', value: 'First-lien security interest in 1,000 B200 8-GPU nodes (8,000 GPUs)' },
  { term: 'Collateral value at close', value: `${fmtM(fleetValue)} at the CCIR model value of $${Math.round(b200Card?.base ?? 0).toLocaleString('en-US')} per GPU` },
  { term: 'Loan-to-value at close', value: pctS(ltv) },
  { term: 'Review date', value: 'Last business day of each month' },
];

// Pool: unit weights across generations, each marked at its own /hardware
// value. Same 8,000-GPU size as the single-chip example.
const POOL = [
  { chip: 'B200', weight: 0.50 },
  { chip: 'H200', weight: 0.30 },
  { chip: 'H100', weight: 0.20 },
];
const poolRows = POOL.map((p) => {
  const c = ivCards.find((x) => x.model === p.chip);
  return c ? { ...p, units: Math.round(p.weight * FLEET), per: c.base } : null;
}).filter((r): r is NonNullable<typeof r> => r != null);
const poolValue = poolRows.reduce((a, r) => a + r.units * r.per, 0);

// ---------------------------------------------------------------------------
// Use case 01: re-leasing (rollover) risk on B200 (John, 2026-09-24).
// Base re-lease is a RANGE: low = posted global neocloud on-demand (the
// /term ladder start) less the measured posted-to-contracted discount; high
// = the /term 2Y contracted cell (trailing 12 months). Triggers sit a set
// percentage below the low end. Either test input can trip them: the 30-day
// implied rate, or the rate in a new B200 filing on /term.
const b200Curve = bCurve('B200');
const anchorCell = conCell('B200', '2Y');
const ANCHOR_RATE = anchorCell?.rate ?? 0;
const postedOd = b200Curve.od?.value ?? 0;
const discount = DISCOUNT;
const reLeaseBase = postedOd * (1 - discount);
const baseLo = Math.min(reLeaseBase, ANCHOR_RATE || reLeaseBase);
const baseHi = Math.max(reLeaseBase, ANCHOR_RATE);
const WATCH_PCT = 0.10, TRIGGER_PCT = 0.20;
const watchRate = baseLo * (1 - WATCH_PCT);
const triggerRate = baseLo * (1 - TRIGGER_PCT);

// Stylized facility for the rollover exhibit. Anchor share and closing DSCR
// are illustrative; every rate is live.
const FLEET_GPUS = FLEET;           // 1,000 8-GPU nodes
const ANCHOR_SHARE = 0.70;          // capacity under the expiring anchor contract
const CLOSE_DSCR = 1.45;            // DSCR at close, on total contracted book
// At close the rest of the fleet sells at the implied rate. At rollover the
// whole fleet reprices.
const revClose = ANCHOR_SHARE * ANCHOR_RATE + (1 - ANCHOR_SHARE) * reLeaseBase;
const dscrAt = (rate: number) => (revClose > 0 ? (rate / revClose) * CLOSE_DSCR : 0);

// ---------------------------------------------------------------------------
// Use case 01 history (John, 2026-09-24): the 10% / 20% re-leasing levels
// run on H100, the only chip with a full cycle. Rates are the stepped-panel
// monthly posted medians from the archived-page backfill
// (/research/od-vs-committed), NOT the live series. Close = 2024-02 at $4.30.
// Levels sit at 90% / 80% of the posted close; the table ends Feb 2026
// (John, 2026-09-24: one full two-year cycle).
const BACKTEST_CLOSE = 4.30;
const backtest: { period: string; rate: string; level: string; cls: string }[] = [
  { period: 'Feb 2024 (close)', rate: '$4.30', level: 'Base', cls: 't1' },
  { period: 'Aug 2024', rate: '$3.49', level: 'Watch', cls: 't2' },
  { period: 'Sep 2024 – Feb 2026', rate: '$3.24 → $2.79 → $3.18', level: 'Trigger (18 months)', cls: 't4' },
];

// On-page contents. ids match the anchored use-case articles and section h3s.
const toc: { id: string; kicker: string; label: string; secs: string[][] }[] = [
  {
    id: 'uc-01',
    kicker: 'Use case 01',
    label: 'Re-Leasing Risk Sized Against the Term Curve',
    secs: [
      ['uc-01-s01', 'Why Rollover Is the Central Credit Question'],
      ['uc-01-s02', 'Worked Rollover Exhibit'],
      ['uc-01-s03', 'What to Watch and When'],
      ['uc-01-s04', 'The Levels Against Three Years of History'],
      ['uc-01-s05', 'Weighting by Exposed Capacity'],
      ['uc-01-s06', 'Limitations'],
    ],
  },
  {
    id: 'uc-02',
    kicker: 'Use case 02',
    label: 'Collateral Value and Loan-to-Value',
    secs: [
      ['uc-02-s01', 'Why Mark the Collateral'],
      ['uc-02-s02', 'Hypothetical Exposure'],
      ['uc-02-s03', 'Value and Range'],
      ['uc-02-s04', 'Mixed-Generation Pools'],
      ['uc-02-s05', 'Limitations'],
    ],
  },
  {
    id: 'data-note',
    kicker: 'Note',
    label: 'How to Reference CCIR Data',
    secs: [],
  },
];
---
<Base
  title="Monitoring GPU-Backed Credit with Market Data · CCIR"
  ogImage="/og/applications.png"
  description="Worked examples showing how lenders, credit analysts and risk teams can use CCIR's published data to monitor GPU-backed exposures: re-leasing risk sized against contracted and posted term rates, and collateral value and loan-to-value."
>
  <nav class="apps-navband" aria-label="Use cases">
    <div class="wrap apps-nav-inner">
      {toc.map((u) => (
        <a class="apps-nav-link" href={'#' + u.id}>
          <span class="apps-nav-n">{u.kicker.replace('Use case ', 'UC')}</span> {u.label}
        </a>
      ))}
    </div>
  </nav>
  <section class="wrap page-top">
    <PageHeader title="Applications" kicker="Worked Monitoring Examples" asOf={meta.as_of_date} display />
    <p class="dek">
      Worked examples showing how lenders, credit analysts and risk teams can
      use CCIR's published market data to monitor GPU-backed exposures. Each
      example uses a specific CCIR data series and calibrates to today's
      snapshot.
    </p>

    <nav class="toc" id="contents" aria-label="Contents">
      <div class="toc-kicker">Contents</div>
      <div class="toc-grid">
        {toc.map((u) => (
          <div class="toc-group">
            <a class="toc-uc" href={'#' + u.id}>
              <span class="toc-uc-kicker">{u.kicker}</span>
              {u.label}
            </a>
            {u.secs.length > 0 && (
              <ol class="toc-secs">
                {u.secs.map((s) => (
                  <li><a href={'#' + s[0]}>{s[1]}</a></li>
                ))}
              </ol>
            )}
          </div>
        ))}
      </div>
    </nav>

    <article class="usecase" id="uc-01">
      <header class="uc-head">
        <span class="uc-kicker">Use case 01 · Contract rollover</span>
        <h2>Re-Leasing Risk Sized Against the Published Term Curve</h2>
        <p class="uc-lede">
          A worked example of contract rollover in GPU-backed lending. A
          borrower's anchor customer contract expires mid-loan. The freed
          capacity must be re-leased at then-prevailing rates. A lender
          watching this risk can size it against the published term curve
          months before the contract expires. The approach mirrors the
          market-rent assumptions used in commercial real estate and aircraft
          leasing. The example is illustrative.
        </p>
      </header>

      <section class="uc-rate">
        <div class="rate-kicker">Base re-lease range (live, calibrating this example)</div>
        <div class="rate-id">B200 · global Neocloud</div>
        <div class="rate-price">${fmt(baseLo)}–${fmt(baseHi)}<span class="rate-unit">/GPU-hr</span></div>
        <div class="rate-meta">
          Posted on-demand less the measured discount, to contracted 2Y on <a href="/term">/term</a>
          <span class="sep">·</span>
          as of {meta.as_of_date}
        </div>
        <div class="rate-thresholds">
          <span><strong>Watch</strong> ${fmt(watchRate)} <span class="dim">({Math.round(WATCH_PCT * 100)}% below)</span></span>
          <span><strong>Trigger</strong> ${fmt(triggerRate)} <span class="dim">({Math.round(TRIGGER_PCT * 100)}% below)</span></span>
        </div>
      </section>

      <section class="sec">
        <h3 id="uc-01-s01"><span class="sec-n">01</span> Why Rollover Is the Central Credit Question</h3>
        <p>
          Customer contracts usually run two to five years. The facilities
          they support can mature later. The capacity behind the loan must
          then be re-contracted or placed on the spot market
          (<a href="/rates">/rates</a>, <a href="/discovery">/discovery</a>)
          at least once before maturity.
        </p>
        <p>
          Two published numbers bound the base case. The low end is the
          posted on-demand rate less the measured gap between posted and
          contracted prices. The high end is what B200 contracts signed at
          over the last 12 months, from <a href="/term">/term</a>. The
          lender sets triggers a fixed percentage below the low end.
        </p>
        <p>
          Commercial real estate lenders handle the same question with
          market-rent assumptions. Aircraft lessors use appraiser-published
          re-leasing rates. For GPUs, the market rent is observable daily,
          and we tie it to the rates the market is contracting at.
        </p>
      </section>

      <section class="sec">
        <h3 id="uc-01-s02"><span class="sec-n">02</span> Worked Rollover Exhibit</h3>
        <p class="calib-note">
          Calibration: stylized facility of {FLEET_GPUS.toLocaleString('en-US')} B200
          GPUs (1,000 nodes). {(ANCHOR_SHARE * 100).toFixed(0)}% of capacity
          sits under a 2-year anchor contract at the /term 2Y contracted rate
          of ${fmt(ANCHOR_RATE)}. The rest sells at the implied rate of
          ${fmt(reLeaseBase)}.
          DSCR at close {CLOSE_DSCR.toFixed(2)}x. At rollover the whole fleet
          reprices. Margins and debt service stay constant to isolate the
          price effect. Every rate is live as of {meta.as_of_date}.
        </p>
        <div class="ftable-wrap">
          <table class="ftable">
            <thead><tr><th>Case at rollover</th><th class="num">Rate $/GPU-hr</th><th class="num">DSCR</th><th>Response</th></tr></thead>
            <tbody>
              <tr><td>At close</td><td class="num">{fmt(ANCHOR_RATE)}</td><td class="num">{CLOSE_DSCR.toFixed(2)}x</td><td>Record the base range</td></tr>
              <tr><td>Base range</td><td class="num">{fmt(baseLo)}–{fmt(baseHi)}</td><td class="num">{dscrAt(baseLo).toFixed(2)}x–{dscrAt(baseHi).toFixed(2)}x</td><td>Standard review</td></tr>
              <tr><td>Watch, {Math.round(WATCH_PCT * 100)}% below the low end</td><td class="num">{fmt(watchRate)}</td><td class="num">{dscrAt(watchRate).toFixed(2)}x</td><td>Monthly review; request the re-leasing pipeline</td></tr>
              <tr><td>Trigger, {Math.round(TRIGGER_PCT * 100)}% below the low end</td><td class="num">{fmt(triggerRate)}</td><td class="num"><strong>{dscrAt(triggerRate).toFixed(2)}x</strong></td><td>Coverage test; reserve and sweep terms</td></tr>
            </tbody>
          </table>
        </div>
        <p>
          <strong>The trigger lands where coverage breaks.</strong> At
          {Math.round(TRIGGER_PCT * 100)}% below the low end, projected DSCR
          falls under 1.20x. The lender can see that point months before the
          contract expires, from published data and the borrower's contract
          book.
        </p>
      </section>

      <section class="sec">
        <h3 id="uc-01-s03"><span class="sec-n">03</span> What to Watch and When</h3>
        <p>
          A lender tracking rollover risk might follow a simple routine.
        </p>
        <p>
          <strong>Start 180 days out.</strong> Begin the rollover check 180
          days before any contract that supplies 20% or more of gross rental
          revenue expires. Repeat it monthly until the contract is replaced or
          renewed.
        </p>
        <p>
          <strong>Two inputs can trip the trigger.</strong> The first is the
          30-day average of the implied rate: posted on-demand less the
          measured discount. Posted rates print every day, so this input can
          move between filings. The second is the rate in any new B200 filing on
          <a href="/term">/term</a>. Either one below the watch or trigger
          level sets the response.
        </p>
        <p>
          <strong>Re-price only the expiring block.</strong> Hold every other
          contract at its contracted rate. Re-price the expiring capacity at
          the current test rate. Compare projected cash flow with scheduled
          debt service.
        </p>
        <p>
          <strong>Every moving input comes from outside the borrower.</strong>
          The rates come from published data. The check date comes from the
          contract calendar.
        </p>
      </section>

      <section class="sec">
        <h3 id="uc-01-s04"><span class="sec-n">04</span> The Levels Against Three Years of History</h3>
        <p>
          B200 has not yet been through a full price cycle. H100 has. The
          table runs the same levels on H100's posted history, from a close
          in February 2024 at ${fmt(BACKTEST_CLOSE)}. Watch sits 10% below
          and trigger 20% below.
        </p>
        <div class="ftable-wrap">
          <table class="traj">
            <thead>
              <tr><th>Period</th><th class="num">Posted H100</th><th>Level</th></tr>
            </thead>
            <tbody>
              {backtest.map((r) => (
                <tr>
                  <td>{r.period}</td>
                  <td class="num">{r.rate}</td>
                  <td class={`tier tier-${r.cls.slice(1)}`}>{r.level}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p>
          <strong>The trigger held for 18 months.</strong> It tripped in
          September 2024 and was still in place in February 2026, two years
          after close. A borrower rolling contracts in that window would have
          re-leased well below its close. A facility with this trigger could
          have started a cash sweep or other remedies in September 2024,
          before those contracts rolled.
        </p>
        <p class="calib-note">
          Calibration notes: monthly posted medians from CCIR's archived-page
          backfill (<a href="/research/od-vs-committed">On-Demand vs
          Committed, Three Years</a>). The early panel is thin, and it uses a
          different collection method from the live daily series.
        </p>
      </section>

      <section class="sec">
        <h3 id="uc-01-s05"><span class="sec-n">05</span> Weighting by Exposed Capacity</h3>
        <p>
          A heavily contracted borrower's revenue does not move with the
          market. The test can blend the two. Contracted capacity counts at
          its contract rate. Exposed capacity counts at the test rate.
          Exposed capacity is anything uncontracted or under a contract that
          expires within 12 months.
        </p>
        <p>
          The blend tracks contract expiry. Far from expiry, the market
          touches only the uncontracted share. As contracts approach expiry,
          more capacity is exposed, and the same market level weighs more
          heavily. The blend needs a monthly schedule of contracted rates,
          covered capacity and expiry dates from the borrower.
        </p>
      </section>

      <section class="sec">
        <h3 id="uc-01-s06"><span class="sec-n">06</span> Limitations</h3>
        <p>
          <strong>This is illustrative.</strong> Fleet size, anchor share and
          closing DSCR are stylized. The contracted rate rests on a few filed
          deals. The posted-to-contracted discount is measured across chips
          and tenors, and a single deal can sit well above or below it. The
          10% and 20% trigger distances are examples. Utilization on
          re-leased capacity stays at the contracted level.
        </p>
      </section>

    </article>

    <article class="usecase" id="uc-02">
      <header class="uc-head">
        <span class="uc-kicker">Use case 02 · Senior-secured term loan</span>
        <h2>Collateral Value and Loan-to-Value</h2>
        <p class="uc-lede">
          A worked example of marking GPU collateral at a published model
          value. The lender tracks loan-to-value against levels set at close.
          Each level maps to a monitoring response. The example is
          illustrative. It is not a model form or a recommended practice.
        </p>
      </header>

      <section class="uc-rate">
        <div class="rate-kicker">Collateral value (live, calibrating this example)</div>
        <div class="rate-id">1,000 B200 nodes · 8,000 GPUs · <a href="/hardware">/hardware</a></div>
        <div class="rate-price">{fmtM(fleetValue)}<span class="rate-unit"> · LTV {pctS(ltv)}</span></div>
        <div class="rate-meta">
          Model value {fmtK(b200Card?.base ?? 0)} per GPU
          <span class="sep">·</span>
          as of {meta.as_of_date}
        </div>
        <div class="rate-thresholds">
          <span><strong>Level 2 watch</strong> LTV above {pctS(LTV_LEVELS[0])}</span>
          <span><strong>Level 3 watch</strong> above {pctS(LTV_LEVELS[1])}</span>
          <span><strong>Level 4 watch</strong> above {pctS(LTV_LEVELS[2])}</span>
        </div>
      </section>

      <section class="sec">
        <h3 id="uc-02-s01"><span class="sec-n">01</span> Why Mark the Collateral</h3>
        <p>
          A GPU is worth what it can earn over its remaining life. The
          <a href="/hardware">/hardware</a> model values each chip on that
          basis. It uses contracted rates where enough deals are on file, a
          disclosed discount rate and a disclosed life. Asks, sales and
          new-chip prices sit beside it as checks.
        </p>
        <p>
          Most credit documents amortize GPU collateral on a fixed schedule.
          A published value gives the lender a second view that moves with
          the market. It comes with a range, so the lender can see how much
          cushion the loan has at each end.
        </p>
      </section>

      <section class="sec">
        <h3 id="uc-02-s02"><span class="sec-n">02</span> Hypothetical Exposure</h3>
        <div class="ftable-wrap">
          <table class="ftable">
            <tbody>
              {exposureTerms.map(({ term, value }) => (
                <tr>
                  <th>{term}</th>
                  <td>{value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="sec">
        <h3 id="uc-02-s03"><span class="sec-n">03</span> Value and Range</h3>
        <p>
          The example sets loan-to-value levels at {pctS(LTV_LEVELS[0])},
          {' '}{pctS(LTV_LEVELS[1])} and {pctS(LTV_LEVELS[2])}. The table marks
          the fleet at the model value and both ends of its range.
        </p>
        <div class="ftable-wrap">
          <table class="ftable">
            <thead>
              <tr><th>Level</th><th>LTV range</th><th>Monitoring response</th></tr>
            </thead>
            <tbody>
              {ltvLevels.map((l) => (
                <tr>
                  <td class="feat">{l.label}</td>
                  <td>{l.range}</td>
                  <td>{l.response}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="ftable-wrap">
          <table class="traj">
            <thead>
              <tr><th>Case</th><th class="num">Per GPU</th><th class="num">Fleet value</th><th class="num">LTV</th><th>Level</th></tr>
            </thead>
            <tbody>
              {valueCases.map((c) => (
                <tr>
                  <td>{c.name}</td>
                  <td class="num">{fmtK(c.per)}</td>
                  <td class="num">{fmtM(c.value)}</td>
                  <td class="num">{pctS(c.ltv)}</td>
                  <td class={`tier tier-${c.level}`}>{c.label}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p>
          The value assumes the fleet's contracts hold. Use case 01 sizes
          the risk that they roll off into a weaker market.
        </p>
        <p>
          The value is recomputed with each daily data refresh. The levels in
          this example set monitoring responses only. They have no
          contractual effect.
        </p>
      </section>

      <section class="sec">
        <h3 id="uc-02-s04"><span class="sec-n">04</span> Mixed-Generation Pools</h3>
        <p>
          Warehouse and securitized pools usually hold several generations.
          Each generation is marked at its own model value and weighted by
          its units in the asset schedule. The same loan-to-value levels
          apply to the pool.
        </p>
        <div class="ftable-wrap">
          <table class="traj">
            <thead>
              <tr><th>Generation</th><th class="num">Units</th><th class="num">Per GPU</th><th class="num">Value</th></tr>
            </thead>
            <tbody>
              {poolRows.map((r) => (
                <tr>
                  <td>{r.chip}</td>
                  <td class="num">{r.units.toLocaleString('en-US')}</td>
                  <td class="num">{fmtK(r.per)}</td>
                  <td class="num">{fmtM(r.units * r.per)}</td>
                </tr>
              ))}
              <tr>
                <td><strong>Pool</strong></td>
                <td class="num">{FLEET.toLocaleString('en-US')}</td>
                <td class="num">{fmtK(poolValue / FLEET)}</td>
                <td class="num"><strong>{fmtM(poolValue)}</strong></td>
              </tr>
            </tbody>
          </table>
        </div>
        <p>
          Surveillance watches the pool value against its closing level, mix
          drift in the servicer report, and whether substitutions entered on
          schedule. A generation without a published value stays outside the
          pool mark until one publishes.
        </p>
