---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { meta } from '../../data/snapshot';
import versions from '../../../public/documents/methodology/versions.json';
import raw from '../../content/methodology/methodology.md?raw';
import { renderMethodology } from '../../lib/methodology-md.mjs';

// The page text is src/content/methodology/methodology.md, the public
// methodology (METHODOLOGY_PUBLIC.md in ccir-v2-notebooks). The versioned
// PDF renders from the same file, so the two cannot drift. Both the text and
// public/documents/methodology/ (PDFs + versions.json) arrive through
// scripts/sync-methodology.mjs from a checkout of ccir-index/ccir-methodology;
// see src/lib/methodology-md.mjs for the rendering pipeline.
const { title, standfirst, body } = await renderMethodology(raw);

// Version bar. versions.json is the public index the mirror workflow writes:
// one dated PDF per methodology version.
const current = versions.versions.find((v) => v.version === versions.current);
const pdfHref = current?.pdf ? `/documents/methodology/${current.pdf}` : null;
---
<Base
  title="GPU Compute Price Index Methodology — Sources, Aggregation, Series Grammar · CCIR"
  ogImage="/og/documents.png"
  description="CCIR methodology — what the series measure, where prices come from, how they are aggregated, and the series grammar."
  showTape={false}
>
  <section class="wrap page-top methodology-doc">
    <PageHeader title={title} crumbs={[{ href: '/documents', label: 'Documents' }]} kicker="Methodology" asOf={meta.as_of_date} asOfLabel="as published" display>
      <Fragment set:html={standfirst} />
      <p class="revnote">
        Methodology <code>{current?.version}</code>
        <span class="sep">·</span> effective {current?.effective}
        {current?.document_revision && (
          <><span class="sep">·</span> document revised {current.document_revision}</>
        )}
        {pdfHref && (
          <><span class="sep">·</span> <a href={pdfHref}>PDF</a></>
        )}
        <span class="sep">·</span> <a href="/documents#methodology-versions">All versions</a>
      </p>
    </PageHeader>

    <Fragment set:html={body} />
  </section>

  <style>
    .top { padding-top: 32px; }
    .page-head { max-width: 80ch; margin-bottom: 10px; }
    .page-head h1 {
      font-family: var(--font-display);
      font-size: var(--fs-hero);
      line-height: var(--lh-display);
      font-weight: var(--weight-display);
      margin: 6px 0 14px;
      letter-spacing: -0.01em;
    }
    .revnote {
      font-family: var(--font-body);
      font-size: var(--fs-sm);
      color: var(--ink-dim);
      line-height: 1.6;
      max-width: 76ch;
      margin: 10px 0 0;
    }
    .revnote code {
      font-family: var(--font-mono);
      font-size: 0.9em;
    }
    .revnote .sep { color: var(--rule); padding: 0 2px; }
    .revnote a { color: var(--accent); }
  </style>

  <!-- The sections come from markdown (set:html), outside Astro's style
       scoping, so their rules are global under .methodology-doc. -->
  <style is:global>
    .methodology-doc .sec { margin: 26px 0; max-width: 76ch; }
    .methodology-doc .sec h2 {
      font-family: var(--font-display);
      font-size: var(--fs-xl);
      margin: 0 0 10px;
      display: flex;
      align-items: baseline;
      gap: 12px;
    }
    .methodology-doc .sec .n {
      font-family: var(--font-mono);
      font-size: var(--fs-sm);
      color: var(--accent);
      font-weight: var(--weight-strong);
    }
    .methodology-doc .sec p, .methodology-doc .sec ul {
      font-family: var(--font-body);
      font-size: var(--fs-md);
      color: var(--ink);
      line-height: 1.65;
      margin: 0 0 12px;
    }
    .methodology-doc .sec ul { padding-left: 20px; }
    .methodology-doc .sec li { margin-bottom: 6px; }
    .methodology-doc .sec strong { color: var(--accent); }
    .methodology-doc .sec code {
      font-family: var(--font-mono);
      font-size: 0.9em;
      background: var(--surface-2);
      padding: 1px 5px;
      border: 1px solid var(--rule);
    }
    .methodology-doc .grammar {
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      color: var(--ink);
      line-height: 1.8;
      background: var(--surface);
      border: 1px solid var(--rule);
      border-left: 2px solid var(--accent);
      padding: 14px 16px;
      overflow-x: auto;
      margin: 0 0 12px;
    }
    .methodology-doc .grammar code {
      font-family: inherit;
      font-size: inherit;
      background: none;
      border: 0;
      padding: 0;
    }
  </style>
</Base>
