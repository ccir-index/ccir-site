---
/*
  Two Order Books, Two Funding Machines — CRWV + NBIS demand read in
  two layers: the guidance layer as disclosed, then cash and contracts.
  Published 2026-08-12. Call quotes verified: CoreWeave vs its corrected transcript;
  Nebius vs two independent transcripts (footnotes 2 and 4).
  Every computed ratio is labeled "computed" on the chart that shows it.
  Chart pair #3b82f6 (CRWV) / #c96f06 (NBIS) validated with the dataviz
  six-checks script against both theme surfaces (terminal #111418,
  editorial #fbf7ee): worst CVD ΔE 27.4, normal-vision ΔE 33.1 — PASS.
  Series identity is also carried by shape (line vs step) and by the
  legend, never color alone.
*/
import Base from '../../layouts/Base.astro';
import NoteFooter from '../../components/NoteFooter.astro';
const AS_OF = '2026-08-12';

const C_CRWV = '#3b82f6';
const C_NBIS = '#c96f06';

// ---- shared time axis for charts 1 and 2: months since Dec 2023 (0..30) --
const XW = 700, XL = 50, XR = 118;
const xm = (m: number) => XL + (m / 30) * (XW - XL - XR);
const X_TICKS = [
  { m: 0, l: 'Dec ’23' }, { m: 6, l: 'Jun ’24' }, { m: 12, l: 'Dec ’24' },
  { m: 18, l: 'Jun ’25' }, { m: 24, l: 'Dec ’25' }, { m: 30, l: 'Jun ’26' },
];

// ---- Chart 1: deferred revenue history, $B -------------------------------
// CRWV = line (a convention-driven ramp: 15–25%-of-TCV prepay across all
// committed contracts; annual prints for 2023/2024, quarterly after).
// NBIS = step (near-zero until Q4-25, then two contracts move the whole
// balance; a step-after path is the honest shape for that history).
const H1 = 300, T1 = 26, B1 = 44;
const y1 = (v: number) => T1 + (1 - v / 10) * (H1 - T1 - B1);
const Y1_TICKS = [0, 2, 4, 6, 8, 10];
const CRWV_DR = [
  { m: 0,  v: 2.0047, t: 'Dec 31, 2023 · $2.0B · 424B4 (S-1 financials)' },
  { m: 12, v: 4.0639, t: 'Dec 31, 2024 · $4.1B · 424B4' },
  { m: 15, v: 4.048,  t: 'Mar 31, 2025 · $4.0B · 10-Q' },
  { m: 18, v: 4.8475, t: 'Jun 30, 2025 · $4.8B · 10-Q' },
  { m: 21, v: 5.3358, t: 'Sep 30, 2025 · $5.3B · 10-Q' },
  { m: 24, v: 8.185,  t: 'Dec 31, 2025 · $8.2B · 10-K' },
  { m: 27, v: 7.523,  t: 'Mar 31, 2026 · $7.5B · 10-Q' },
  { m: 30, v: 9.692,  t: 'Jun 30, 2026 · $9.7B · 10-Q filed Aug 12, 2026' },
];
const NBIS_DR = [
  { m: 9,  v: 0.0174, t: 'Sep 30, 2024 · $17.4M · 6-K' },
  { m: 12, v: 0.0165, t: 'Dec 31, 2024 · $16.5M · 6-K / 20-F' },
  { m: 15, v: 0.019,  t: 'Mar 31, 2025 · $19.0M · 6-K' },
  { m: 18, v: 0.0193, t: 'Jun 30, 2025 · $19.3M · 6-K' },
  { m: 21, v: 0.0156, t: 'Sep 30, 2025 · $15.6M · 6-K' },
  { m: 24, v: 1.5775, t: 'Dec 31, 2025 · $1.6B · 6-K / 20-F' },
  { m: 27, v: 4.7781, t: 'Mar 31, 2026 · $4.8B · 6-K' },
  { m: 30, v: 5.9752, t: 'Jun 30, 2026 · $6.0B · 6-K filed Aug 12, 2026' },
];
const crwvDrPath = CRWV_DR
  .map((p, i) => `${i === 0 ? 'M' : 'L'}${xm(p.m).toFixed(1)},${y1(p.v).toFixed(1)}`)
  .join(' ');
const nbisDrPath = NBIS_DR
  .map((p, i) => i === 0
    ? `M${xm(p.m).toFixed(1)},${y1(p.v).toFixed(1)}`
    : `H${xm(p.m).toFixed(1)} V${y1(p.v).toFixed(1)}`)
  .join(' ');

// ---- Chart 2: deferred revenue as % of total debt [computed] --------------
// The divergence chart. Both series print 38% at Dec 31, 2025 and cross.
// NBIS drawn only from Jun 2025: before that its debt was near nil and the
// ratio is not meaningful (said in the caption).
const H2 = 290, T2 = 32, B2 = 44;
const y2 = (p: number) => T2 + (1 - p / 140) * (H2 - T2 - B2);
const Y2_TICKS = [0, 25, 50, 75, 100, 125];
const CRWV_PD = [
  { m: 0,  p: 132, t: 'Dec 31, 2023 · $2,004.7M ÷ $1,523.3M = 132% [computed]' },
  { m: 12, p: 51,  t: 'Dec 31, 2024 · $4,063.9M ÷ $7,926.3M = 51% [computed]' },
  { m: 15, p: 46,  t: 'Mar 31, 2025 · 46% [computed]' },
  { m: 18, p: 44,  t: 'Jun 30, 2025 · 44% [computed]' },
  { m: 21, p: 38,  t: 'Sep 30, 2025 · 38% [computed]' },
  { m: 24, p: 38,  t: 'Dec 31, 2025 · $8,185M ÷ $21,373M = 38% [computed]' },
  { m: 27, p: 30,  t: 'Mar 31, 2026 · 30% [computed]' },
  { m: 30, p: 28,  t: 'Jun 30, 2026 · $9,692M ÷ $35,068M net carrying = 28% [computed]' },
];
const NBIS_PD = [
  { m: 18, p: 2,   t: 'Jun 30, 2025 · $19.3M ÷ $986.2M = 2% [computed]' },
  { m: 21, p: 0.4, t: 'Sep 30, 2025 · $15.6M ÷ $4,106.8M = 0.4% [computed]' },
  { m: 24, p: 38,  t: 'Dec 31, 2025 · $1,577.5M ÷ $4,127.7M = 38% [computed]' },
  { m: 27, p: 57,  t: 'Mar 31, 2026 · $4,778.1M ÷ $8,450.4M = 57% [computed]' },
  { m: 30, p: 70,  t: 'Jun 30, 2026 · $5,975.2M ÷ $8,545.7M = 70% [computed]' },
];
const crwvPdPath = CRWV_PD
  .map((p, i) => `${i === 0 ? 'M' : 'L'}${xm(p.m).toFixed(1)},${y2(p.p).toFixed(1)}`)
  .join(' ');
const nbisPdPath = NBIS_PD
  .map((p, i) => `${i === 0 ? 'M' : 'L'}${xm(p.m).toFixed(1)},${y2(p.p).toFixed(1)}`)
  .join(' ');

// ---- Chart 3: quarterly prepay inflow ÷ quarterly capex [computed] --------
// Grouped bars, six quarters. Negative = consumption of prepayments outran
// new inflow that quarter. The 100% line is a quarter fully funded by
// customer cash; NBIS Q1-26 is the only bar past it at either firm.
const W3 = 700, H3 = 300, T3 = 30, B3 = 48, L3 = 50, R3 = 24;
const y3 = (p: number) => T3 + ((140 - p) / 160) * (H3 - T3 - B3);
const Y3_TICKS = [0, 50, 100];
const BW3 = 26;
const gx = (i: number) => L3 + ((i + 0.5) / 6) * (W3 - L3 - R3);
const COV = [
  { q: 'Q1 ’25', c: -1, n: 0,
    ct: 'CRWV Q1 2025 · −$15.9M ÷ $1,407.4M = −1% [computed]',
    nt: 'NBIS Q1 2025 · +$2.5M ÷ $543.9M ≈ 0% [computed]' },
  { q: 'Q2 ’25', c: 33, n: 0,
    ct: 'CRWV Q2 2025 · +$799.5M ÷ $2,453.0M = 33% [computed]',
    nt: 'NBIS Q2 2025 · +$0.3M ÷ $510.6M ≈ 0% [computed]' },
  { q: 'Q3 ’25', c: 20, n: 0,
    ct: 'CRWV Q3 2025 · +$488.3M ÷ $2,388.9M = 20% [computed]',
    nt: 'NBIS Q3 2025 · −$3.7M ÷ $955.5M ≈ 0% [computed]' },
  { q: 'Q4 ’25', c: 70, n: 76,
    ct: 'CRWV Q4 2025 · +$2,849.2M ÷ $4,059.8M = 70% [computed]',
    nt: 'NBIS Q4 2025 · +$1,561.9M ÷ $2,056.0M = 76% [computed] · first Microsoft tranche' },
  { q: 'Q1 ’26', c: -9, n: 129,
    ct: 'CRWV Q1 2026 · −$662M ÷ $7,695M = −9% [computed]',
    nt: 'NBIS Q1 2026 · +$3,200.6M ÷ $2,472.9M = 129% [computed] · the only customer-outfunded quarter at either firm' },
  { q: 'Q2 ’26', c: 34, n: 21,
    ct: 'CRWV Q2 2026 · +$2,169M ÷ $6,422M = 34% [computed]',
    nt: 'NBIS Q2 2026 · +$1,197.1M ÷ $5,657.4M = 21% [computed]' },
];
const covLab = (v: number) => (v === 0 ? '~0' : v < 0 ? `−${Math.abs(v)}` : `${v}`);

// ---- Chart 4: NBIS ACV per MW ladder, $M [letter, approximate] ------------
// Three labeled steps from the shareholder-letter infographic. The two
// upper steps are stated as floors ("more than"); drawn with a dashed
// whisker above the bar so the floor reads as a floor.
const W4 = 560, H4 = 250, T4 = 30, B4 = 46, L4 = 54, R4 = 20;
const y4 = (v: number) => T4 + (1 - v / 50) * (H4 - T4 - B4);
const Y4_TICKS = [0, 10, 20, 30, 40, 50];
const BW4 = 104;
const x4 = (i: number) => L4 + ((i + 0.5) / 3) * (W4 - L4 - R4);
const LADDER = [
  { k: '2026 base', v: 12, l: '$12M', gt: false,
    t: '2026 base · approximately $12M ACV per MW · shareholder letter infographic ("all numbers are approximate")' },
  { k: 'Q2 deals', v: 20, l: '>$20M', gt: true,
    t: 'Q2 2026 landmark deals · more than $20M ACV per MW · letter: "an average yield of more than $20 million per megawatt", $20–25M on the four landmark deals' },
  { k: 'Q3 short-term', v: 40, l: '>$40M', gt: true,
    t: 'Q3 2026 short-term capacity deals · more than $40M ACV per MW · letter: "price opportunity in the $40-50 million per MW range and we signed our first one this week"' },
];

// ---- Chart 5: debt composition at Jun 30, 2026, $B · one dollar scale -----
// Paired horizontal stacked bars. Within each bar, one hue stepped by
// lightness encodes an ORDERED class: solid = secured, mid = collateral
// basis not stated in the filing, light = unsecured. Steps validated with
// the dataviz six-checks script against both theme surfaces (adjacent-step
// normal-vision dE 15.4 light / 18.8 dark; lightness monotonic both modes).
// Identity is carried by the per-segment direct labels and 2px surface
// gaps, never by opacity alone. CRWV segments are gross principal from the
// 10-Q schedule; NBIS is carrying value (the delta to principal is
// accretion, said in the notes).
const W5 = 700, H5 = 206, L5 = 118, R5 = 24;
const x5 = (v: number) => L5 + (v / 36) * (W5 - L5 - R5);
const X5_TICKS = [0, 10, 20, 30];
const BH5 = 40, CRWV_Y5 = 36, NBIS_Y5 = 118;
type Seg5 = { k: string; a: string; v: number; op: number; t: string };
const seg5 = (rows: Seg5[]) => {
  let c = 0;
  return rows.map((r, i) => {
    const x0 = x5(c);
    c += r.v;
    return { ...r, x: x0 + (i ? 1 : 0), w: Math.max(x5(c) - x0 - (i ? 1 : 0) - 1, 1.5) };
  });
};
const CRWV_COMP = seg5([
  { k: 'DDTLs', a: '$13.6B · secured', v: 13.643, op: 1,
    t: 'DDTL facilities 1.0-5.0 · $13,643M gross drawn (facility sizes $2.3B/$7.6B/$3.0B/$2.6B/$8.5B/$3.1B) · secured; 10-Q: "collateralized with the assets underlying the contributed contracts and the pledged contractual cash flows" · DDTL 4.0 ($2,837M) non-recourse · eff. rates 7-15%; DDTL 4.0 SOFR + 2.25%, DDTL 5.0 SOFR + 4.50%' },
  { k: 'Vendor', a: '$5.3B', v: 5.291, op: 0.55,
    t: 'OEM and software license financing $5,102M (recourse $4,220M eff. 11%; non-recourse $882M eff. 9%) + Magnetar Loan (MagAI deposit obligation) $189M (eff. 12%) · collateral basis not stated in the 10-Q' },
  { k: 'Senior notes', a: '$10.0B · unsec.', v: 10.029, op: 0.38,
    t: 'Five senior note series · 2030 $2,000M · 2031 9.00% $1,750M · 2031 9.75% $2,750M · 2032 9.625% $1,250M · 2032 EUR (EUR 2,000M) $2,279M 8.50% · "The Senior Notes are unsecured obligations"' },
  { k: 'Converts', a: '$6.6B · unsec.', v: 6.588, op: 0.38,
    t: '2031 Convertible Senior Notes $2,588M 1.75% due Dec 2031 + 2032 Convertible Senior Notes $4,000M 1.75% due Oct 2032 · unsecured' },
]);
const NBIS_COMP = seg5([
  { k: 'Convertible notes', a: '$8.5B · unsecured', v: 8.5457, op: 0.38,
    t: 'Six senior unsecured convertible series · Jun 2025: $500M 2.00% due 2029 + $500M 3.00% due 2031 · Sep 2025: ~$1.58B 1.00% due 2030 + ~$1.58B 2.75% due 2032 · Mar 2026: $2,587.5M 1.25% due 2031 + $1,750M 2.625% due 2033 · $8,545.7M carrying vs ~$8,500M original principal (accretion)' },
]);
const NBIS_JULY = {
  v: 0.775,
  t: 'Secured facility · $775M · SOFR + 2.50% · raised July 2026, after quarter end · letter: "backed by deployed GPU infrastructure and contracted cash flows from an agreement with an investment-grade customer"',
};
---
<Base
  title="Two Order Books, Two Funding Machines: CoreWeave and Nebius Q2 2026 · CCIR Research"
  ogImage="/og/two-order-books.png"
  article={{ published: '2026-08-12' }}
  description="CoreWeave and Nebius demand read from cash and contracts: $9.7B and $6.0B of customer prepayments at June 30, feeding two opposite funding machines."
>
  <section class="wrap top">

    <div class="page-head">
      <div class="kicker">Market Intelligence · Research Note · {AS_OF}</div>
      <h1>Two Order Books, Two Funding Machines</h1>
      <p class="standfirst lede">
        CoreWeave reported second-quarter results on August&nbsp;11 and
        Nebius on August&nbsp;12, 2026. The two order books look alike.
        The funding machines behind them run in opposite directions.
      </p>
    </div>

    <div class="stats" role="list">
      <div class="stat" role="listitem">
        <div class="v">$2.6B</div>
        <div class="k">CoreWeave Q2 revenue</div>
        <div class="s">&#9650; 2.1&times; vs Q2 2025</div>
      </div>
      <div class="stat" role="listitem">
        <div class="v">$582M</div>
        <div class="k">Nebius Q2 revenue</div>
        <div class="s">&#9650; 5.5&times; vs Q2 2025</div>
      </div>
      <div class="stat" role="listitem">
        <div class="v">$29.0B</div>
        <div class="k">CoreWeave non-convertible debt</div>
      </div>
      <div class="stat" role="listitem">
        <div class="v">$775M</div>
        <div class="k">Nebius non-convertible debt</div>
      </div>
    </div>
    <p class="stats-basis">Revenue compares Q2 2026 with Q2 2025.
      Debt is gross principal at June&nbsp;30, 2026; convertible notes,
      which convert to shares above set prices and are often read as
      quasi-equity, are shown separately. The Nebius figure is its
      secured facility raised in July, after quarter end.</p>

    <figure class="fig">
      <div class="fig-title">Deferred revenue ÷ total debt, % · Dec ’23 – Jun ’26</div>
      <div class="legend">
        <span class="lg"><span class="sw" style={`background:${C_CRWV}`}></span>CoreWeave</span>
        <span class="lg"><span class="sw" style={`background:${C_NBIS}`}></span>Nebius</span>
      </div>
      <svg viewBox={`0 0 ${XW} ${H2}`} role="img" aria-label="Deferred revenue as a percent of total debt. CoreWeave falls from 132 percent in December 2023 to 28 percent in June 2026. Nebius starts at 2 percent in June 2025, dips to 0.4, then rises to 70 percent in June 2026. Both series print 38 percent in December 2025, where the lines cross. A dashed line marks 100 percent, prepayments equal to the whole debt stack.">
        {Y2_TICKS.map((t) => (
          <>
            <line x1={XL} y1={y2(t)} x2={XW - XR} y2={y2(t)} class="grid" />
            <text x={XL - 8} y={y2(t) + 3} class="tick t-end">{t}</text>
          </>
        ))}
        <line x1={XL} y1={y2(100)} x2={XW - XR} y2={y2(100)} stroke="var(--ink-faint)" stroke-width="1.2" stroke-dasharray="4 4" />
        <text x={XW - XR - 4} y={y2(100) - 7} class="rowsub t-end lab-halo">prepay = total debt</text>
        {X_TICKS.map((t) => (
          <text x={xm(t.m)} y={H2 - B2 + 20} class="tick t-mid">{t.l}</text>
        ))}
        <path d={crwvPdPath} fill="none" stroke={C_CRWV} stroke-width="2" stroke-linejoin="round" />
        <path d={nbisPdPath} fill="none" stroke={C_NBIS} stroke-width="2" stroke-linejoin="round" />
        {CRWV_PD.map((p) => (
          <circle cx={xm(p.m)} cy={y2(p.p)} r="3.6" fill={C_CRWV} stroke="var(--surface)" stroke-width="2">
            <title>{`CoreWeave · ${p.t}`}</title>
          </circle>
        ))}
        {NBIS_PD.map((p) => (
          <circle cx={xm(p.m)} cy={y2(p.p)} r="3.6" fill={C_NBIS} stroke="var(--surface)" stroke-width="2">
            <title>{`Nebius · ${p.t}`}</title>
          </circle>
        ))}
        <text x={xm(0) + 8} y={y2(132) - 8} class="dlab" fill={C_CRWV}>132%</text>
        <text x={xm(30) + 10} y={y2(28) + 3} class="dlab" fill={C_CRWV}>CRWV 28%</text>
        <text x={xm(30) + 10} y={y2(70) + 3} class="dlab" fill={C_NBIS}>NBIS 70%</text>
      </svg>
      <figcaption class="fig-foot">
        <p class="fig-read">CoreWeave&rsquo;s falling line is a
        denominator story: its prepayments grew about five-fold from
        the end of 2023 while its borrowings grew more than
        twenty-fold. Nebius&rsquo;s rising line is the numerator: prepayments
        growing faster than the debt beneath them.</p>
      <details class="fig-details">
          <summary>Chart notes</summary>
          <ul class="fig-notes-list">
            <li>Computed: total deferred revenue divided by the carrying
            value of total debt, current plus non-current, at each period
            end. Hover any point for the filed inputs.</li>
            <li>Nebius is drawn from June 2025; before that its debt was
            near nil and the ratio is not meaningful.</li>
            <li>Both series print 38% at December&nbsp;31, 2025, where
            the lines cross.</li>
            <li>CoreWeave's June 2026 denominator is the four
            balance-sheet debt lines summed, $35.1&nbsp;billion net
            carrying value.</li>
            <li>Total debt is borrowings at net carrying value and excludes
            lease liabilities, which both companies report separately under
            ASC 842: $16.5B at CoreWeave and $1.5B non-current at Nebius at
            June 30, 2026. Including leases moves the pair from 28% / 70% to
            about 19% / 59% [computed; Nebius does not separately disclose
            its current lease portion, so its adjusted figure is slightly
            understated]. The ordering does not change.</li>
          </ul>
        </details>
      </figcaption>
    </figure>

    <h2>1 · The Guidance Layer</h2>
    <p>
      Nebius wrote that it is "reaffirming our full-year 2026 guidance
      across all metrics" and raised its year-end contracted-power
      guide from more than 4&nbsp;GW to
      5&nbsp;GW.<sup class="fnr"><a href="#fn1">1</a></sup> CoreWeave
      raised its full-year revenue guide and its capital expenditure
      (capex) guide.<sup class="fnr"><a href="#fn2">2</a></sup> A year
      ago both companies guided far lower. The table shows the same
      measures twelve months apart.
    </p>
    <div class="gtable-wrap">
      <table class="gtable">
        <thead>
          <tr><th></th><th>August 2025</th><th>August 2026</th><th>Change</th></tr>
        </thead>
        <tbody>
          <tr><td>CoreWeave full-year revenue guide<sup class="fnr"><a href="#fn2">2</a></sup></td>
            <td>$5.15–5.35B <span class="dim">(FY25)</span></td>
            <td>$12.4–13.2B <span class="dim">(FY26)</span></td>
            <td>~2.4×</td></tr>
          <tr><td>CoreWeave capex guide<sup class="fnr"><a href="#fn2">2</a></sup></td>
            <td>$20–23B <span class="dim">(FY25)</span></td>
            <td>$35–39B <span class="dim">(FY26)</span></td>
            <td>~1.7×</td></tr>
          <tr><td>CoreWeave Q2 revenue</td>
            <td>$1.2B</td>
            <td>$2.6B</td>
            <td>2.1×</td></tr>
          <tr><td>Nebius year-end ARR guide</td>
            <td>$0.9–1.1B <span class="dim">(YE25)</span></td>
            <td>$7–9B <span class="dim">(YE26)</span></td>
            <td>~8×</td></tr>
          <tr><td>Nebius Q2 revenue</td>
            <td>$105.1M</td>
            <td>$582.3M</td>
            <td>5.5×</td></tr>
          <tr><td>Nebius contracted-power guide<sup class="fnr"><a href="#fn1">1</a></sup></td>
            <td>&gt;1 GW <span class="dim">(YE25)</span></td>
            <td>5 GW <span class="dim">(YE26)</span></td>
            <td>~5×</td></tr>
        </tbody>
      </table>
      <p class="gtable-note">ARR is annual recurring revenue. Change
      column compares range midpoints; the power row compares stated
      floors. Guide sources and dates are in Sources &amp; method.</p>
    </div>

    <h2>2 · The Cash Evidence</h2>
    <p>
      Both figures come from balance sheets on EDGAR, dated
      June&nbsp;30, 2026.
      CoreWeave's 10-Q, filed August&nbsp;12, puts deferred revenue at
      $9.7&nbsp;billion, up from $8.2&nbsp;billion at year-end. Nebius
      reports $6.0&nbsp;billion, split $1.0&nbsp;billion current and
      $5.0&nbsp;billion non-current, up from $1.6&nbsp;billion at
      year-end 2025. Deferred revenue here is
      cash customers have already paid for compute not yet delivered.
    </p>
    <p>
      The Nebius balance now stands at about 70% of its
      $8.5&nbsp;billion debt stack. Customers fund its buildout at
      nearly the scale lenders do.
    </p>

    <figure class="fig">
      <div class="fig-title">Deferred revenue, $B · Dec ’23 – Jun ’26 · EDGAR balance sheets</div>
      <div class="legend">
        <span class="lg"><span class="sw" style={`background:${C_CRWV}`}></span>CoreWeave</span>
        <span class="lg"><span class="sw" style={`background:${C_NBIS}`}></span>Nebius</span>
      </div>
      <svg viewBox={`0 0 ${XW} ${H1}`} role="img" aria-label="Deferred revenue in billions of dollars, December 2023 to June 2026. CoreWeave rises from 2.0 to 9.7 billion in a broad ramp with a dip in the first quarter of 2026. Nebius holds near zero until the third quarter of 2025, then steps to 1.6, 4.8, and 6.0 billion.">
        {Y1_TICKS.map((t) => (
          <>
            <line x1={XL} y1={y1(t)} x2={XW - XR} y2={y1(t)} class="grid" />
            <text x={XL - 8} y={y1(t) + 3} class="tick t-end">{t}</text>
          </>
        ))}
        {X_TICKS.map((t) => (
          <text x={xm(t.m)} y={H1 - B1 + 20} class="tick t-mid">{t.l}</text>
        ))}
