---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CiteBlock from '../components/CiteBlock.astro';
import TermCurveChart from '../components/TermCurveChart.astro';
// HyperscalerLadders retired from the page 2026-08-12 (see section 02 note).
// HyperscalerTermChart PULLED same-day it shipped (John, 2026-07-16): T1 US
// cells were n=2-4 and cell-to-cell %s manufactured a fake H200 "1Y −26%"
// (within-provider truth: −7%). REINSTATED 2026-08-12 (John): every T1 US
// committed cell now prints the same three-provider panel (aws|azure|gcp)
// after the aws RI convertible-fallback fix landed the missing H100 1Y
// lane. Levels-only construction unchanged; OD dot stays detached (OD adds
// OCI, n=4). Per-provider ladders below remain the within-book view.
import HyperscalerTermChart from '../components/HyperscalerTermChart.astro';
import { meta } from '../data/snapshot';
import { CHIPS } from '../data/chips';
// Implied-forwards section CUT (John 2026-07-02): with the par curve's OD
// anchor moving to the pooled NEOCLOUD band OD (apples-to-apples), the
// derived step chart adds confusion without adding signal for most readers.
// The within-provider forwards DATA still ships in committed_mi.csv and
// ForwardStepChart.astro (already rewired to it) stays in src/components —
// reinstating is one import + one tag.
---
<Base
  title="GPU Reserved & Committed Pricing — 1M to 3Y Term Structure · CCIR"
  description="Reserved and committed GPU pricing by tenor, one month to three years — posted committed asks and each operator's discount to on-demand, updated daily. The term structure of GPU compute, and the basis for sizing re-leasing risk on GPU-backed exposure."
  ogImage="/og/term-structure-2026-07.png"
>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: 'CCIR GPU Committed Term Structure',
    description: 'Reserved and committed GPU pricing by tenor, one month to three years — posted committed asks and within-provider discounts to on-demand, computed daily as the operator-equal median of each operator’s committed ask against its own on-demand rate.',
    url: 'https://ccir.io/term',
    creator: { '@type': 'Organization', name: 'CCIR', url: 'https://ccir.io' },
    temporalCoverage: '2026-05/..',
    keywords: [
      'GPU reserved pricing', 'committed GPU pricing', 'GPU term structure',
      'H100 1 year price', 'H100 3 year reserved', 'GPU commitment discount',
      'reserved instance GPU pricing', 'long-term GPU rental rates',
      'GPU lease rates', 'multi-year GPU contract pricing',
    ],
    license: 'https://ccir.io/documents/data-terms',
    isAccessibleForFree: true,
  })} />
  <section class="wrap page-top">
    <PageHeader title="Committed Term Structure" kicker="Market Intelligence · Committed Term" asOf={meta.as_of_date}>
      <p class="standfirst">
        The price of guaranteed capacity, by tenor. Posted committed asks from
        one month to three years, and the discount each tenor carries to
        on-demand.
      </p>
    </PageHeader>

    <aside class="mi-banner" role="note">
      <strong>A market-intelligence series on committed-term pricing.</strong>
      Committed-term cells are a descriptive market-intelligence product, not
      a citable reference rate. A committed price is a <strong>fixed
      schedule</strong>: the posted price of a commitment starting today,
      held for its term. It is not a forecast of future on-demand rates.
      Construction, geographic scope, and panel-depth conventions are in the
      chart notes beneath the figure.
    </aside>

    <section class="curve-section">
      <header class="sec-head">
        <div class="kicker">Section 01 · Committed asks by tenor</div>
        <h2>The Neocloud Committed Term Curve</h2>
      </header>

      <TermCurveChart />
      <p class="instrument-note">
        Per-chip instrument pages:
        {CHIPS.map((c, i) => (
          <>{i > 0 && ' · '}<a href={`/chip/${c.slug}`}>{c.short}</a></>
        ))}
        &nbsp;· <a href="/chips">all chips →</a>
      </p>
      <p class="population-note">
        The curve above is computed from operators that post tenor ladders:
        committed rates quoted as discounts to their own on-demand asks.
        Capacity-guarantee contracts sold as flexible bands (take-or-pay
        blocks, duration-banded clusters) are a different product kind.
        They are recorded as their own series and shown at their duration
        below, never blended into this curve, including where they price
        <em>above</em> the operator's own on-demand list.
      </p>
    </section>

    <section class="curve-section">
      <header class="sec-head">
        <div class="kicker">Section 02 · Named operators, published schedules</div>
        <h2>Hyperscaler Reservation Schedules</h2>
      </header>

      <HyperscalerTermChart />
      {/* HyperscalerLadders (H100-only per-provider schedules) RETIRED from
          the page 2026-08-12 (John): the multi-chip uniform-panel chart
          above covers the section; component stays in src/components. */}
    </section>

    <CiteBlock what="GPU Committed Term Structure" path="/term" date={meta.as_of_date} />
  </section>

  <style>
    /* Page chrome (.page-top/.page-head/.mi-banner/.sec-head) is global — base.css. */
    .sec-lede {
      font-family: var(--font-mono);
      font-size: var(--fs-sm);
      color: var(--ink-dim);
      line-height: 1.6;
      margin: 0 0 4px;
    }

    .curve-section { margin: 0 0 36px; }

    .instrument-note {
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      color: var(--ink-dim);
      margin: 14px 0 0;
    }
    .instrument-note a { color: var(--link); }

    .population-note {
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      color: var(--ink-dim);
      line-height: 1.7;
      max-width: 720px;
      margin: 14px 0 0;
      padding-top: 10px;
      border-top: 1px solid var(--rule);
    }
    .mi-more {
      margin: 0 0 36px;
      padding: 12px 16px;
      border: 1px solid var(--rule);
      background: var(--surface);
      max-width: 84ch;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .mi-more a {
      font-family: var(--font-mono);
      font-size: var(--fs-sm);
      color: var(--link);
      line-height: 1.5;
    }
  </style>
</Base>
