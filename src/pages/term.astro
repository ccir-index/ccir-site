---
import Base from '../layouts/Base.astro';
import { printLine } from '../lib/printline';
import PageHeader from '../components/PageHeader.astro';
import CiteBlock from '../components/CiteBlock.astro';
// HyperscalerLadders retired from the page 2026-08-12 (see section 05 note).
// HyperscalerTermChart PULLED same-day it shipped (John, 2026-07-16): T1 US
// cells were n=2-4 and cell-to-cell %s manufactured a fake H200 "1Y −26%"
// (within-provider truth: −7%). REINSTATED 2026-08-12 (John): every T1 US
// committed cell now prints the same three-provider panel (aws|azure|gcp)
// after the aws RI convertible-fallback fix landed the missing H100 1Y
// lane. Levels-only construction unchanged; OD dot stays detached (OD adds
// OCI, n=4). Per-provider ladders below remain the within-book view.
import HyperscalerTermChart from '../components/HyperscalerTermChart.astro';
import { meta, neocloudCommittedCell, headlineValue } from '../data/snapshot';
import { CHIPS } from '../data/chips';
import type { Term } from '../data/types';
import ChipLink from '../components/ChipLink.astro';
// Construction B (John, 2026-09-23): global neocloud on-demand x the chip's
// own tenor factor, and the signed-rate layer from filed contracts. Ported
// from term/ladder-preview (99099d90, 1894ad95) in the market-data voice.
import { B_CHIPS, B_TENORS, bCurve, conCell, renewalOptions, vintagePoints, CON_WINDOW_START } from '../data/term_b';
import type { BTenor, BundledDeal } from '../data/term_b';
import { gpuWeighted } from '../data/term_b';

const fmt = (n: number, dp = 2) => n.toFixed(dp);
const chipDisplay = (token: string) => token.replace(/-/g, ' ');

// --- Section 01: the term ladder (construction B) ---------------------------
// Every cell = global neocloud on-demand x the chip's own tenor factor
// (src/data/term_b.ts). Seller counts stay off the page.
const COLS = ['OnDemand', ...B_TENORS] as const;
type Col = typeof COLS[number];
const colLabel = (c: Col) => (c === 'OnDemand' ? 'On-demand' : c);
const pctText = (f: number) => `${f < 0 ? '−' : '+'}${Math.abs(f * 100).toFixed(1)}%`;

interface LadderCell { value: number; style: 'full' | 'thin'; title: string }
function ladderCell(chip: string, col: Col): LadderCell | null {
  const c = bCurve(chip);
  if (!c.od) return null;
  if (col === 'OnDemand') {
    return { value: c.od.value, style: 'full', title: `${chip} global neocloud on-demand, median across sellers · ${c.asOf}` };
  }
  const cell = c.cells[col];
  if (!cell) return null;
  return {
    value: cell.value,
    style: cell.depth,
    title: `${chip} ${col} = on-demand ${fmt(c.od.value)} × (1 ${cell.factor < 0 ? '−' : '+'} ${Math.abs(cell.factor * 100).toFixed(1)}%)`,
  };
}

const ladderChips = B_CHIPS.map((x) => x.chip).filter((chip) => chip !== 'GB200' && bCurve(chip).od);  // GB200 off the ladder (John, 2026-09-24): on-demand only, no tenors
const ladder = ladderChips.map((chip) => ({ chip, cells: COLS.map((col) => ({ col, cell: ladderCell(chip, col) })) }));
const curveAsOf = bCurve('H100').asOf;

// Seller spread per cell, for the details (no names).
const spreadLines = ladderChips.flatMap((chip) => B_TENORS.flatMap((t) => {
  const sf = bCurve(chip).sellerFactors[t];
  if (!sf || sf.length < 2) return [];
  return [`${chipDisplay(chip)} ${t} ${pctText(sf[0]!.factor)} to ${pctText(sf[sf.length - 1]!.factor)}`];
}));

// Direct term asks: the disclosed check, from the daily record's pooled
// neocloud committed cells. The record now also carries the pipeline's
// modeled (-MOD, "Modeled (preview)") rows, and snapshot.ts does not filter
// them out of neocloudCommittedCell, so a modeled row is skipped here.
const checkLines = ladderChips.flatMap((chip) => B_TENORS.flatMap((t) => {
  const d = neocloudCommittedCell(chip, t as Term);
  const c = bCurve(chip).cells[t];
  if (!d || !c || d.series_id.endsWith('-MOD')) return [];
  const pct = (headlineValue(d) / c.value - 1) * 100;
  return [`${chipDisplay(chip)} ${t} ${fmt(headlineValue(d))} (${pct < 0 ? '−' : '+'}${Math.abs(pct).toFixed(0)}%)`];
}));

// --- Section 02: posted, signed, gap ----------------------------------------
const covBlocks = ladderChips.map((chip) => {
  const cells = COLS.map((col) => {
    const posted = ladderCell(chip, col);
    const con = col === 'OnDemand' ? null : conCell(chip, col);
    const gap = con?.rate != null && posted && col !== 'OnDemand' ? (con.rate / posted.value - 1) * 100 : null;
    return { col, posted, con, gap };
  });
  return { chip, cells };
});
const signedPct = (pct: number) => `${pct < 0 ? '−' : '+'}${Math.abs(pct).toFixed(0)}%`;
const bundledText = (x: BundledDeal) => x.estimated
  ? `${fmt(x.value)} estimated GPU-only (filed ${fmt(x.filed)}, ${x.includes})`
  : `${fmt(x.value)} ${x.includes}`;
const conLines = covBlocks.flatMap((b) => b.cells.flatMap(({ col, con }) => {
  if (!con) return [];
  const parts: string[] = [];
  if (con.rate != null) parts.push(con.min === con.max ? fmt(con.rate) : `${fmt(con.rate)} GPU-weighted, range ${fmt(con.min!)} to ${fmt(con.max!)}`);
  if (con.bundled.length) parts.push(`Bundled inside: ${con.bundled.map(bundledText).join('; ')}`);
  return [`${chipDisplay(b.chip)} ${col}: ${parts.join('. ')}.`];
}));
const fourYearLines = ladderChips.flatMap((chip) => {
  const con = conCell(chip, '4Y');
  if (!con) return [];
  const parts: string[] = [];
  if (con.rate != null) parts.push(fmt(con.rate));
  if (con.bundled.length) parts.push(`Bundled inside: ${con.bundled.map(bundledText).join('; ')}`);
  return [`${chipDisplay(chip)} 4Y: ${parts.join('. ')}.`];
});
const optionLines = ladderChips.flatMap((chip) => renewalOptions(chip).map((o) => `${chipDisplay(chip)} ${o.raw}: ${fmt(o.value)}`));

// --- Section 03: signed rates by vintage (table) -----------------------------
// Rows = chip x tenor with at least one GPU-only deal; columns = signing
// half-years that hold a deal; last column = today's posted ladder value.
// A cell is the sqrt-GPU-weighted average of deals signed in that half (John,
// 2026-09-24); hover lists each deal. Bundled deals enter at their GPU-only
// estimate. Renewal options and subsidized deals stay out.
// The standalone B300 chart from the preview is replaced by a link to the
// published note /research/b300-contract-prices, which covers it deal by deal.
const VINTAGE_CHIPS = ['H100', 'H200', 'B200', 'B300', 'GB200'];
const V_TENORS = ['6M', '1Y', '2Y', '3Y', '4Y', '5Y'];
const half = (iso: string) => `${iso.slice(0, 4)} H${Number(iso.slice(5, 7)) <= 6 ? 1 : 2}`;
const vGpu = vintagePoints().filter((p) => VINTAGE_CHIPS.includes(p.chip) && !p.option);
const halves = [...new Set(vGpu.map((p) => half(p.signed)))].sort();
const vintageRows = VINTAGE_CHIPS.flatMap((chip) => V_TENORS.flatMap((tenor) => {
  const pts = vGpu.filter((p) => p.chip === chip && p.tenor === tenor);
  if (pts.length === 0) return [];
  const cells = halves.map((h) => {
    const inH = pts.filter((p) => half(p.signed) === h).sort((a, b) => a.value - b.value);
    if (inH.length === 0) return null;
    const title = inH.map((p) => `${fmt(p.value)}${p.bundled ? ' est. GPU-only' : ''} (${p.gpus?.toLocaleString('en-US') ?? '?'} GPUs)`).join(', ');
    return { value: gpuWeighted(inH), bundled: inH.some((p) => p.bundled), title };
  });
  const posted = B_CHIPS.some((x) => x.chip === chip) ? bCurve(chip).cells[tenor as BTenor] : undefined;
  return [{ chip, tenor, cells, posted }];
}));
// Implied-forwards section CUT (John 2026-07-02) and the metric itself
// RETIRED (John 2026-09-16, v2.4.0): subtracting one contract's total from
// the next only yields a marginal-period price when both carry the same
// discount per hour, and posted ladders do not. committed_mi.csv now ships
// spread_to_spot only; ForwardStepChart.astro stays in src/components as a
// record and must not be reinstated without a new ruling.
---
<Base
  title="GPU Term Rates: Reserved and Signed Contract Prices by Tenor · CCIR"
  description="GPU term rates by tenor: signed contract prices from SEC filings by vintage, the posted reserved-price ladder for H100, H200, B200 and B300, and the gap between them. Updated daily."
  ogImage="/og/term-structure-2026-07.png"
>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: 'CCIR GPU Committed Term Rates',
    description: 'Committed-term GPU rental rates by tenor. Each cell is the chip’s global neocloud on-demand rate times the chip’s own tenor factor, computed daily from posted prices. Signed rates from filed contracts sit beside the posted cells.',
    url: 'https://ccir.io/term',
    creator: { '@type': 'Organization', name: 'CCIR', url: 'https://ccir.io' },
    temporalCoverage: '2026-05/..',
    keywords: [
      'GPU reserved pricing', 'committed GPU pricing', 'GPU term structure',
      'H100 1 year price', 'H100 3 year reserved', 'GPU commitment discount',
      'reserved instance GPU pricing', 'long-term GPU rental rates',
      'GPU lease rates', 'multi-year GPU contract pricing',
    ],
    license: 'https://ccir.io/documents/data-terms',
    isAccessibleForFree: true,
  })} />
  <section class="wrap page-top">
    <PageHeader title="Committed Term Rates" kicker="Market Data · Committed Term · Global" asOfLabel="" asOf={printLine(meta)}>
      <p class="standfirst">
        The price of guaranteed capacity by tenor, for the chips lenders
        finance. Posted rates start from each chip's global on-demand rate.
        Signed rates from filed contracts sit beside them.
      </p>
      <ul class="lede-index">
        <li><span class="arw">→</span> <a href="/research/b300-contract-prices">Signed B300 contract rates, March to August 2026</a></li>
      </ul>
    </PageHeader>

    <aside class="mi-banner" role="note">
      <strong>Committed-term rates from posted asks and filed contracts.</strong>
      A committed price is a <strong>fixed schedule</strong>: the posted price
      of a commitment that starts today, held for its term. It does not
      forecast future on-demand rates. Each table's notes give its
      construction and scope.
    </aside>

    <section class="curve-section vintage-section">
      <header class="sec-head">
        <div class="kicker">Section 01 · Signed rates by vintage</div>
        <h2>Signed Rates by Vintage</h2>
      </header>
      <div class="table-wrap">
        <div class="table-head">
          <span class="th-scope">Filed deals, GPU-only, GPU-weighted by signing half-year</span>
          <span class="th-meta">USD/GPU-hr</span>
        </div>
        <table class="data vintage-table">
          <thead>
            <tr>
              <th class="chip-col">Silicon · tenor</th>
              {halves.map((h) => <th class="tenor-col">{h}</th>)}
            </tr>
          </thead>
          <tbody>
            {vintageRows.map((r, i) => (
              <tr class={i > 0 && vintageRows[i - 1]!.chip !== r.chip ? 'chip-break' : ''}>
                <td class="chip-cell"><span class="chip-name">{i === 0 || vintageRows[i - 1]!.chip !== r.chip ? chipDisplay(r.chip) : ''}</span> <span class="layer-tag">{r.tenor}</span></td>
                {r.cells.map((c) => c
                  ? <td class="num v-con" title={c.title}>{fmt(c.value)}{c.bundled && <sup class="mod-mark">b</sup>}</td>
                  : <td class="num empty">·</td>)}
              </tr>
            ))}
          </tbody>
        </table>
        <div class="ladder-legend">
          Each cell is the signed rate of deals signed in that half-year, weighted by deal size. Hover for the deals.
          <sup class="mod-mark lg-m">b</sup>: holds a bundled deal at its GPU-only estimate.
          Renewal options and subsidized deals are excluded.
        </div>
      </div>
      <p class="instrument-note">
        B300 deal by deal, with sellers, buyers, trends and filing links:
        <a href="/research/b300-contract-prices">Signed B300 contract rates, March to August 2026 →</a>
      </p>
    </section>

    <section class="curve-section ladder-section">
      <header class="sec-head">
        <div class="kicker">Section 02 · The term ladder</div>
        <h2>The Term Ladder</h2>
      </header>

      <div class="table-wrap">
        <div class="table-head">
          <span class="th-scope">Neocloud, guaranteed · all regions</span>
          <span class="th-meta">USD/GPU-hr · {curveAsOf} listings</span>
        </div>
        <table class="data ladder-table term-ladder">
          <thead>
            <tr>
              <th class="chip-col">Silicon</th>
              {COLS.map((col) => <th class="tenor-col">{colLabel(col)}</th>)}
            </tr>
          </thead>
          <tbody>
            {ladder.map(({ chip, cells }) => (
              <tr>
                <td class="chip-cell"><div class="chip-name"><ChipLink chip={chip} label={chipDisplay(chip)} /></div></td>
                {cells.map(({ cell }) =>
                  cell
                    ? <td class={`num v-${cell.style}`} title={cell.title}>{fmt(cell.value)}</td>
                    : <td class="num empty">—</td>
                )}
              </tr>
            ))}
          </tbody>
        </table>
        <div class="ladder-legend">
          <span class="lg-full">Accent</span>: tenor factor from three or more sellers ·
          <span class="lg-thin">muted</span>: two sellers · —: fewer, or no seller posts the tenor.
          Hover a cell for its construction.
        </div>
        <details class="table-foot">
          <summary>How the ladder is built</summary>
          <div class="tf-body tf-prose">
            <p>Every cell is the chip's on-demand rate times the chip's own
            tenor factor. On-demand is the median across neocloud sellers in
            every region, each seller counted once. A tenor factor compares each
            seller's term ask with its own on-demand ask in the same region. The
            factor is the median of those ratios across sellers. A chip never
            borrows another chip's factor. A longer tenor can price above a
            shorter one when sellers post it that way.</p>
            <p>Hyperscaler reservation schedules stay out of the factors.
            Section 04 shows them.</p>
            {spreadLines.length > 0 && <p>Seller discounts vary widely. The range at each cell: {spreadLines.join(' · ')}.</p>}
            {checkLines.length > 0 && <p>The daily record also carries direct posted term asks. We use them
            as a check. Each shows the gap to the ladder value: {checkLines.join(' · ')}.</p>}
          </div>
        </details>
      </div>
    </section>

    <section class="curve-section covenant-section">
      <header class="sec-head">
        <div class="kicker">Section 03 · Posted and signed</div>
        <h2>Posted and Signed Rates</h2>
      </header>

      <div class="table-wrap">
        <div class="table-head">
          <span class="th-scope">Signed: filed deals, GPU-only, signed from {CON_WINDOW_START}</span>
          <span class="th-meta">USD/GPU-hr</span>
        </div>
        <table class="data ladder-table cov-table">
          <thead>
            <tr>
              <th class="chip-col">Silicon · layer</th>
              {COLS.map((col) => <th class="tenor-col">{colLabel(col)}</th>)}
            </tr>
          </thead>
          {covBlocks.map((b) => (
            <tbody class="cov-block">
              <tr>
                <td class="chip-cell"><span class="chip-name"><ChipLink chip={b.chip} label={chipDisplay(b.chip)} /></span> <span class="layer-tag">Posted</span></td>
                {b.cells.map(({ posted }) => posted
                  ? <td class={`num v-${posted.style}`} title={posted.title}>{fmt(posted.value)}</td>
                  : <td class="num empty">—</td>)}
              </tr>
              <tr>
                <td class="chip-cell"><span class="layer-tag">Signed</span></td>
                {b.cells.map(({ con }) => con?.rate != null
                  ? <td class="num v-con" title={`${con.n} deal${con.n === 1 ? '' : 's'}, ${con.gpus.toLocaleString('en-US')} GPUs${con.min === con.max ? '' : `, range ${fmt(con.min!)} to ${fmt(con.max!)}`}${con.bundled.length ? `. Bundled: ${con.bundled.map(bundledText).join('; ')}` : ''}`}>{fmt(con.rate)}{con.bundled.length > 0 && <sup class="mod-mark">b</sup>}</td>
                  : <td class="num empty">—</td>)}
              </tr>
              <tr class="cov-row-gap">
                <td class="chip-cell"><span class="layer-tag">Gap</span></td>
                {b.cells.map(({ gap }) => gap != null
                  ? <td class="num v-gap" title="signed rate vs posted ladder value">{signedPct(gap)}</td>
                  : <td class="num empty">—</td>)}
              </tr>
            </tbody>
          ))}
        </table>
        <div class="ladder-legend">
          Posted: the ladder above · Signed: filed deals, weighted by deal size ·
          <sup class="mod-mark lg-m">b</sup>: holds a bundled deal at its GPU-only estimate, hover for details ·
          Gap: signed vs posted
        </div>
        <details class="table-foot">
          <summary>How to read the signed rates</summary>
          <div class="tf-body tf-prose">
            <p>A signed rate is the price in a filed contract at its tenor. A
            filing states a rate, or a unit count, a term and a value. We divide
            the value by GPUs times term hours and bill every hour at a flat
            price. We leave out deals priced under a government subsidy.</p>
            <p>Each cell holds deals signed in the twelve months before the
            snapshot date. Each deal weighs by the square root of its GPU count. The vintage table in Section 01 shows older deals.</p>
            {conLines.length > 0 && <p>{conLines.join(' ')}</p>}
            {fourYearLines.length > 0 && <p>{fourYearLines.join(' ')}</p>}
            {optionLines.length > 0 && <p>Renewal options, listed and never pooled: {optionLines.join(' · ')}.</p>}
            <p>A bundled deal prices more than the GPU, such as storage,
            networking or data center services, with no split. It enters at a
            GPU-only estimate. For three B300 deals we price the CPU servers and
            storage out one by one. Every other bundled deal enters at its filed
            rate less 5%, the size of those three deductions. The filed value
            appears on hover.</p>
            <p>SharonAI states its B300 rate inclusive of taxes. We treat the
            $3.30 as pre-tax, as the B300 note does.</p>
            <p>Disclosure selection is a limit. The sellers that disclose unit
            counts are small listed companies.</p>
          </div>
        </details>
      </div>
    </section>

    <p class="instrument-note">
      Per-chip pages:
      {CHIPS.map((c, i) => (
        <>{i > 0 && ' · '}<a href={`/chip/${c.slug}`}>{c.short}</a></>
      ))}
      &nbsp;· <a href="/chips">all chips →</a>
    </p>

    <section class="curve-section">
      <header class="sec-head">
        <div class="kicker">Section 04 · Named operators, published schedules</div>
        <h2>Hyperscaler Reservation Schedules</h2>
      </header>

      <HyperscalerTermChart />
      {/* HyperscalerLadders (H100-only per-provider schedules) RETIRED from
          the page 2026-08-12 (John): the multi-chip uniform-panel chart
          above covers the section; component stays in src/components. */}
    </section>

    <CiteBlock what="GPU Committed Term Rates" path="/term" date={meta.as_of_date} />
  </section>

  <style>
    /* Page chrome (.page-top/.page-head/.mi-banner/.sec-head) is global — base.css. */
    .curve-section { margin: 0 0 36px; }

    /* Sections 01 / 02: row height and padding come from table.data
       (base.css), the same as the /rates ladder. Both tables share one
       geometry: fixed layout, the same chip-column width, the remaining
       width split equally across the tenor columns, so every tenor sits at
       the same x position in 01 and 02. */
    table.term-ladder, table.cov-table { width: 100%; border-collapse: collapse; table-layout: fixed; }
    table.term-ladder th.chip-col,
    table.cov-table th.chip-col { text-align: left; width: 22%; }
    table.term-ladder th.tenor-col,
    table.cov-table th.tenor-col { text-align: center; padding: 10px 12px; }
    table.term-ladder .chip-cell,
    table.cov-table .chip-cell { white-space: nowrap; }
    table.term-ladder .chip-cell .chip-name,
    table.cov-table .chip-cell .chip-name {
      font-family: var(--font-mono);
      font-size: var(--fs-md);
      color: var(--ink);
      font-weight: var(--weight-strong);
      letter-spacing: 0.04em;
    }
    table.term-ladder td.num,
    table.cov-table td.num {
      text-align: center;
      font-family: var(--font-mono);
      font-size: var(--fs-lg);
      font-variant-numeric: tabular-nums;
    }
    table.cov-table td.num { font-size: var(--fs-md); }
    table.term-ladder td.empty,
    table.cov-table td.empty { color: var(--ink-faint); }
    .mod-mark {
      font-size: 0.55em;
      font-weight: var(--weight-body);
      font-style: normal;
      margin-left: 2px;
      vertical-align: super;
      line-height: 0;
      letter-spacing: 0;
    }
    /* Depth styles: accent bold = three or more sellers, muted = two. */
    td.v-full { font-weight: var(--weight-strong); color: var(--accent); cursor: help; }
    td.v-thin { font-weight: var(--weight-body); color: var(--ink-faint); cursor: help; }
    /* Signed: plain ink. Bundled: dim with a superscript b. Gap: muted. */
    td.v-con { font-weight: var(--weight-body); color: var(--ink); }
    td.v-bundled { font-weight: var(--weight-body); color: var(--ink-dim); cursor: help; }
    td.v-gap { font-weight: var(--weight-body); color: var(--ink-dim); cursor: help; }
    .layer-tag {
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      color: var(--ink-dim);
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
    table.cov-table .chip-cell .chip-name + .layer-tag { margin-left: 6px; }
    /* Chip blocks: hairline between sub-rows, a firmer rule between chips. */
    table.cov-table tbody.cov-block tr.cov-row-gap td { border-bottom: 1px solid var(--rule-2); }
    .ladder-legend {
      padding: 8px 16px;
      border-top: 1px solid var(--rule-2);
      font-family: var(--font-mono);
      font-size: calc(var(--fs-xs) - 1px);
      color: var(--ink-dim);
      letter-spacing: 0.02em;
      line-height: 1.6;
    }
    .ladder-legend .lg-full { color: var(--accent); font-weight: var(--weight-strong); }
    .ladder-legend .lg-thin { color: var(--ink-faint); }
    .ladder-legend .lg-m { font-size: 0.8em; margin-left: 0; color: var(--ink); vertical-align: super; }
    .tf-prose p { margin: 0 0 6px; max-width: 72ch; }

    /* Section 03: vintage table. */
    table.vintage-table { width: 100%; border-collapse: collapse; table-layout: fixed; }
    table.vintage-table th.chip-col { text-align: left; width: 20%; }
    table.vintage-table th.tenor-col { text-align: center; padding: 10px 8px; }
    table.vintage-table td.num { text-align: center; font-family: var(--font-mono); font-size: var(--fs-md); font-variant-numeric: tabular-nums; }
    table.vintage-table td.empty { color: var(--ink-faint); }
    table.vintage-table .chip-cell .chip-name { font-family: var(--font-mono); font-size: var(--fs-md); color: var(--ink); font-weight: var(--weight-strong); letter-spacing: 0.04em; }
    table.vintage-table tr.chip-break td { border-top: 1px solid var(--rule-2); }
    table.vintage-table .posted-col { border-left: 1px solid var(--rule-2); }

    @media (max-width: 700px) {
      table.term-ladder th, table.term-ladder td,
      table.cov-table th, table.cov-table td,
      table.vintage-table th, table.vintage-table td { padding-left: 4px; padding-right: 4px; }
      table.term-ladder th.tenor-col, table.cov-table th.tenor-col,
      table.vintage-table th.tenor-col { padding: 8px 4px; }
