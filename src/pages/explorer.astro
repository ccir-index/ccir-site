---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { headlineRates, meta, headlineStatOf, seriesHistory } from '../data/snapshot';
import { TIERS, TIER_LABELS, REGION_LABELS } from '../data/types';

// Trend column removed 2026-07-06 ("a 30d window reads as composition change,
// not market movement"), RESTORED 2026-08-03 on John's call: panel changes are
// inevitable and are tracked per the methodology and changelog, so the trend is
// worth showing rather than withholding. The window is labeled and the sparkline
// is drawn from the same medians /rates publishes; n for the current print stays
// in its own column.
const SPARK_W = 58;
const SPARK_H = 16;
const SPARK_DAYS = 30;

// Precomputed here, not in the client script: the table body is rendered from a
// plain JS array, so each row carries a finished polyline + change figure.
// Drawn from the HEADLINE value, not the median: the headline stat is the
// n>=10 mean on some series and the median on the rest, so a median-based
// trend contradicts the daily number on exactly the flagship cells
// (CRI-T2-H100-ALL-GTD-OD-US: median 3.6400->3.9025 = +7.2%, headline
// 3.5681->3.7534 = +5.2%). The chart has to tie to what /rates publishes.
function spark(seriesId: string, headlineNow: number) {
  const hist = seriesHistory(seriesId).slice(-SPARK_DAYS);
  const pts = hist.length ? hist.map((h) => h.headline) : [];
  if (pts.length && pts[pts.length - 1] !== headlineNow) pts.push(headlineNow);
  if (pts.length < 2) return { path: '', change: null as number | null };
  const lo = Math.min(...pts);
  const hi = Math.max(...pts);
  const span = hi - lo;
  const dx = SPARK_W / (pts.length - 1);
  const path = pts
    .map((v, i) => {
      const y = span === 0 ? SPARK_H / 2 : SPARK_H - 1 - ((v - lo) / span) * (SPARK_H - 2);
      return `${(i * dx).toFixed(1)},${y.toFixed(1)}`;
    })
    .join(' ');
  const first = pts[0]!;
  return { path, change: first > 0 ? (pts[pts.length - 1]! / first - 1) * 100 : null };
}

const FORM_ORDER = ['SXM', 'PCIe', 'NVL', 'ALL'];
const REGION_ORDER = ['US', 'EU', 'APAC', 'Other', 'ALL'];
const CHIP_ORDER = ['GB200', 'GB300', 'B300', 'B200', 'H200', 'H100', 'A100', 'MI300X',
  'L40S', 'L40', 'L4', 'RTXPRO6000', '5090', '4090', 'A40', 'A30', '3090', 'V100'];

// One pool: every operator-segment series, dropping the fully-pooled cell
// (form=int=region=ALL) — that headline blend lives on /rates. What's left is
// the grain breakouts: by form, by interruptibility, by region.
const source = headlineRates.filter(
  (r) => !(r.form_factor === 'ALL' && r.interruptibility === 'ALL' && r.region === 'ALL'),
);

const forms = Array.from(new Set(source.map((r) => r.form_factor)))
  .filter((f) => f !== 'ALL')
  .sort((a, b) => FORM_ORDER.indexOf(a) - FORM_ORDER.indexOf(b));
const regions = Array.from(new Set(source.map((r) => r.region)))
  .filter((rg) => rg !== 'ALL')
  .sort((a, b) => REGION_ORDER.indexOf(a) - REGION_ORDER.indexOf(b));
const chips = Array.from(new Set(source.map((r) => r.gpu_model)))
  .sort((a, b) => {
    const ai = CHIP_ORDER.indexOf(a), bi = CHIP_ORDER.indexOf(b);
    return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi) || a.localeCompare(b);
  });

const rows = source.map((r) => ({
  id: r.series_id,
  tier: r.tier!,
  tier_label: TIER_LABELS[r.tier!],
  chip: r.gpu_model,
  form: r.form_factor,
  region: r.region,
  region_label: REGION_LABELS[r.region],
  interrupt: r.interruptibility,
  mean: r.price_mean,
  median: r.price_median,
  // Which stat the published headline uses for this series (n≥10 mean, else
  // median) — highlighted in the table so explorer numbers tie to /rates.
  hstat: headlineStatOf(r),
  p25: r.price_p25,
  p75: r.price_p75,
  n_src: r.n_sources,
  // Trend shown ONLY where the headline stat is the n>=10 mean (John,
  // 2026-08-03). Median-headline series are the thin ones — at the extreme,
  // CRI-T3-B200-SXM-INT-OD-US is a single source (HHI 10,000) whose "30d
  // move" is one marketplace repricing its own listings. A sparkline next to
  // those reads as a market trend and isn't one. Everything else renders "—".
  ...(() => {
    if (headlineStatOf(r) !== 'mean') return { spark_path: '', d30: null };
    const s = spark(r.series_id, r.price_mean);
    return { spark_path: s.path, d30: s.change };
  })(),
}));
---
<Base
  title="GPU Price Data Explorer — Rate History Download · CCIR"
  description="The whole compute market, unfiltered — every series, every chip, every grain. Filter by segment, chip, form, interruptibility, and region."
  ogImage="/og/explorer.png"
>
  <section class="wrap page-top">
    <PageHeader title="The Whole Market, Unfiltered" kicker="Series Explorer" asOf={meta.as_of_date} />
    <p class="standfirst lede">
      Every grain we track: {rows.length} series across {chips.length} chips
      and three operator segments, broken out by form, interruptibility, and
      region. Single-source cells sit beside deep ones; <em>n</em> is the
      source count. The stat set in ink is the one the published headline
      uses (mean at n≥10, median below). GTD = guaranteed · INT =
      interruptible · IQR = interquartile range.
    </p>

    <div class="filter-bank">
      <div class="filters" id="filters">
        <div class="fgroup">
          <label for="f-tier">Segment</label>
          <select id="f-tier" data-filter="tier">
            <option value="">All</option>
            {TIERS.map((t) => <option value={t}>{TIER_LABELS[t]}</option>)}
          </select>
        </div>
        <div class="fgroup">
          <label for="f-chip">Chip</label>
          <select id="f-chip" data-filter="chip">
            <option value="">All</option>
            {chips.map((c) => <option value={c}>{c}</option>)}
          </select>
        </div>
        <div class="fgroup">
          <label for="f-form">Form</label>
          <select id="f-form" data-filter="form">
            <option value="">All</option>
            {forms.map((f) => <option value={f}>{f}</option>)}
          </select>
        </div>
        <div class="fgroup">
          <label for="f-int">Interrupt</label>
          <select id="f-int" data-filter="interrupt">
            <option value="">All</option>
            <option value="GTD">Guaranteed</option>
            <option value="INT">Interruptible</option>
          </select>
        </div>
        <div class="fgroup">
          <label for="f-region">Region</label>
          <select id="f-region" data-filter="region">
            <option value="">All</option>
            {regions.map((rg) => <option value={rg}>{REGION_LABELS[rg as keyof typeof REGION_LABELS]}</option>)}
          </select>
        </div>
        <div class="fgroup fgroup-search">
          <label for="f-search">Search</label>
          <input type="text" id="f-search" placeholder="series_id substring" />
        </div>
      </div>
      <div class="filter-actions">
        <span class="match-pill">Matching: <span id="match">0</span></span>
        <button type="button" id="reset" class="reset-btn">Reset</button>
      </div>
    </div>

    <div class="table-wrap">
      <table class="data" id="rows-table">
        <thead>
          <tr>
            <th class="sortable" data-key="id">Series</th>
            <th class="sortable" data-key="tier">Segment</th>
            <th class="sortable" data-key="chip">Chip</th>
            <th class="sortable" data-key="form">Form</th>
            <th class="sortable" data-key="interrupt">Int</th>
            <th class="sortable" data-key="region">Region</th>
            <th class="sortable" data-key="mean" data-num>Mean $/hr</th>
            <th class="sortable" data-key="median" data-num>Median $/hr</th>
            <th class="sortable mob-hide" data-key="p25" data-num>IQR</th>
            <th class="sortable" data-key="n_src" data-num>n</th>
            <th class="sortable" data-key="d30" data-num
                title="Trailing 30-day change in the published headline. Shown only for series whose headline is the n≥10 mean; thinner median-headline series show — .">30d</th>
          </tr>
        </thead>
        <tbody id="rows-tbody"></tbody>
      </table>
    </div>
  </section>

  <script is:inline define:vars={{ ROWS: rows }}>
    (function () {
      function fmt(n, dp) { return Number(n).toFixed(dp != null ? dp : 2); }
      function dash(tok, label) { return tok === 'ALL' ? '—' : label; }
      function trend(r) {
        if (!r.spark_path) return '<span class="dim">—</span>';
        var pct = r.d30 == null ? '' :
          '<span class="d30 ' + (r.d30 > 0 ? 'up' : r.d30 < 0 ? 'down' : '') + '">' +
          (r.d30 > 0 ? '+' : '') + r.d30.toFixed(1) + '%</span>';
        return '<svg class="spark" width="58" height="16" viewBox="0 0 58 16" ' +
          'aria-hidden="true"><polyline points="' + r.spark_path + '" fill="none" ' +
          'stroke="currentColor" stroke-width="1.25" stroke-linejoin="round" ' +
          'stroke-linecap="round"/></svg>' + pct;
      }
      var F = { tier: '', chip: '', form: '', interrupt: '', region: '', search: '' };
      var tbody = document.getElementById('rows-tbody');
      var match = document.getElementById('match');
      function matches(r) {
        if (F.tier && r.tier !== F.tier) return false;
        if (F.chip && r.chip !== F.chip) return false;
        if (F.form && r.form !== F.form) return false;
        if (F.interrupt && r.interrupt !== F.interrupt) return false;
        if (F.region && r.region !== F.region) return false;
        if (F.search && r.id.toLowerCase().indexOf(F.search.toLowerCase()) === -1) return false;
        return true;
      }
      var SORT = { key: null, dir: 1, num: false };
      function sorted(rs) {
        if (!SORT.key) return rs;
        var k = SORT.key, dir = SORT.dir, num = SORT.num;
        return rs.slice().sort(function (a, b) {
          var av = a[k], bv = b[k];
          if (num) return (Number(av) - Number(bv)) * dir;
          return String(av).localeCompare(String(bv)) * dir;
        });
      }
      function render() {
        var rs = sorted(ROWS.filter(matches));
        match.textContent = rs.length;
        tbody.innerHTML = rs.map(function (r) {
          return '<tr>' +
            '<td class="sid"><code>' + r.id + '</code></td>' +
            '<td><span class="tier-badge tier-badge-' + r.tier.toLowerCase() + '" title="' + r.tier_label + '">' + r.tier_label + '</span></td>' +
            '<td class="chip">' + r.chip + '</td>' +
            '<td class="dim">' + dash(r.form, r.form) + '</td>' +
            '<td class="dim">' + dash(r.interrupt, r.interrupt) + '</td>' +
            '<td class="dim">' + dash(r.region, r.region_label) + '</td>' +
            '<td class="num ' + (r.hstat === 'mean' ? 'posted headline-stat' : 'dim') + '" title="' + (r.hstat === 'mean' ? 'Headline stat for this series (n≥10)' : '') + '">$' + fmt(r.mean) + '</td>' +
            '<td class="num ' + (r.hstat === 'median' ? 'posted headline-stat' : 'dim') + '" title="' + (r.hstat === 'median' ? 'Headline stat for this series (n<10)' : '') + '">$' + fmt(r.median) + '</td>' +
            '<td class="num dim mob-hide">$' + fmt(r.p25) + '–$' + fmt(r.p75) + '</td>' +
            '<td class="num">' + r.n_src + '</td>' +
            '<td class="trend">' + trend(r) + '</td>' +
          '</tr>';
        }).join('');
      }
      document.querySelectorAll('#rows-table th.sortable').forEach(function (th) {
        th.addEventListener('click', function () {
          var key = th.getAttribute('data-key');
          if (SORT.key === key) {
            SORT.dir = -SORT.dir;
          } else {
            SORT.key = key;
            SORT.num = th.hasAttribute('data-num');
            // Numeric columns open descending (biggest first); text ascending.
            SORT.dir = SORT.num ? -1 : 1;
          }
          document.querySelectorAll('#rows-table th.sortable').forEach(function (h) {
            h.removeAttribute('data-dir');
          });
          th.setAttribute('data-dir', SORT.dir === 1 ? 'asc' : 'desc');
          render();
        });
      });
      document.querySelectorAll('#filters select, #filters input').forEach(function (el) {
        var key = el.getAttribute('data-filter') || (el.id === 'f-search' ? 'search' : null);
        if (!key) return;
        el.addEventListener('input', function () { F[key] = el.value; render(); });
        el.addEventListener('change', function () { F[key] = el.value; render(); });
      });
      document.getElementById('reset').addEventListener('click', function () {
        document.querySelectorAll('#filters select').forEach(function (s) { s.value = ''; });
        document.getElementById('f-search').value = '';
        F = { tier: '', chip: '', form: '', interrupt: '', region: '', search: '' };
        if (history.replaceState) history.replaceState(null, '', location.pathname);
        render();
      });
      // Deep-linkable filters: /explorer?chip=H100&interrupt=INT&region=US
      // pre-selects the matching filters, so notes and external citations can
      // point at a specific cut. Unknown values are ignored (select stays '').
      (function initFromQuery() {
        var qs = new URLSearchParams(location.search);
        document.querySelectorAll('#filters select').forEach(function (s) {
          var key = s.getAttribute('data-filter');
          var v = key && qs.get(key);
          if (!v) return;
          for (var i = 0; i < s.options.length; i++) {
            if (s.options[i].value.toLowerCase() === v.toLowerCase()) {
              s.value = s.options[i].value;
              F[key] = s.options[i].value;
              break;
            }
          }
        });
        var q = qs.get('search');
        if (q) { document.getElementById('f-search').value = q; F.search = q; }
      })();
      render();
    })();
  </script>

  <style>
    .top { padding-top: 28px; }
    h1 { font-family: var(--font-display); font-size: var(--fs-2xl); margin: 6px 0 12px; letter-spacing: -0.005em; }
    .lede { max-width: 84ch; margin: 8px 0 22px; }
    .lede em { font-style: italic; color: var(--accent); }

    .filter-bank { background: var(--surface-2); border: 1px solid var(--rule); padding: 12px 14px; margin-bottom: 14px; }
    .filters { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px 14px; align-items: end; }
    .filter-actions { display: flex; gap: 12px; align-items: center; justify-content: flex-end; margin-top: 12px; padding-top: 10px; border-top: 1px dashed var(--rule); }
    .match-pill { font-family: var(--font-mono); font-size: var(--fs-xs); color: var(--ink-dim); letter-spacing: var(--tracking-eye); text-transform: uppercase; }
    .match-pill span { color: var(--accent); font-weight: var(--weight-strong); }
    .fgroup { display: flex; flex-direction: column; gap: 4px; }
    .fgroup-search { grid-column: span 2; min-width: 0; }
    .fgroup label { font-family: var(--font-mono); font-size: var(--fs-xs); color: var(--ink-dim); text-transform: uppercase; letter-spacing: var(--tracking-eye); font-weight: var(--weight-strong); }
    .fgroup select, .fgroup input { font-family: var(--font-mono); font-size: var(--fs-sm); background: var(--surface); color: var(--ink); border: 1px solid var(--rule-2); padding: 6px 8px; border-radius: var(--rad); }
    .reset-btn { background: transparent; border: 1px solid var(--rule-2); color: var(--ink-dim); font-family: var(--font-mono); font-size: var(--fs-xs); padding: 6px 14px; cursor: pointer; border-radius: var(--rad); letter-spacing: var(--tracking-eye); text-transform: uppercase; font-weight: var(--weight-strong); }
    .reset-btn:hover { color: var(--ink); border-color: var(--accent); }

    .table-wrap { border: 1px solid var(--rule); background: var(--surface); overflow-x: auto; }
    /* Row cells are innerHTML-injected by the inline script, so Astro's
       scoped selectors never match them — these must be :global. */
    #rows-table :global(td.sid code) { font-family: var(--font-mono); font-size: calc(var(--fs-sm) - 1px); color: var(--accent); letter-spacing: 0.02em; }
    #rows-table :global(td.chip) { color: var(--ink); font-weight: var(--weight-strong); }
    #rows-table :global(td.posted) { color: var(--ink); font-weight: var(--weight-strong); }
    #rows-table :global(td.headline-stat) { box-shadow: inset 0 -2px 0 var(--accent); }
    #rows-table th.sortable { cursor: pointer; user-select: none; white-space: nowrap; }
    #rows-table th.sortable:hover { color: var(--accent); }
    #rows-table th.sortable::after { content: '↕'; margin-left: 5px; color: var(--ink-faint); font-size: 0.85em; }
    #rows-table td.trend { white-space: nowrap; }
    #rows-table .spark { color: var(--ink-dim); vertical-align: middle; }
    #rows-table .d30 { font-family: var(--font-mono); font-size: var(--fs-xs); margin-left: 6px; color: var(--ink-dim); }
    #rows-table .d30.up { color: var(--accent); }
    #rows-table .d30.down { color: var(--ink-faint); }
    #rows-table th.sortable[data-dir='asc']::after { content: '▲'; color: var(--accent); }
    #rows-table th.sortable[data-dir='desc']::after { content: '▼'; color: var(--accent); }

    /* Mobile: this table cannot fit a phone — it scrolls inside .table-wrap
       with the series-id column pinned so rows stay identifiable while
       scrolling. IQR is the one column dropped on phones (.mob-hide); the
       stat itself stays on every row's hover title and on desktop. Injected
       cells need :global (see note above). */
    @media (max-width: 600px) {
      #rows-table th,
      #rows-table :global(td) { padding-left: 6px; padding-right: 6px; }
      #rows-table th { font-size: 10px; letter-spacing: 0.04em; }
      #rows-table th:first-child,
      #rows-table :global(td.sid) {
        position: sticky;
        left: 0;
        z-index: 2;
        background: var(--surface);
        border-right: 1px solid var(--rule-2);
      }
      #rows-table th:first-child { background: var(--surface-2); z-index: 3; }
      #rows-table :global(td.sid) { max-width: 138px; }
      #rows-table :global(td.sid code) {
        font-size: 10px;
        white-space: normal;
        overflow-wrap: anywhere;
      }
      #rows-table :global(td .tier-badge) {
        font-size: 10px;
        letter-spacing: 0.03em;
        padding: 1px 4px;
      }
      th.mob-hide,
      #rows-table :global(td.mob-hide) { display: none; }
    }
  </style>
</Base>
