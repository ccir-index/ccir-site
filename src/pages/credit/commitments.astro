---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import mon from '../../data/commitments_monitor.json';

/*
  Living surface — the AI commitments monitor. Tracks, per filing season,
  the demand-side commitment quantities that back compute credit: leases
  signed but not yet commenced, purchase/other commitments, remaining
  performance obligations (revenue backlog), and disclosed support
  instruments (backstops, RVGs, guarantees) for the five largest AI
  buyers. Data lives in src/data/commitments_monitor.json — update that
  file each 10-Q/10-K and this page recomputes. Launch analysis:
  /research/big-tech-hidden-debt (dated note, 2026-07-22).
*/
const fmtB = (v: number | null | undefined, dp = 1) =>
  v == null ? '—' : '$' + v.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: dp }) + 'B';
const delta = (m: any) =>
  m.v != null && m.pv != null ? (m.v >= m.pv ? '+' : '−') + Math.abs(m.v - m.pv).toFixed(1) : null;

const sumL = mon.companies.reduce((s, c) => s + (c.leases_nyc.v ?? 0), 0);
const sumP = mon.companies.reduce((s, c) => s + (c.purchase.v ?? 0), 0);
const sumR = mon.companies.reduce((s, c) => s + (c.rpo.v ?? 0), 0);
// all-in = forward stack + debt face + balance-sheet lease liabilities
const allIn = (c: any) =>
  (c.leases_nyc.v ?? 0) + (c.purchase.v ?? 0) + (c.visible?.debt ?? 0) + (c.visible?.leases ?? 0);
const sumAll = mon.companies.reduce((s, c) => s + allIn(c), 0);
---
<Base
  title="Big Tech's $2.6 Trillion in Signed AI Commitments · CCIR Monitor"
  description="Meta, Alphabet, Microsoft, Oracle and Amazon have signed $2,607B of AI infrastructure commitments not yet delivered — leases not yet commenced plus purchase obligations, as of 2026-07-31. A filings-season monitor: every figure windowed, computed from the disclosed figures, and traced to its SEC accession."
>
  <nav class="apps-navband" aria-label="credit section">
    <div class="wrap apps-nav-inner">
      <span class="hub-group">
        <a class="apps-nav-link hub-link" href="/credit">Instruments</a>
        <span class="hub-sep" aria-hidden="true">·</span>
        <a class="apps-nav-link hub-link" href="/credit/series">Series</a>
        <span class="hub-sep" aria-hidden="true">·</span>
        <span class="apps-nav-link hub-link hub-on">Commitments</span>
      </span>
    </div>
  </nav>

  <section class="wrap page-top">
    <PageHeader
      title="AI Commitments Monitor: $2.6 Trillion Signed, Not Yet Delivered"
      crumbs={[{ href: '/credit', label: 'Credit' }]}
      kicker="Commitments · updated each filing season"
      asOf={mon.as_of}
    >
      <p class="standfirst">
        Meta, Alphabet, Microsoft, Oracle and Amazon have signed
        <strong>{fmtB(sumL + sumP, 0)}</strong> of AI infrastructure
        commitments that have not yet been delivered: leases signed on
        buildings not yet handed over, plus contracts to buy chips, power
        and capacity at stated minimums. That figure is those two
        disclosed quantities added together, as of {mon.as_of}. It is not
        debt. It is not the same as the all-in total below, which adds
        borrowings and leases already on the balance sheet.
      </p>
      <p class="standfirst">
        The demand-side commitments that back compute credit, tracked from
        the SEC filings of the five largest AI buyers. Two footnote
        quantities, in plain terms <em>rent</em> (leases signed on data
        centers still under construction) and <em>bills</em> (contracts to
        buy chips, power, and capacity at stated minimums), plus the
        revenue backlog on the other side of the same contracts, and the
        support instruments written around them. Every figure carries its
        window and traces to an accession number. As of {mon.as_of}.
        Next expected update: {mon.next_expected}.
      </p>
    </PageHeader>

    <div class="tiles">
      <div class="tile tile-lead"><div class="tlab">Signed, not yet delivered</div><div class="tval">{fmtB(sumL + sumP, 0)}</div></div>
      <div class="tile"><div class="tlab">Leases not yet commenced</div><div class="tval">{fmtB(sumL, 0)}</div></div>
      <div class="tile"><div class="tlab">Purchase &amp; other commitments</div><div class="tval">{fmtB(sumP, 0)}</div></div>
      <div class="tile"><div class="tlab">All-in, adding debt + commenced leases</div><div class="tval">{fmtB(sumAll, 0)}</div></div>
      <div class="tile"><div class="tlab">Revenue backlog (RPO), four sellers</div><div class="tval">{fmtB(sumR, 0)}</div></div>
    </div>

    <section class="sec monwide">
      <h2><span class="n">§</span> The monitor</h2>
      <div class="tblwrap">
        <table class="mon">
          <thead>
            <tr>
              <th>Company</th>
              <th>Leases not yet commenced</th>
              <th>Purchase &amp; other commitments</th>
              <th>All-in obligations</th>
              <th>Revenue backlog (RPO)</th>
              <th>Support instruments</th>
            </tr>
          </thead>
          <tbody>
            {mon.companies.map((c) => (
              <tr>
                <td class="co">{c.name}<div class="fil">{c.latest_filing}</div></td>
                <td>
                  <span class="v">{fmtB(c.leases_nyc.v)}</span> <span class="w">{c.leases_nyc.w}</span>
                  {delta(c.leases_nyc) && <div class="d">{delta(c.leases_nyc)} vs {c.leases_nyc.pw} ({fmtB(c.leases_nyc.pv)})</div>}
                  {'note' in c.leases_nyc && c.leases_nyc.note && <div class="nt">{c.leases_nyc.note}</div>}
                </td>
                <td>
                  <span class="v">{fmtB(c.purchase.v)}</span> <span class="w">{c.purchase.w}</span>
                  {delta(c.purchase) && <div class="d">{delta(c.purchase)} vs {c.purchase.pw} ({fmtB(c.purchase.pv)})</div>}
                  {c.purchase.note && <div class="nt">{c.purchase.note}</div>}
                </td>
                <td>
                  <span class="v">{fmtB(allIn(c), 0)}</span> <span class="w">{c.visible?.w}</span>
                  {c.rpo.v != null && <div class="d">backlog ÷ all-in: {((c.rpo.ratio_v ?? c.rpo.v) / allIn(c)).toFixed(2)}×</div>}
                  {c.visible?.note && <div class="nt">{c.visible.note}</div>}
                </td>
                <td>
                  <span class="v">{fmtB(c.rpo.v)}</span> {c.rpo.v != null && <span class="w">{c.rpo.w}</span>}
                  {delta(c.rpo) && <div class="d">{delta(c.rpo)} vs {c.rpo.pw} ({fmtB(c.rpo.pv)})</div>}
                  {c.rpo.note && <div class="nt">{c.rpo.note}</div>}
                </td>
                <td>
                  {c.support.v != null && <span class="v">{fmtB(c.support.v)}</span>} {c.support.v != null && <span class="w">{c.support.w}</span>}
                  <div class="nt">{c.support.label}</div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="tblnote">
        $B, undiscounted, as disclosed. Windows differ where issuers'
        fiscal calendars and disclosure practices differ and are labeled
        on every cell. Deltas are shown only against the same issuer's
        prior disclosure of the same quantity. Oracle's
        prior lease figure is fiscal 2022, the earliest comparable
        disclosure. <strong>All-in obligations</strong> = the two forward
        columns plus debt at face value and balance-sheet lease
        liabilities (operating + finance), each from the same issuer's
        cited filings. It is a total fixed-claims stack built only from
        components all five issuers disclose, computed by us from the
        disclosed figures. Construction commitments, disclosed only by
        Microsoft, are excluded from these columns. The backlog ÷ all-in
        ratio is a conservative
        screen, not a coverage finding: RPO is contracted revenue only,
        while debt and commenced leases are also serviced by revenue no
        backlog captures (advertising, retail, licenses). Support
        instruments are contingent and are in no total.
      </p>
    </section>

    <section class="sec">
      <h2><span class="n">§</span> What these quantities are</h2>
      <p>
        <strong>Leases signed but not yet commenced</strong> are rental
        agreements on facilities, overwhelmingly data centers, that have
        not been delivered. Nothing appears on the balance sheet until the
        landlord hands over the building. At commencement, a lease
        liability and right-of-use asset are recognized. The footnote is
        therefore a forward calendar of balance-sheet lease liabilities,
        with terms disclosed as long as 30 years.
        <strong>Purchase and other commitments</strong> are contracts to
        buy goods and services (cloud capacity, chips and servers, power),
        reported at the non-cancelable portion or contractual minimum,
        in the issuers' own language: "non-cancelable," "take-or-pay,"
        "unconditional… enforceable and legally binding."
        <strong>Remaining performance obligations</strong> are the same
        class of contract seen from the seller's side: contracted future
        revenue not yet recognized. <strong>Support instruments</strong>
        are credit support written around other parties' financings:
        payment backstops (Alphabet accounts for these as credit
        derivatives at fair value), residual value guarantees, and
        guarantees of lessors' borrowings.
      </p>
      <p>
        Why a compute-credit record tracks them: these commitments are the
        collateral of the offtake-backed lane of the
        <a href="/credit">compute credit tracker</a>. A compute
        provider's contracted cash flows from an investment-grade customer
        are that customer's purchase commitment seen from the other end,
        and the market prices their quality. The launch analysis, with the
        full decomposition, conditionality language, and counterparty
        detail, is
        <a href="/research/big-tech-hidden-debt">Breaking Down Big Tech's
        $1.65 Trillion "Hidden Debt"</a>. On the support-instruments
        column specifically, see
        <a href="/research/alphabet-pays-for-data-center-speed">How
        Alphabet Pays to Obtain Compute Capacity at Speed</a>: the backstop book and
        its booked cost per $100, which this monitor updates with each
        Alphabet 10-Q.
      </p>
      <p class="footnote">
        Sources: latest and prior filings per issuer as listed in each
        row, verified against the documents on EDGAR. This page is
        updated within days of each new 10-Q/10-K from the covered
        issuers. Figures are as-disclosed and are not restated between
        filings. Nothing here is a solvency opinion, a forecast, or
        investment advice.
      </p>
    </section>

    <section class="sec" id="implied-rates">
      <h2><span class="n">§</span> Implied committed rates</h2>
      <p>
        Where a publicly disclosed multi-year compute deal states enough
        (dollars, term, and quantity), CCIR backs out the implied unit
        rate. Every figure is implied, computed by CCIR from the disclosed
        figures, and graded by disclosure quality. None is an observed
        price. These rows are not part of any CCIR benchmark series. The
        methodology and per-deal detail are in the research note
        <a href="/research/implied-committed-rates">Implied Committed
        Rates</a>. This table updates as deals publish.
      </p>
      <blockquote class="icr-assume">
        Assumptions, permanent: ratable spend across the disclosed term;
        100% of contracted hours billed; all disclosed dollars treated as
        compute; constant fleet; 8,760 hr/yr. Every assumption biases the
        implied rate downward: <strong>all figures are floors on blended
        committed rates, not observed prices.</strong> Grades: A = dollars,
        term, and units all company-disclosed; B = one input from
        attributed press. Grade-C rows (talks-stage or heavy estimation)
        do not publish. $/GPU-hr and $/MW-month rows are never blended.
        Chip column = the generation as the parties disclosed it. Where
        unspecified, the rate is fleet-blended. No performance adjustment
        across generations: rates on different chips are different
        products, not comparable prices. This table carries $/GPU-hr rows
        only, newest first; megawatt-basis reads (IREN's grade-A basis,
        Stargate) live in the research note.
      </blockquote>
      <div class="icr-wrap">
        <table class="icr">
          <thead>
            <tr><th>Deal</th><th>Chip</th><th>Disclosed</th><th>Implied rate</th><th>Grade</th><th>As of</th></tr>
          </thead>
          <tbody>
            <tr><td>Anthropic–xAI (SpaceX)</td><td>unspecified</td><td>$1.25B/mo through May 2029 · ~325,000 NVIDIA GPUs · 90-day outs after initial 3 mo</td><td><strong>$5.27/GPU-hr</strong></td><td>A</td><td>Jun-26</td></tr>
            <tr><td>Microsoft–IREN</td><td>GB300</td><td>$9.7B · 5 yr · 200MW critical IT load</td><td>~$2.2/GPU-hr <em>(CCIR density estimate)</em></td><td>A (MW)</td><td>Nov-25</td></tr>
            <tr><td>OpenAI–AWS</td><td>GB200/GB300</td><td>$38B · 7 yr · "hundreds of thousands" of GPUs + CPUs</td><td><strong>$1.24–3.10/GPU-hr</strong> (band)</td><td>B</td><td>Nov-25</td></tr>
            <tr><td>Microsoft–Nscale/Aker (Narvik)</td><td>GB300</td><td>$6.2B · 5 yr · ~52,000 GPUs</td><td><strong>$2.72/GPU-hr</strong></td><td>A</td><td>Sep-25</td></tr>
            <tr><td>Microsoft–Nebius</td><td>GB300 (press)</td><td>$17.4B (up to $19.4B) · 5 yr · "&gt;100k" GPUs per press</td><td><strong>$3.97/GPU-hr</strong></td><td>B</td><td>Sep-25</td></tr>
          </tbody>
        </table>
      </div>
      <p class="footnote">
        Not computable, no rate published: Meta–CoreWeave (~$35.2B total,
        no units disclosed), OpenAI–CoreWeave (~$22.4B, no units),
        Anthropic–Microsoft Azure ($30B, no term; the "up to 1GW" is a
        separate additional commitment and is not a valid denominator).
        Sources and per-row caveats in the
        <a href="/research/implied-committed-rates">research note</a>.
      </p>
    </section>
  </section>

  <style>
    .top { padding-top: 32px; }
    .apps-navband {
      position: sticky; top: 0; z-index: 40;
      background: var(--bg); border-bottom: 1px solid var(--rule);
    }
    .apps-nav-inner {
      display: flex; align-items: center; gap: 24px;
      overflow-x: auto; scrollbar-width: none;
      padding-top: 9px; padding-bottom: 9px;
    }
    .apps-nav-inner::-webkit-scrollbar { display: none; }
    .apps-nav-link {
      font-family: var(--font-mono); font-size: var(--fs-xs);
      text-transform: uppercase; letter-spacing: var(--tracking-eye);
      color: var(--ink-dim); text-decoration: none; white-space: nowrap;
    }
    .apps-nav-link:hover { color: var(--ink); text-decoration: none; }
    .hub-group { display: inline-flex; align-items: center; gap: 10px; }
    .hub-link { font-weight: var(--weight-strong); }
    .hub-on { color: var(--link); }
    .hub-sep { color: var(--ink-faint); }
    .page-head { max-width: 84ch; margin-bottom: 16px; }
    .page-head h1 {
      font-family: var(--font-display);
      font-size: var(--fs-hero);
      line-height: var(--lh-display);
      font-weight: var(--weight-display);
      margin: 6px 0 14px;
      letter-spacing: -0.01em;
    }
    .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px; margin: 6px 0 22px; max-width: 900px; }
    .tile { border: 1px solid var(--rule); background: var(--surface); padding: 12px 14px; }
    .tile-lead { border-color: var(--accent); }
    .tile-lead .tlab { color: var(--accent); }
    .tlab { font-family: var(--font-mono); font-size: var(--fs-xs); color: var(--ink-dim); letter-spacing: 0.03em; }
    .tval { font-family: var(--font-display); font-size: var(--fs-2xl); font-weight: var(--weight-display); margin-top: 2px; }
    .sec { margin: 26px 0; max-width: 96ch; }
    .sec h2 { font-family: var(--font-display); font-size: var(--fs-xl); margin: 0 0 12px; display: flex; align-items: baseline; gap: 12px; }
    .sec .n { font-family: var(--font-mono); font-size: var(--fs-sm); color: var(--accent); font-weight: var(--weight-strong); }
    .sec p { font-family: var(--font-body); font-size: var(--fs-md); color: var(--ink); line-height: 1.65; margin: 0 0 13px; max-width: 80ch; }
    .tblwrap { overflow-x: auto; border: 1px solid var(--rule); background: var(--surface); }
    .sec.monwide { max-width: none; }
    table.mon { width: 100%; min-width: 1120px; border-collapse: collapse; font-size: var(--fs-sm); }
    table.mon th:nth-child(1) { width: 13%; }
    table.mon th:nth-child(2), table.mon th:nth-child(3), table.mon th:nth-child(4) { width: 24%; }
    table.mon th:nth-child(5) { width: 15%; }
    table.mon th { text-align: left; font-family: var(--font-mono); font-size: var(--fs-xs); color: var(--ink-dim); border-bottom: 1px solid var(--rule); padding: 10px 12px; }
    table.mon td { vertical-align: top; border-bottom: 1px solid var(--rule); padding: 10px 12px; line-height: 1.45; }
    table.mon td.co { font-weight: var(--weight-strong); white-space: nowrap; }
    table.mon .fil { font-family: var(--font-mono); font-size: 10.5px; color: var(--ink-faint); font-weight: normal; white-space: normal; max-width: 20ch; margin-top: 3px; }
    table.mon .v { font-family: var(--font-mono); font-weight: var(--weight-strong); }
    table.mon .w { font-family: var(--font-mono); font-size: var(--fs-xs); color: var(--ink-dim); }
    table.mon .d { font-family: var(--font-mono); font-size: var(--fs-xs); color: var(--ink-dim); margin-top: 2px; }
    table.mon .nt { font-size: var(--fs-xs); color: var(--ink-faint); margin-top: 4px; max-width: 34ch; }
    .tblnote { font-size: var(--fs-xs); color: var(--ink-faint); margin-top: 8px; max-width: 84ch; line-height: 1.5; }
    .footnote { font-size: var(--fs-sm); color: var(--ink-faint); border-top: 1px solid var(--rule); padding-top: 8px; max-width: 74ch; }
    .footnote a, .sec a { color: var(--link); }
    .icr-assume {
      border-left: 3px solid var(--accent); margin: 0 0 14px;
      padding: 10px 16px; background: var(--surface);
      font-family: var(--font-body); font-size: var(--fs-sm);
      color: var(--ink); line-height: 1.6; max-width: 74ch;
    }
    .icr-wrap { overflow-x: auto; margin: 12px 0 8px; }
    .icr {
      border-collapse: collapse; font-family: var(--font-mono);
      font-size: var(--fs-xs); min-width: 680px;
    }
    .icr th {
      text-align: left; color: var(--ink-dim); font-weight: 600;
      border-bottom: 1px solid var(--rule); padding: 6px 14px 6px 0;
      letter-spacing: 0.03em;
    }
    .icr td {
      color: var(--ink); border-bottom: 1px solid var(--rule);
      padding: 8px 14px 8px 0; vertical-align: top; line-height: 1.5;
    }
    .icr em { font-style: normal; color: var(--ink-faint); font-size: 10.5px; }

    /* Mobile: both tables are genuinely too wide for a phone — each scrolls
       inside its own overflow-x wrapper with the identity column pinned so
       rows stay readable while scrolling. */
    @media (max-width: 600px) {
      table.mon th, table.mon td { padding: 8px; }
      table.mon th:nth-child(1) { width: 96px; }
      table.mon th:first-child,
      table.mon td.co {
        position: sticky;
        left: 0;
        z-index: 2;
        background: var(--surface);
        border-right: 1px solid var(--rule-2);
      }
      table.mon .fil { max-width: 12ch; }
      .icr th, .icr td { padding-right: 10px; }
      .icr th:first-child,
      .icr td:first-child {
        position: sticky;
        left: 0;
        z-index: 2;
        background: var(--bg);
        border-right: 1px solid var(--rule-2);
        padding-right: 8px;
        max-width: 118px;
      }
    }
  </style>
</Base>
