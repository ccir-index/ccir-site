---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { meta } from '../data/snapshot';
import versions from '../../public/documents/methodology/versions.json';

// Methodology versions. public/documents/methodology/versions.json is copied
// from the public methodology repository (ccir-index/ccir-methodology,
// versions/), where one dated PDF is rendered per methodology version and
// never changes once published. The current version leads; prior versions
// follow in the order they were superseded.
const currentVersion = versions.versions.find((v) => v.version === versions.current);
const priorVersions = versions.versions.filter(
  (v) => v.version !== versions.current && v.effective <= (currentVersion?.effective ?? ''),
);
const versionRows = currentVersion ? [currentVersion, ...priorVersions] : priorVersions;
const pdfHref = (v) => (v.pdf ? `/documents/methodology/${v.pdf}` : null);

const docs = [
  {
    href: '/documents/methodology',
    title: 'Methodology',
    blurb:
      'What the series measure, where the prices come from, how they are ' +
      'aggregated, and the series grammar: the document a citation of any ' +
      'CCIR series relies on.',
  },
  {
    href: '/documents/change-management',
    title: 'Change Management Policy',
    blurb:
      'How methodology changes are classified, disclosed, and versioned. ' +
      'What constitutes a material change. Restatements versus series breaks.',
  },
  {
    href: '/documents/governance',
    title: 'Governance & Complaints',
    blurb:
      'Administrator identity, independence and conflicts posture, and how ' +
      'to raise a query or complaint about a published series.',
  },
  {
    href: '/documents/changelog',
    title: 'Methodology Change Log',
    blurb:
      'The running record of versions, panel changes, and series notices. ' +
      'Pending changes are announced with effective date, anticipated impact, ' +
      'and a comment window.',
  },
  {
    href: '/documents/iosco',
    title: 'IOSCO Principles Self-Assessment',
    blurb:
      'A principle-by-principle crosswalk of CCIR’s published practice ' +
      'against the nineteen IOSCO Principles for Financial Benchmarks, ' +
      'self-assessed, with gaps stated as gaps.',
  },
  {
    href: '/documents/data-terms',
    title: 'Data Terms',
    blurb:
      'What may be done with the published series without asking (viewing, ' +
      'quotation, citation with attribution) and what requires written ' +
      'permission: systematic retrieval, redistribution, commercial reuse.',
  },
];
---
<Base
  title="Documents · CCIR"
  ogImage="/og/documents.png"
  description="CCIR's public methodology, change-management, and governance documents — the reference documents a citation of any CCIR series relies on."
  showTape={false}
>
  <section class="wrap page-top">
    <PageHeader title="Reference Documents" kicker="Documents" asOf={meta.as_of_date} display>
      <p class="standfirst">
        The documents a citation of a CCIR series relies on: what the numbers
        measure, how changes to the measurement are governed, and who stands
        behind them. Each describes current practice.
      </p>
    </PageHeader>

    <div class="doc-list">
      {docs.map((d) => (
        <a class="doc-card" href={d.href}>
          <h2 class="doc-title">{d.title}</h2>
          <p class="doc-blurb">{d.blurb}</p>
          <span class="doc-go">Read →</span>
        </a>
      ))}
    </div>

    <section class="versions" id="methodology-versions">
      <h2 class="versions-title">Methodology versions</h2>
      <p class="versions-note">
        Each methodology version is a dated PDF. A version's PDF does not
        change after publication. The change log entry records what changed
        and when it took effect.
      </p>
      <table class="versions-table">
        <thead>
          <tr>
            <th>Version</th>
            <th>Effective</th>
            <th>Document</th>
            <th>Change log</th>
          </tr>
        </thead>
        <tbody>
          {versionRows.map((v) => (
            <tr class={v.version === versions.current ? 'is-current' : undefined}>
              <td class="v">
                {v.version}
                {v.version === versions.current && <span class="tag">current</span>}
              </td>
              <td>{v.effective}</td>
              <td>
                {pdfHref(v) ? <a href={pdfHref(v)}>PDF</a> : <span class="none">no PDF</span>}
              </td>
              <td>
                {v.changelog_id ? (
                  <a href={`/documents/changelog#${v.changelog_id}`}>{v.changelog_id}</a>
                ) : (
                  <span class="none">—</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <p class="iosco-note">
      CCIR's methodology and governance are designed with reference to the
      International Organization of Securities Commissions (IOSCO)
      <em>Principles for Oil Price Reporting Agencies</em> (2012) and
      <em>Principles for Financial Benchmarks</em> (2013). See the
      <a href="/documents/iosco">principle-by-principle self-assessment</a>.
      CCIR does not claim assured compliance. Independent external assurance
      of adherence (the convention established by commodity price-reporting
      agencies) will be sought when adoption warrants it.
    </p>
  </section>

  <style>
    .top { padding-top: 32px; }
    .page-head { max-width: 80ch; margin-bottom: 22px; }
    .page-head h1 {
      font-family: var(--font-display);
      font-size: var(--fs-hero);
      line-height: var(--lh-display);
      font-weight: var(--weight-display);
      margin: 6px 0 14px;
      letter-spacing: -0.01em;
    }
    .doc-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1px;
      background: var(--rule);
      border: 1px solid var(--rule);
      max-width: 760px;
    }
    @media (max-width: 860px) { .doc-list { grid-template-columns: 1fr; } }
    .doc-card {
      background: var(--surface);
      padding: 20px 22px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      text-decoration: none;
      color: var(--ink);
    }
    .doc-card:hover { background: var(--surface-2); text-decoration: none; }
    .doc-title {
      font-family: var(--font-display);
      font-size: var(--fs-xl);
      margin: 0;
    }
    .doc-blurb {
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      color: var(--ink-dim);
      line-height: 1.6;
      margin: 0;
      flex: 1;
    }
    .doc-go {
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: var(--tracking-eye);
    }
    .versions {
      max-width: 760px;
      margin: 30px 0 0;
      padding-top: 18px;
      border-top: 1px solid var(--rule-2);
    }
    .versions-title {
      font-family: var(--font-display);
      font-size: var(--fs-xl);
      margin: 0 0 8px;
    }
    .versions-note {
      font-family: var(--font-body);
      font-size: var(--fs-sm);
      color: var(--ink-dim);
      line-height: 1.6;
      max-width: 76ch;
      margin: 0 0 14px;
    }
    .versions-table {
      width: 100%;
      border-collapse: collapse;
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      color: var(--ink);
    }
    .versions-table th {
      text-align: left;
      font-weight: var(--weight-strong);
      color: var(--ink-dim);
      text-transform: uppercase;
      letter-spacing: var(--tracking-eye);
      padding: 6px 10px 6px 0;
      border-bottom: 1px solid var(--rule);
    }
    .versions-table td {
      padding: 8px 10px 8px 0;
      border-bottom: 1px solid var(--rule-2);
      vertical-align: baseline;
    }
    .versions-table .v { white-space: nowrap; }
    .versions-table .is-current td { color: var(--ink); }
    .versions-table .tag {
      margin-left: 8px;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: var(--tracking-eye);
    }
    .versions-table a { color: var(--accent); }
    .versions-table .none { color: var(--ink-dim); }
    .iosco-note {
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      color: var(--ink-dim);
      line-height: 1.65;
      max-width: 80ch;
      margin: 26px 0 40px;
      padding-top: 16px;
      border-top: 1px solid var(--rule-2);
    }
  </style>
</Base>
