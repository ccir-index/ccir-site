---
import Base from '../layouts/Base.astro';
import {
  headlineRates, meta, premiumChipsList, homeOdCell, homeIntCell, headlineValue, headlineStatOf,
} from '../data/snapshot';
import { wpSpread } from '../data/committed_mi';
import { TIERS, TIER_LABELS_SHORT, TERM_DISPLAY } from '../data/types';
import type { Rate, Term, Tier } from '../data/types';
import creditData from '../data/credit_instruments.json';

// --- surface band (redesign/v1) -------------------------------------------
// The other three surfaces, few words each. The credit stat reuses /credit's
// own computation (collateral_class === 'gpu', filed sizes summed) so the
// tile and the tracker can never disagree.
const creditGpuRows = creditData.instruments.filter((i: any) => i.collateral_class === 'gpu');
const creditGpuUsdB = Math.round(creditGpuRows.reduce((a: number, i: any) => a + i.size_usd_m, 0) / 1000);
const creditN = creditData.instruments.length;

const fmt = (n: number, dp = 2) => n.toFixed(dp);

// --- headline ladder (mirrors /rates) -------------------------------------
// Cell selection and value rule live in snapshot.ts (homeOdCell /
// headlineValue) so this ladder, the OG share card, and /rates can never
// disagree. Region-pooled (ALL) since 2026-07-25 so the ladder's H100 cell
// ties exactly to the term panel's OD anchor on the same series grain.
// /rates carries the same US & EU citable headline — lender/counsel entry points
// there, not here.
function cellTitle(c: Rate): string {
  return `${c.series_id} · ${headlineStatOf(c)}, n=${c.n_sources} · median ${fmt(c.price_median)} · mean ${fmt(c.price_mean)} · IQR ${fmt(c.price_p25)}–${fmt(c.price_p75)}`;
}

const chips = (() => {
  const live = premiumChipsList();
  return (live.length > 0 ? live : ['B200', 'H200', 'H100', 'A100']);
})();
const ladder = chips
  .map((chip) => ({ chip, cells: Object.fromEntries(TIERS.map((t) => [t, homeOdCell(t, chip)])) as Record<Tier, Rate | undefined> }))
  .filter((row) => TIERS.some((t) => row.cells[t]));

// --- interruptible ladder (LOCALHOST PREVIEW, 2026-08-04) ------------------
// Second grade of the same survey: identical panel construction, identical
// cell-selection rule (homeIntCell), revocable-occupancy products. Below-
// floor cells print an em dash and fill as the INT panel deepens. No ratio
// against the guaranteed ladder is printed anywhere — different panel
// compositions. Replaces the term panel in this preview; /term surfacing
// decision pending.
const intLadder = chips
  .map((chip) => ({ chip, cells: Object.fromEntries(TIERS.map((t) => [t, homeIntCell(t, chip)])) as Record<Tier, Rate | undefined> }))
  .filter((row) => TIERS.some((t) => row.cells[t]));

// --- committed term panel (companion to the ladder; mirrors /term) --------
// Anchor = the region-pooled Neocloud H100 GTD OD headline — the same cell
// TermCurveChart anchors on. Tenor values are implied off that anchor by the
// WITHIN-PROVIDER committed spread (committed_mi: each operator's committed
// ask vs its own on-demand, operator-equal) — the /term par-curve
// construction, so this panel and the chart it links to print identical
// numbers (2026-08-02; the previous posted band medians differenced against
// the OD headline mixed two provider panels and contradicted /term's tags).
// Tenor floor at 3M mirrors the chart (1M short-end contango belongs to the
// data story, not the par-curve read — John 2026-07-02).
const TERM_ANCHOR_SERIES = 'CRI-T2-H100-ALL-GTD-OD-ALL';
const termAnchor = headlineRates.find((r) => r.series_id === TERM_ANCHOR_SERIES);
const TERM_TENORS: Term[] = ['3M', '6M', '1Y', '2Y', '3Y'];
const termRows = (() => {
  if (!termAnchor) return [];
  const anchorV = headlineValue(termAnchor);
  return TERM_TENORS.flatMap((term) => {
    const sp = wpSpread('H100', term);
    if (!sp) return [];
    const value = anchorV * (1 + sp.spread);
    const pct = sp.spread * 100;
    const rounded = Math.round(Math.abs(pct));
    return [{
      term,
      value,
      disc: rounded === 0 ? '0%' : `${pct > 0 ? '+' : '−'}${rounded}%`,
      title:
        `H100 · ${term} committed vs own OD: ${pct > 0 ? '+' : '−'}${Math.abs(pct).toFixed(1)}% — ` +
        `within-provider signed spread (${sp.n_pairs} provider pairs) → ` +
        `$${fmt(value)} implied off the $${fmt(anchorV)} on-demand anchor`,
    }];
  });
})();

// --- research: the hub's own taxonomy, three items per group ---------------
// Fixed selection (rotation retired 2026-07-25): standing monitors lead each
// group, dated notes follow. Kickers carry the monitor/note distinction.
type ResearchItem = { href: string; title: string; kicker: string };
type ResearchGroup = { theme: string; items: ResearchItem[] };
const researchGroups: ResearchGroup[] = [
  { theme: 'Asset Economics', items: [
    { href: '/chip-economics', title: 'Chip Economics', kicker: 'Monitor · daily' },
    { href: '/research/gpu-age-curve', title: 'Rent and Age: Five Generations', kicker: 'Note · 2026-07-06' },
    { href: '/research/rent-and-msrp', title: 'Rent and MSRP', kicker: 'Note · 2026-07-08' },
  ] },
  { theme: 'Term & Price Structure', items: [
    { href: '/term', title: 'Committed Term Structure', kicker: 'Monitor · daily' },
    { href: '/research/od-vs-committed', title: 'The Commitment Discount', kicker: 'Note · 2026-07-06' },
    { href: '/research/rental-rates-by-generation', title: 'Rates by Generation', kicker: 'Note · 2026-07-08' },
  ] },
  { theme: 'Demand & Utilization', items: [
    { href: '/realized/', title: 'Realized vs Rate Card', kicker: 'Monitor · daily' },
    { href: '/utilization', title: 'Utilization & Availability', kicker: 'Monitor · daily' },
    { href: '/research/training-vs-inference', title: 'Training vs Inference', kicker: 'Primer' },
  ] },
  { theme: 'Precedents & Filings', items: [
    { href: '/research/itel-1979', title: 'Itel and the IBM 4300', kicker: 'Note · 1979' },
    { href: '/research/same-facility-different-marks', title: 'Same Facility, Different Marks', kicker: 'Note · 2026-07-12' },
    { href: '/research/big-tech-hidden-debt', title: 'Big Tech’s Hidden Debt', kicker: 'Note · 2026-07-22' },
  ] },
];
---
<Base
  title="CCIR — Compute Credit Index Research · GPU Reference Rates"
  description="Independent GPU price index and reference rates: daily H100/H200/B200 rental benchmarks, reserved and committed term structure, GPU-backed credit tracked as filed, and used-GPU hardware prices."
  ogImage="/og/home.png?v=two-grades"
>
  <section class="wrap top">
    <header class="hero">
      <h1>Reference Rates for the Compute Market</h1>
      <p class="standfirst lede">
        Built to be cited: series IDs, public methodology, published daily
        across chips and deployment classes.
      </p>
    </header>

    <!-- Layer 1 — the reference ladder + the term curve -->
    <section class="ladder-block">
      <div class="ladder-row">
        <div class="ladder-col">
          <div class="block-head">
            <span class="kicker">Guaranteed</span>
            <a class="block-link" href="/rates">Full rate ladder →</a>
          </div>
          <div class="table-wrap">
            <div class="table-head">
              <span class="th-scope">On-demand, guaranteed · US &amp; EU</span>
              <span class="th-meta">USD/GPU-hr · daily · as of {meta.as_of_date}</span>
            </div>
            <table class="data ladder-table">
              <thead>
                <tr>
                  <th class="chip-col">Silicon</th>
                  {TIERS.map((t) => (
                    <th class={`tier-col tier-col-${t.toLowerCase()}`}>{TIER_LABELS_SHORT[t]}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {ladder.map(({ chip, cells }) => (
                  <tr>
                    <td class="chip-cell">{chip.replace(/-/g, ' ')}</td>
                    {TIERS.map((t) => {
                      const c = cells[t];
                      if (!c) return <td class="num empty">—</td>;
                      return (
                        <td class={`num posted tier-pos-${t.toLowerCase()}`} title={cellTitle(c)}>
                          {fmt(headlineValue(c))}
                        </td>
                      );
                    })}
                  </tr>
                ))}
              </tbody>
            </table>
            <details class="table-foot">
              <summary>Series &amp; stat</summary>
              <div class="tf-body">
                CRI-T1/T2/T3-&lbrace;CHIP&rbrace;-ALL-GTD-OD-ALL · headline = panel
                mean at n&nbsp;≥&nbsp;10, else median · hover a rate for its full
                series id, stat, IQR and panel depth · same US &amp; EU scope as /rates
              </div>
            </details>
            <a class="term-pointer" href="/term">Committed term structure →</a>
          </div>
        </div>

        <div class="term-col">
          <div class="block-head">
            <span class="kicker">Interruptible</span>
            <a class="block-link" href="/rates">Full rate ladder →</a>
          </div>
          <div class="table-wrap">
            <div class="table-head">
              <span class="th-scope">On-demand, interruptible · US &amp; EU</span>
              <span class="th-meta">USD/GPU-hr · daily · as of {meta.as_of_date}</span>
            </div>
            <table class="data ladder-table">
              <thead>
                <tr>
                  <th class="chip-col">Silicon</th>
                  {TIERS.map((t) => (
                    <th class={`tier-col tier-col-${t.toLowerCase()}`}>{TIER_LABELS_SHORT[t]}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {intLadder.map(({ chip, cells }) => (
                  <tr>
                    <td class="chip-cell">{chip.replace(/-/g, ' ')}</td>
                    {TIERS.map((t) => {
                      const c = cells[t];
                      if (!c) return <td class="num empty">—</td>;
                      return (
                        <td class={`num posted tier-pos-${t.toLowerCase()}`} title={cellTitle(c)}>
                          {fmt(headlineValue(c))}
                        </td>
                      );
                    })}
                  </tr>
                ))}
              </tbody>
            </table>
            <details class="table-foot">
              <summary>Series &amp; grade</summary>
              <div class="tf-body">
                CRI-T1/T2/T3-&lbrace;CHIP&rbrace;-ALL-INT-OD-ALL · same panel
                construction as the guaranteed ladder, second grade:
                revocable occupancy (the operator may reclaim the capacity)
                · em dash = below the publication floor · no ratio between
                the two ladders is printed — the panels differ in composition
              </div>
            </details>
          </div>
        </div>
      </div>
      <p class="grade-defs">
        The guaranteed grade prices committed capacity. The interruptible
        grade prices spare capacity. Same silicon, same panel
        construction, published as separate grades, never blended.
      </p>
    </section>

    <!-- Layer 2 — the other surfaces: financing, residual, tokens, data -->
    <section class="surface-band">
      <a class="surface" href="/credit">
        <span class="s-kicker">Financing</span>
        <span class="s-title">Credit</span>
        <span class="s-line">GPU-backed debt as filed — {creditN} instruments tracked, ${creditGpuUsdB}B secured directly by the GPUs.</span>
        <span class="s-go">Credit tracker →</span>
      </a>
      <a class="surface" href="/hardware">
        <span class="s-kicker">Residual</span>
        <span class="s-title">Hardware</span>
        <span class="s-line">Executed used-GPU prices beside current posted asks, by generation.</span>
        <span class="s-go">Hardware prices →</span>
      </a>
      <a class="surface" href="/tokens">
        <span class="s-kicker">Tokens</span>
        <span class="s-title">Token Prices</span>
        <span class="s-line">Posted per-token prices: frontier first-party and served open-weight.</span>
        <span class="s-go">Token surface →</span>
      </a>
      <a class="surface" href="/explorer">
        <span class="s-kicker">Data</span>
        <span class="s-title">Explorer</span>
        <span class="s-line">Every published series by chip, segment, tenor, and region.</span>
        <span class="s-go">Series explorer →</span>
      </a>
    </section>

    <!-- Layer 3 — research, in the hub's own taxonomy -->
    <section class="mi-block">
      <div class="block-head">
        <span class="kicker">Research</span>
        <a class="block-link" href="/research">All monitors &amp; notes →</a>
      </div>
      <div class="rg-grid">
        {researchGroups.map((g) => (
          <div class="rg-group">
            <div class="rg-theme">{g.theme}</div>
            {g.items.map((it) => (
              <a class="rg-item" href={it.href}>
                <span class="rg-kicker">{it.kicker}</span>
                <span class="rg-title">{it.title}</span>
              </a>
            ))}
          </div>
        ))}
      </div>
    </section>

    <p class="data-line">
      CCIR publishes citable reference series from observed prices and holds
      no positions in the markets it measures. Citing a series, or interested
      in a data partnership? <a href="/contact">Get in touch →</a>
    </p>
  </section>

  <style>
    .top { padding-top: 32px; }
    .hero { margin-bottom: 26px; max-width: 80ch; }
    .hero h1 {
      font-family: var(--font-display);
      font-size: var(--fs-hero);
      line-height: var(--lh-display);
      font-weight: var(--weight-display);
      margin: 6px 0 14px;
      letter-spacing: -0.01em;
      max-width: 22ch;
    }
    .lede { font-size: var(--fs-lg); }

    .block-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 10px;
    }
    .block-link { color: var(--link); }
    .grade-defs {
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      color: var(--ink-dim);
      line-height: 1.7;
      margin: 14px 0 0;
      max-width: 760px;
    }
    .term-pointer {
      display: inline-block;
      margin-top: 10px;
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      text-transform: uppercase;
      letter-spacing: .08em;
      color: var(--ink-dim);
      text-decoration: none;
    }
    .term-pointer:hover { color: var(--link); }
    .block-link {
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      text-transform: uppercase;
      letter-spacing: var(--tracking-eye);
    }

    .ladder-block { margin: 0 0 40px; }
    .ladder-row {
      display: grid;
      /* Two-grade preview 2026-08-04: the ladders are mirror images — equal
         columns (was 3fr/2fr when the right column held the term panel). */
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 36px;
      align-items: start;
    }
    /* Articulate the gutter — one hairline makes the two panels read as
       columns of the same page instead of cards adrift. */
    .term-col { border-left: 1px solid var(--rule); padding-left: 36px; }
    @media (max-width: 900px) {
      .ladder-row { grid-template-columns: 1fr; }
      .term-col { border-left: 0; padding-left: 0; }
    }

    .table-wrap { border: 1px solid var(--rule); background: var(--surface); overflow-x: auto; }
    .table-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      padding: 9px 16px;
      border-bottom: 1px solid var(--rule-2);
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      text-transform: uppercase;
      letter-spacing: var(--tracking-eye);
    }
    .th-scope { color: var(--ink); font-weight: var(--weight-strong); }
    .th-meta { color: var(--ink-dim); white-space: nowrap; }
    .table-foot {
      border-top: 1px solid var(--rule-2);
      font-family: var(--font-mono);
      font-size: calc(var(--fs-xs) - 1px);
      color: var(--ink-faint);
      letter-spacing: 0.02em;
    }
    .table-foot summary {
      padding: 8px 16px;
      cursor: pointer;
      list-style: none;
      text-transform: uppercase;
      letter-spacing: var(--tracking-eye);
      user-select: none;
    }
    .table-foot summary::-webkit-details-marker { display: none; }
    .table-foot summary::after { content: ' +'; }
    .table-foot[open] summary::after { content: ' −'; }
    .table-foot .tf-body { padding: 0 16px 8px; line-height: 1.6; }
    table.ladder-table, table.term-table { width: 100%; border-collapse: collapse; }
    table.ladder-table th.chip-col { text-align: left; width: 18%; }
    table.ladder-table th.tier-col { text-align: center; padding: 10px 16px; }
    table.ladder-table th.tier-col-t1 { color: var(--tier-t1); }
    table.ladder-table th.tier-col-t2 { color: var(--tier-t2); }
    table.ladder-table th.tier-col-t3 { color: var(--tier-t3); }
    table.ladder-table td.chip-cell,
    table.term-table td.term-cell {
      font-family: var(--font-mono);
      font-size: var(--fs-sm);
      color: var(--ink);
      font-weight: var(--weight-strong);
      letter-spacing: 0.04em;
      white-space: nowrap;
    }
    table.ladder-table td.num,
    table.term-table td.num {
      text-align: right;
      padding-right: 16px;
      font-family: var(--font-mono);
      font-size: var(--fs-md);
      font-variant-numeric: tabular-nums;
    }
    /* Ladder rates sit centered under their tier heads — uniform X.XX widths
       make decimal alignment moot, and centering keeps each column a unit. */
    table.ladder-table td.num { text-align: center; padding-right: 0; }
    table.ladder-table td.posted,
    table.term-table td.posted { font-weight: var(--weight-strong); cursor: help; }
    /* Mobile: the two 4-column ladders must FIT the viewport. The tier
       headers' uppercase tracking + desktop cell padding force a minimum
       table width around 460px, which turned into a horizontal scroll
       that read as the Marketplace column being cut off. Tighten the
       type and padding instead of scrolling. */
    @media (max-width: 600px) {
      table.ladder-table th,
      table.ladder-table td { padding-left: 4px; padding-right: 4px; }
      table.ladder-table th.tier-col {
        padding: 8px 4px;
        font-size: 10px;
        letter-spacing: 0.03em;
      }
      table.ladder-table td.num { font-size: var(--fs-sm); }
      table.ladder-table td.chip-cell { font-size: var(--fs-xs); letter-spacing: 0.02em; }
      .table-head { flex-wrap: wrap; gap: 2px 10px; }
    }
    table.term-table td.disc {
      font-size: var(--fs-xs);
      color: var(--ink-dim);
      width: 20%;
      white-space: nowrap;
    }
    table.term-table td.anchor-disc {
      color: var(--ink-faint);
      text-transform: uppercase;
      letter-spacing: var(--tracking-eye);
      font-size: calc(var(--fs-xs) - 1px);
    }
    /* Middle tier (Neocloud) is the market that matters — give it the accent. */
    table.ladder-table td.tier-pos-t2 { color: var(--accent); }
    table.ladder-table th.tier-col-t2 { color: var(--accent); }
    table.ladder-table td.tier-pos-t1, table.ladder-table td.tier-pos-t3 { color: var(--ink); }
    table.ladder-table td.empty { color: var(--ink-faint); }

    .mi-block { margin: 0 0 32px; }
    .rg-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1px;
      background: var(--rule);
      border: 1px solid var(--rule);
    }
    @media (max-width: 1020px) { .rg-grid { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 520px) { .rg-grid { grid-template-columns: 1fr; } }
    .rg-group {
      background: var(--surface);
      padding: 13px 15px 15px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .rg-theme {
      font-family: var(--font-mono);
      font-size: calc(var(--fs-xs) - 1px);
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: var(--tracking-eye);
      font-weight: var(--weight-strong);
      padding-bottom: 7px;
      border-bottom: 1px solid var(--rule-2);
    }
    .rg-item {
      display: flex;
      flex-direction: column;
      gap: 2px;
      text-decoration: none;
      color: var(--ink);
    }
    .rg-item:hover .rg-title { color: var(--link); }
    .rg-kicker {
      font-family: var(--font-mono);
      font-size: calc(var(--fs-xs) - 2px);
      color: var(--ink-faint);
      text-transform: uppercase;
      letter-spacing: var(--tracking-eye);
    }
    .rg-title {
      font-family: var(--font-display);
      font-size: var(--fs-sm);
      font-weight: var(--weight-display);
      line-height: 1.35;
    }

    /* The other three surfaces + the explorer, one hairline band. */
    .surface-band {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1px;
      background: var(--rule);
      border: 1px solid var(--rule);
      margin: 0 0 40px;
    }
    @media (max-width: 900px) { .surface-band { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 480px) { .surface-band { grid-template-columns: 1fr; } }
    .surface {
      background: var(--surface);
      padding: 15px 17px 14px;
      display: flex;
      flex-direction: column;
      gap: 5px;
      text-decoration: none;
      color: var(--ink);
      transition: background 0.16s ease, box-shadow 0.16s ease;
    }
    .surface:hover {
      background: var(--surface-2);
      text-decoration: none;
      box-shadow: inset 0 0 0 1px var(--link);
      z-index: 1;
    }
    .surface:hover .s-title { color: var(--link); }
    .s-kicker {
      font-family: var(--font-mono);
      font-size: calc(var(--fs-xs) - 1px);
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: var(--tracking-eye);
      font-weight: var(--weight-strong);
    }
    .s-title {
      font-family: var(--font-display);
      font-size: var(--fs-lg);
      font-weight: var(--weight-display);
      transition: color 0.16s ease;
    }
    .s-line {
      font-family: var(--font-body);
      font-size: var(--fs-sm);
      color: var(--ink-dim);
      line-height: 1.5;
    }
    .s-go {
      margin-top: auto;
      padding-top: 6px;
      font-family: var(--font-mono);
      font-size: calc(var(--fs-xs) - 1px);
      color: var(--link);
      text-transform: uppercase;
      letter-spacing: var(--tracking-eye);
    }

    .data-line {
      margin: 0 0 24px;
      font-family: var(--font-body);
      font-size: var(--fs-sm);
      color: var(--ink-dim);
      line-height: 1.6;
    }
    .data-line a { color: var(--link); }
  </style>
</Base>
