---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CiteBlock from '../components/CiteBlock.astro';
import TierDefinitions from '../components/TierDefinitions.astro';
import { meta, premiumChipsList, headlineValue, headlineStatOf,
         homeOdCell, homeIntCell } from '../data/snapshot';
import { TIERS, TIER_LABELS_SHORT } from '../data/types';
import type { Rate, Tier } from '../data/types';

const fmt = (n: number, dp = 2) => n.toFixed(dp);

const chips = (() => {
  const live = premiumChipsList();
  return live.length > 0 ? live : ['GB200', 'B200', 'H200', 'H100', 'A100'];
})();

// Ladder cells come from the SHARED selectors in snapshot.ts (homeOdCell /
// homeIntCell) rather than local copies. Both are: strict grade, form pooled,
// region=ALL — the CURATED US+EU core, which the core-region gate keeps APAC
// and undisclosed-location rows out of — Shadow excluded, Published preferred
// over Provisional, pooled preferred over a variant sub-series (A100-40GB),
// then panel breadth.
//
// 2026-08-09: this page kept its own near-identical copies until today. They
// differed only in the variant tiebreaker, which meant the page could quietly
// pick a different A100 series than the homepage and the share card. Verified
// identical selection on the 2026-08-08 snapshot before unifying, so this is a
// no-op today and closes the drift permanently — the same contract home.png.ts
// has always kept.
//
// Guaranteed and interruptible are separate ladders, never mixed: the
// interruptibility-pooled axis (int=ALL) drags the number below the real
// on-demand rate (US H100 Hyperscaler $9.15 guaranteed vs $5.40 pooled).
type LadderRow = { chip: string; cells: Partial<Record<Tier, Rate | undefined>> };
const ladder: LadderRow[] = chips
  .map((chip) => {
    const cells: Partial<Record<Tier, Rate | undefined>> = {};
    for (const t of TIERS) cells[t] = homeOdCell(t, chip);
    return { chip, cells };
  })
  // Drop chips with no guaranteed cell in any segment (e.g. GB200 today).
  .filter((row) => TIERS.some((t) => row.cells[t]));

// Interruptible ladder, restricted to the chips the guaranteed ladder shows so
// the two tables line up row for row. Coverage is thinner than the guaranteed
// side — T3 has no interruptible series at any scope — and the empty cells
// print an em dash exactly as the guaranteed ladder does, never a substitute
// drawn from a different region scope.
const intLadder: LadderRow[] = ladder
  .map(({ chip }) => {
    const cells: Partial<Record<Tier, Rate | undefined>> = {};
    for (const t of TIERS) cells[t] = homeIntCell(t, chip);
    return { chip, cells };
  })
  .filter((row) => TIERS.some((t) => row.cells[t]));

function chipDisplay(token: string): string {
  return token.replace(/-/g, ' ');
}

function cellTitle(c: Rate): string {
  const kind = headlineStatOf(c);
  return `${c.series_id} · ${kind === 'mean' ? 'Mean' : 'Median'} (n=${c.n_sources}) · region ${c.region} · median ${fmt(c.price_median)} · mean ${fmt(c.price_mean)} · IQR ${fmt(c.price_p25)}–${fmt(c.price_p75)}`;
}
---
<Base
  title="GPU Rental Rates — Daily H100, H200, B200 Price Benchmark · CCIR"
  description="Daily GPU rental price benchmarks per GPU-hour — H100, H200, B200, A100 — guaranteed on-demand rates across Hyperscaler, Neocloud, and Marketplace segments, from a fixed provider panel under a published methodology."
  ogImage="/og/rates.png?v=live"
>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: 'CCIR GPU Compute Reference Rates',
    description: 'Daily reference rates for GPU compute rental — chip × deployment class × interruptibility × commitment term × region — computed from publicly posted rates across a fixed provider panel under a published methodology.',
    url: 'https://ccir.io/rates',
    creator: { '@type': 'Organization', name: 'CCIR', url: 'https://ccir.io' },
    temporalCoverage: '2026-04/..',
    spatialCoverage: 'United States, European Union',
    keywords: ['GPU rental rates', 'compute pricing', 'H100', 'H200', 'B200', 'reference rates', 'GPU-backed financing', 'AI infrastructure'],
    license: 'https://ccir.io/documents/data-terms',
    isAccessibleForFree: true,
  })} />
  <section class="wrap page-top">
    <PageHeader title="Reference Rates" kicker="Benchmark · US &amp; EU" asOf={meta.as_of_date}>
      <p class="standfirst">
        Guaranteed and interruptible on-demand reference rates per chip across
        the three operator segments. Every cell is a published, citable series,
        with panel depth, stat, and history disclosed. Committed term is on
        <a href="/term">/term</a>. Regional breakouts and every other grain are
        on <a href="/explorer">/explorer</a>.
      </p>
    </PageHeader>

    <div class="table-wrap">
      <div class="table-head">
        <span class="th-scope">On-demand, guaranteed · US &amp; EU</span>
        <span class="th-meta">USD/GPU-hr · daily · as of {meta.as_of_date}</span>
      </div>
      <table class="data ladder-table">
        <thead>
          <tr>
            <th class="chip-col">Silicon</th>
            {TIERS.map((t) => (
              <th class={`tier-col tier-col-${t.toLowerCase()}`}>
                <span class={`tier-badge tier-badge-${t.toLowerCase()}`}>{TIER_LABELS_SHORT[t]}</span>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {ladder.map(({ chip, cells }) => (
            <tr>
              <td class="chip-cell"><div class="chip-name">{chipDisplay(chip)}</div></td>
              {TIERS.map((t) => {
                const c = cells[t];
                if (!c) return <td class="num empty">—</td>;
                return (
                  <td class={`num posted tier-pos-${t.toLowerCase()}`} title={cellTitle(c)}>
                    {fmt(headlineValue(c))}
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
      <details class="table-foot">
        <summary>Series &amp; stat</summary>
        <div class="tf-body">
          CRI-T1/T2/T3-&lbrace;CHIP&rbrace;-ALL-GTD-OD-ALL · headline = panel
          mean at n&nbsp;≥&nbsp;10, else median · hover a rate for its full
          series id, stat, region, IQR and panel depth
        </div>
      </details>
    </div>
    <a class="chip-pointer" href="/chip/h100">H100 instrument page · pilot →</a>

    {intLadder.length > 0 && (
      <div class="table-wrap int-wrap">
        <div class="table-head">
          <span class="th-scope">On-demand, interruptible · US &amp; EU</span>
          <span class="th-meta">USD/GPU-hr · daily · as of {meta.as_of_date}</span>
        </div>
        <table class="data ladder-table">
          <thead>
            <tr>
              <th class="chip-col">Silicon</th>
              {TIERS.map((t) => (
                <th class={`tier-col tier-col-${t.toLowerCase()}`}>
                  <span class={`tier-badge tier-badge-${t.toLowerCase()}`}>{TIER_LABELS_SHORT[t]}</span>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {intLadder.map(({ chip, cells }) => (
              <tr>
                <td class="chip-cell"><div class="chip-name">{chipDisplay(chip)}</div></td>
                {TIERS.map((t) => {
                  const c = cells[t];
                  if (!c) return <td class="num empty">—</td>;
                  return (
                    <td class={`num posted tier-pos-${t.toLowerCase()}`} title={cellTitle(c)}>
                      {fmt(headlineValue(c))}
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
        <details class="table-foot">
          <summary>Series &amp; stat</summary>
          <div class="tf-body">
            CRI-T1/T2/T3-&lbrace;CHIP&rbrace;-ALL-INT-OD-ALL · same panel, same
            stat rule and same US &amp; EU scope as the guaranteed ladder above,
            so the two read line by line · interruptible capacity is reclaimable by
            the provider, so these are not substitutes for the rates above ·
            blank cells are segments with no interruptible series, not zeroes
          </div>
        </details>
      </div>
    )}
    <section class="defs-section">
      <TierDefinitions headerless={true} />
    </section>
    <CiteBlock what="GPU Reference Rates" path="/rates" date={meta.as_of_date} />
  </section>

  <style>
    /* Page chrome (.page-top/.page-head/.table-*) is global — base.css. */
    /* The interruptible ladder is a second table on the same page, not a
       continuation of the first — space it so the two read as a pair without
       merging into one block. */
    .int-wrap { margin-top: 28px; }
    .chip-pointer {
      display: inline-block;
      margin-top: 10px;
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      text-transform: uppercase;
      letter-spacing: var(--tracking-eye);
      color: var(--link);
    }
    table.ladder-table { width: 100%; border-collapse: collapse; }
    table.ladder-table th.chip-col { text-align: left; width: 30%; }
    table.ladder-table th.tier-col { text-align: center; padding: 10px 18px; }
    table.ladder-table th.tier-col-t1 { color: var(--tier-t1); }
    table.ladder-table th.tier-col-t2 { color: var(--tier-t2); }
    table.ladder-table th.tier-col-t3 { color: var(--tier-t3); }
    table.ladder-table .chip-cell { white-space: nowrap; }
    table.ladder-table .chip-cell .chip-name {
      font-family: var(--font-mono);
      font-size: var(--fs-md);
      color: var(--ink);
      font-weight: var(--weight-strong);
      letter-spacing: 0.04em;
    }
    table.ladder-table td.num {
      text-align: center;
      font-family: var(--font-mono);
      font-size: var(--fs-lg);
      font-variant-numeric: tabular-nums;
    }
    table.ladder-table td.posted { font-weight: var(--weight-strong); cursor: help; }
    /* Middle tier (Neocloud) is the market that matters — give it the accent. */
    table.ladder-table td.tier-pos-t2 { color: var(--accent); font-weight: var(--weight-strong); }
    table.ladder-table th.tier-col-t2 { color: var(--accent); }
    table.ladder-table td.tier-pos-t1, table.ladder-table td.tier-pos-t3 { color: var(--ink); }
    table.ladder-table td.empty { color: var(--ink-faint); }

    /* Mobile: the 4-column ladder must FIT the viewport (same pattern as
       the landing-page ladders) — the segment badges plus desktop cell
       padding force a minimum width past 360px phones, which turned into
       a horizontal scroll that read as the Marketplace column being cut
       off. Tighten type and padding instead of scrolling. */
    @media (max-width: 600px) {
      table.ladder-table th,
      table.ladder-table td { padding-left: 4px; padding-right: 4px; }
      table.ladder-table th.tier-col { padding: 8px 4px; }
      table.ladder-table th.tier-col .tier-badge {
        font-size: 10px;
        letter-spacing: 0.03em;
        padding: 2px 4px;
      }
      table.ladder-table td.num { font-size: var(--fs-md); }
      table.ladder-table .chip-cell .chip-name {
        font-size: var(--fs-sm);
        letter-spacing: 0.02em;
      }
      .table-head { flex-wrap: wrap; gap: 2px 10px; }
    }

    .defs-section { margin: 32px 0 0; }
  </style>
</Base>
