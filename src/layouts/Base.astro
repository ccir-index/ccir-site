---
import '../styles/tokens.css';
import '../styles/base.css';
import Masthead from '../components/Masthead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Tape from '../components/Tape.astro';
// ⚠️ DEV-ONLY (redesign/v1): style-variant comparison pill. Delete this
// import + component + the data-variant blocks in tokens.css before merge.
import VariantSwitcher from '../components/VariantSwitcher.astro';
import { meta } from '../data/snapshot';

interface Props {
  title?: string;
  description?: string;
  showTape?: boolean;
  ogImage?: string;
  noindex?: boolean;
  /** Research-note structured data: ISO dates; renders Article JSON-LD. */
  article?: { published: string; modified?: string };
}

const {
  title = 'CCIR · Compute Credit Index Research',
  description = 'Independent analysis of the GPU compute market — aggregated from publicly-observed posted prices across dozens of providers.',
  // Ticker suppressed 2026-07-02: the v2026-07-01 panel activation (31→41
  // sources) + same-day restatements make day-over-day arrows read as market
  // moves when they're composition changes. Flip back to true once the panel
  // has a few days of stable history.
  showTape = false,
  ogImage = '/og-default.png',
  noindex = false,
  article,
} = Astro.props;

const SITE = 'https://ccir.io';
const canonicalPath = Astro.url.pathname
  .replace(/\/index\.html$/, '/')
  .replace(/\.html$/, '')
  .replace(/\/$/, '') || '/';
const canonical = new URL(canonicalPath, SITE).href;
const ogImageUrl = ogImage ? new URL(ogImage, SITE).href : undefined;

// Structured data. Organization + WebSite sitewide; Article on research
// notes that pass the `article` prop (dateModified carries restatements).
const ORG = {
  '@type': 'Organization',
  '@id': `${SITE}/#org`,
  name: 'Compute Credit Index Research',
  alternateName: 'CCIR',
  legalName: 'Compute Credit Index Research LLC',
  url: SITE,
  logo: `${SITE}/favicon-192.png`,
  description: 'Independent reference rates and research for the GPU compute market.',
  sameAs: [
    'https://www.linkedin.com/company/compute-credit-index-research/',
    'https://x.com/CCIR_IO',
  ],
};
const siteGraphLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    ORG,
    {
      '@type': 'WebSite',
      name: 'Compute Credit Index Research',
      alternateName: 'CCIR',
      url: SITE,
      publisher: { '@id': `${SITE}/#org` },
    },
  ],
});
const articleLd = article
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      datePublished: article.published,
      ...(article.modified ? { dateModified: article.modified } : {}),
      author: { '@id': `${SITE}/#org` },
      publisher: { '@id': `${SITE}/#org` },
      mainEntityOfPage: canonical,
      ...(ogImageUrl ? { image: ogImageUrl } : {}),
    })
  : null;
---
<!doctype html>
<html lang="en" data-theme="terminal">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex,follow" />}
  {!noindex && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content={article ? 'article' : 'website'} />
  {article && <meta property="article:published_time" content={article.published} />}
  {article?.modified && <meta property="article:modified_time" content={article.modified} />}
  <meta property="og:site_name" content="CCIR" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
  <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
  <script is:inline type="application/ld+json" set:html={siteGraphLd} />
  {articleLd && <script is:inline type="application/ld+json" set:html={articleLd} />}
  <slot name="head" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=IBM+Plex+Serif:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600&display=swap"
    rel="stylesheet"
  />
  <!-- DEV-ONLY (redesign/v1): variant faces for the A/B/C/D style comparison.
       Loaded unconditionally for the prototype (~5 extra families; gating
       per-variant would need JS injection and cause face-flash on switch —
       perf tuning comes after a variant is chosen). Delete with the variant
       system: this link, the data-variant blocks in tokens.css, and
       components/VariantSwitcher.astro. -->
  <link
    href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Source+Sans+3:ital,wght@0,400;0,600;1,400&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;0,6..72,700;1,6..72,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
    rel="stylesheet"
  />
  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem('ccir-theme');
        if (t === 'editorial' || t === 'terminal') {
          document.documentElement.setAttribute('data-theme', t);
        }
        // DEV-ONLY (redesign/v1): apply the persisted style variant before
        // first paint; the variant pins its own theme for chart coherence.
        var THEME_FOR = { 'modern-light': 'editorial', 'terminal-pro': 'terminal', 'print': 'editorial' };
        var v = localStorage.getItem('ccir-variant');
        if (v && THEME_FOR[v]) {
          document.documentElement.setAttribute('data-variant', v);
          document.documentElement.setAttribute('data-theme', THEME_FOR[v]);
        }
      } catch (e) {}
    })();
  </script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <Masthead />
  {showTape && <Tape />}
  <main id="main">
    <slot />
  </main>
  <SiteFooter />
  <VariantSwitcher />
  <style>
    .skip-link {
      position: absolute;
      left: -9999px;
      top: 0;
      z-index: 100;
      background: var(--surface);
      color: var(--link);
      padding: 8px 14px;
      font-family: var(--font-mono);
      font-size: var(--fs-sm);
      border: 1px solid var(--rule-2);
    }
    .skip-link:focus { left: 8px; top: 8px; }
  </style>
</body>
</html>
