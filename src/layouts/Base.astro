---
import '../styles/tokens.css';
import '../styles/base.css';
// Self-hosted faces (@fontsource), subset to the weights actually used:
//   Space Grotesk 600           — display (headings) only
//   JetBrains Mono 400/400i/500/600 — data, labels, chrome
//   IBM Plex Sans 400/400i/600  — running text
// Heavier weights (700) in chart SVGs synthesize from 600, as they always
// have. Astro bundles the woff2 files; no external font host remains.
import '@fontsource/space-grotesk/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/400-italic.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/600.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/400-italic.css';
import '@fontsource/ibm-plex-sans/600.css';
import Masthead from '../components/Masthead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Tape from '../components/Tape.astro';
import { meta } from '../data/snapshot';

interface Props {
  title?: string;
  description?: string;
  showTape?: boolean;
  ogImage?: string;
  noindex?: boolean;
  /** Research-note structured data: ISO dates; renders Article JSON-LD. */
  article?: { published: string; modified?: string };
  /**
   * Typographic register (owner, 2026-08-13). One identity, two registers:
   * "terminal" (default) for data surfaces; "editorial" for sustained
   * reading — research notes and /documents pages get it automatically by
   * route, overridable here. Drives [data-register] rules in base.css.
   */
  register?: 'terminal' | 'editorial';
}

const {
  title = 'CCIR · Compute Credit Index Research',
  description = 'Independent analysis of the GPU compute market — aggregated from publicly-observed posted prices across dozens of providers.',
  // Ticker suppressed 2026-07-02: the v2026-07-01 panel activation (31→41
  // sources) + same-day restatements make day-over-day arrows read as market
  // moves when they're composition changes. Flip back to true once the panel
  // has a few days of stable history.
  showTape = false,
  ogImage = '/og-default.png',
  noindex = false,
  article,
  register,
} = Astro.props;

// Register by route: every /research/<slug> note (the hub at /research stays
// terminal) and every /documents/<slug> page reads in the editorial register.
const isEditorialRoute =
  /^\/research\/.+/.test(Astro.url.pathname) ||
  /^\/documents\/.+/.test(Astro.url.pathname);
const pageRegister = register ?? (isEditorialRoute ? 'editorial' : 'terminal');

const SITE = 'https://ccir.io';
const canonicalPath = Astro.url.pathname
  .replace(/\/index\.html$/, '/')
  .replace(/\.html$/, '')
  .replace(/\/$/, '') || '/';
const canonical = new URL(canonicalPath, SITE).href;
const ogImageUrl = ogImage ? new URL(ogImage, SITE).href : undefined;

// Structured data. Organization + WebSite sitewide; Article on research
// notes that pass the `article` prop (dateModified carries restatements).
const ORG = {
  '@type': 'Organization',
  '@id': `${SITE}/#org`,
  name: 'Compute Credit Index Research',
  alternateName: 'CCIR',
  legalName: 'Compute Credit Index Research LLC',
  url: SITE,
  logo: `${SITE}/favicon-192.png`,
  description: 'Independent reference rates and research for the GPU compute market.',
  sameAs: [
    'https://www.linkedin.com/company/compute-credit-index-research/',
    'https://x.com/CCIR_IO',
  ],
};
const siteGraphLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    ORG,
    {
      '@type': 'WebSite',
      name: 'Compute Credit Index Research',
      alternateName: 'CCIR',
      url: SITE,
      publisher: { '@id': `${SITE}/#org` },
    },
  ],
});
const articleLd = article
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      datePublished: article.published,
      ...(article.modified ? { dateModified: article.modified } : {}),
      author: { '@id': `${SITE}/#org` },
      publisher: { '@id': `${SITE}/#org` },
      mainEntityOfPage: canonical,
      ...(ogImageUrl ? { image: ogImageUrl } : {}),
    })
  : null;
---
<!doctype html>
<html lang="en" data-theme="terminal">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex,follow" />}
  {!noindex && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content={article ? 'article' : 'website'} />
  {article && <meta property="article:published_time" content={article.published} />}
  {article?.modified && <meta property="article:modified_time" content={article.modified} />}
  <meta property="og:site_name" content="CCIR" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
  <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
  <script is:inline type="application/ld+json" set:html={siteGraphLd} />
  {articleLd && <script is:inline type="application/ld+json" set:html={articleLd} />}
  <slot name="head" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <script is:inline>
    (function () {
      try {
        // Key versioned at the 2026-08 redesign: pre-redesign 'ccir-theme'
        // preferences (old editorial navy) are dropped so every returning
        // visitor gets one fresh terminal landing; toggles persist via v2.
        var t = localStorage.getItem('ccir-theme-v2');
        if (t === 'editorial' || t === 'terminal') {
          document.documentElement.setAttribute('data-theme', t);
        }
        localStorage.removeItem('ccir-theme');
        // The design is decided (F·DUO baked in); clear stale keys from the
        // retired dev-only variant rounds.
        localStorage.removeItem('ccir-variant');
      } catch (e) {}
    })();
  </script>
</head>
<body data-register={pageRegister}>
  <a class="skip-link" href="#main">Skip to content</a>
  <Masthead />
  {showTape && <Tape />}
  <main id="main">
    <slot />
  </main>
  <SiteFooter />
  <style>
    .skip-link {
      position: absolute;
      left: -9999px;
      top: 0;
      z-index: 100;
      background: var(--surface);
      color: var(--link);
      padding: 8px 14px;
      font-family: var(--font-mono);
      font-size: var(--fs-sm);
      border: 1px solid var(--rule-2);
    }
    .skip-link:focus { left: 8px; top: 8px; }
  </style>
</body>
</html>
